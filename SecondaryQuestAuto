    local function phantomPassage()
        local char,root,hum,ok=alive()
        if not ok then return true end
        -- O TempleRun original só envia End após ultrapassar 14319.071 + 8 studs
        local finish=Vector3.new(-8313.988,-1200.667,14332.5)
        local start=Vector3.new(-8313.673,-1205.046,12929.421)
        local remaining=(root.Position-finish).Magnitude
        R.phantomRunDistance=math.floor(remaining)
        R.phantomStage="Atravessando as ruínas"
        R.phantomAction="Run"
