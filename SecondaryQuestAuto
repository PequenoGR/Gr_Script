    local function playTomatoes()
        if not R.enabled or R.name~="The Great Show"
            or R.objective~="Dodge_Tomatoes_SQ" then return end
        local gui=player.PlayerGui:FindFirstChild("DodgeMinigameGui")
        local guiRunning=gui and gui:IsA("ScreenGui") and gui.Enabled
            and not gui:FindFirstChild("Result",true)
        local active=tomatoManager and tomatoManager.Active
        local actualRunning=(active and active.Name=="Dodge") or guiRunning
        R.clownGuiFound=guiRunning and true or false
        R.clownMiniRunning=actualRunning and true or false
        if not actualRunning then
            R.tomatoMiniActive=false
            return
        end
        R.tomatoMiniActive=true
        R.clownStartUntil=math.max(R.clownStartUntil or 0,os.clock()+1.2)
        local session=R.tomatoSession
        if not session then
            session={info={},started=os.clock(),next=1,seen={},
                lastVisual=nil,lastVisualPress=-100,visualArmed=true}
            R.tomatoSession=session
        end
        local hint=guiRunning and gui:FindFirstChild("KeyHint",true)
        local letter=hint and hint:FindFirstChild("Letter",true)
        local fill=hint and hint:FindFirstChild("Fill",true)
        if letter and fill then
            local text=tostring(letter.Text):upper():gsub("%s+","")
            local side=({A="Left",D="Right",LEFT="Left",RIGHT="Right"})[text]
            local progress=math.clamp(fill.Size.X.Scale,0,1)
            R.tomatoProgress=math.floor(progress*100)
            R.tomatoExpected=text
            local now=os.clock()
            local hasMobileTouch=gui:FindFirstChild("LeftTouch",true)~=nil
            local travel=tonumber(session.info and session.info.Travel)
            local threshold
            if hasMobileTouch then
                threshold=travel and math.clamp(1-.50/math.max(.12,travel),.20,.82) or .68
            else
                threshold=travel and math.clamp(1-.09/math.max(.12,travel),.83,.97) or .91
            end
            R.clownInputWindow=math.floor(threshold*100).."% ("..(hasMobileTouch and "toque" or "teclado")..")"
            if progress<=.24 or (session.previousProgress and
                progress<session.previousProgress-.32) or
                (session.lastVisual and text~=session.lastVisual) then
                session.visualArmed=true
            end
            session.previousProgress=progress
            if side and session.visualArmed and
                progress>=threshold and progress<=.985 and
                now-(session.lastVisualPress or -100)>.12 then
                if pressTomato(side) then
                    session.lastVisual=text
                    session.lastVisualPress=now
                    session.visualArmed=false
                    R.tomatoNote+=1
                    R.tomatoPressAt=tostring(math.floor(progress*100)).."%"
                    R.tomatoStatus="Bobo: "..text.." em "..R.tomatoPressAt
                    R.status="Bobo: acertando tomates usando o indicador"
                end
            end
            return
        end
        local info=session.info or {}
        local schedule=info.Schedule
        if type(schedule)~="table" or #schedule==0 then
            R.tomatoStatus="Bobo: minigame aberto mas ainda sem tecla / sequência"
            return
        end
        if not session.synced then
            session.started=os.clock()
            session.next=1
            session.synced=true
        end
        local note=schedule[session.next]
        if type(note)~="table" then return end
        local arrival=(tonumber(note.SpawnTime) or 0)+(tonumber(info.Travel) or .6)
        local now=os.clock()-session.started
        local touch=game:GetService("UserInputService").TouchEnabled
        local early=touch and .35 or .05
        if now>=arrival-early and now<=arrival+(touch and .2 or .13) then
            if pressTomato(note.Side or note.Key) then
                R.tomatoExpected=tostring(note.Side or note.Key)
                R.tomatoNote=session.next
                R.tomatoPressAt="tempo "..math.floor(now*100)/100
                R.status="Bobo: desviando tomate "..session.next.."/"..#schedule
                session.next+=1
            end
        elseif now>arrival+.28 then
            session.next+=1
        end
    end
