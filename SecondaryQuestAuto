    local function circusDoor(goingInside)
        local location=tostring(C.localAtual() or "")
        if (goingInside and location=="Circus") or
            (not goingInside and location~="Circus") then
            R.clownDoorStatus=goingInside and "Dentro do circo" or "Fora do circo"
            return false
        end
        local ignore=workspace:FindFirstChild("IgnoreList")
        local int=ignore and ignore:FindFirstChild("Int")
        local private=int and int:FindFirstChild("PrivateAreas")
        local island=private and private:FindFirstChild("Circus Town")
        local circus=island and island:FindFirstChild("Circus")
        local folder=circus and circus:FindFirstChild(goingInside and "Enter" or "Leave")
        local entry=folder and folder:FindFirstChild("Entrance")
        local point=entry and position(entry)
        if not point then
            local p=folder and folder:GetAttribute("Entrance")
            if typeof(p)=="Vector3" then point=p end
        end
        if not point then
            R.clownDoorStatus="Porta "..(goingInside and "Enter" or "Leave").." não carregada"
            R.status=R.clownDoorStatus
            return true
        end
        R.clownDoorStatus=goingInside and "Entrando no circo" or "Saindo do circo"
        if not moveTo(point,3.7,R.clownDoorStatus) then return true end
        once("SQCircusDoor:"..tostring(goingInside),1.25,function()
            local _,root,hum,valid=alive()
            if not valid then return end
            R.clownDoorAttempts+=1
            if entry and entry:IsA("BasePart") and type(firetouchinterest)=="function" then
                pcall(function()
                    firetouchinterest(root,entry,0)
                    firetouchinterest(root,entry,1)
                end)
            end
            local prompt=folder and folder:FindFirstChildWhichIsA("ProximityPrompt",true)
            if prompt then
                if type(fireproximityprompt)=="function" then
                    pcall(fireproximityprompt,prompt)
                else
                    pcall(function()
                        prompt:InputHoldBegin()
                        task.delay(math.max(prompt.HoldDuration,.12),
                            function() if prompt.Parent then prompt:InputHoldEnd() end end)
                    end)
                end
            end
            if C.privateClient and C.privateClient.Current then
                server("PrivateAreas","EnterArea",C.privateClient.Current)
            end
            pcall(function() hum:MoveTo(point) end)
            R.status=R.clownDoorStatus.." (tentativa "..R.clownDoorAttempts..")"
        end)
        return true
    end
