            local _,freshRoot=alive()
            local checkRoot=freshRoot or root
            local recalc=(checkRoot.Position-target).Magnitude
            if action=="Enter" or action=="Leave" then
                ready=part and phantomOverPart(checkRoot,part) or recalc<=3.5
            else
                ready=recalc<=6.5
            end
        end
        if not ready then
            R.phantomStatus="Ajustando posição do "..tostring(action)
            R.status=R.phantomStatus
            return true
        end
        once("SQPhantom:"..id,action=="Pull" and 2.5 or 2.0,function()
            local currentData=data()
            local currentQuest=active(currentData)
            local currentObj=currentQuest and nextObjective(currentQuest,currentData)
            if not currentObj or currentObj.ObjectiveID~=id then return end
            local payload={GameAction=action}
            if index then payload.Index=index end
            R.phantomAttempts+=1
            if server("MinigamesService","TempleRun",payload) then
                R.phantomStatus=action.." enviado: "..tostring(index or "-")..
                    " | tentativa "..R.phantomAttempts
                R.status=R.phantomStatus
            end
        end)
        return true
    end
    local stoneMiniLastTap=setmetatable({}, {__mode="k"})
    local miniSessionModule
    pcall(function()
        local file=modulePath(RS,{"Modules","Addons","MinigamesSystem"})
        if file then miniSessionModule=require(file) end
    end)
    local miniInput
    pcall(function() miniInput=game:GetService("VirtualInputManager") end)
    local function getActiveMini()
        local client=miniSessionModule and miniSessionModule.IsClient
        return client and client.Active or nil
    end
    local function pressMiniButton(button)
        if not button or not button:IsA("GuiButton") or not button.Parent then return false,"-" end
        if type(getconnections)=="function" then
            local ok,conns=pcall(getconnections,button.MouseButton1Down)
            if ok and type(conns)=="table" then
                for _,conn in ipairs(conns) do
                    local okCall=pcall(function() conn:Fire() end)
                    if not okCall then
                        local fn
                        pcall(function() fn=conn.Function end)
                        if type(fn)=="function" then okCall=pcall(fn) end
                    end
                    if okCall then return true,"connections" end
                end
            end
        end
        if type(firesignal)=="function" then
            if pcall(firesignal,button.MouseButton1Down) then return true,"firesignal" end
        end
        if miniInput then
            local pos,size=button.AbsolutePosition,button.AbsoluteSize
            if size.X>0 and size.Y>0 then
                local x,y=math.floor(pos.X+size.X*.5),math.floor(pos.Y+size.Y*.5)
                local ok=pcall(function()
                    miniInput:SendMouseButtonEvent(x,y,0,true,game,0)
                    miniInput:SendMouseButtonEvent(x,y,0,false,game,0)
                end)
                if ok then return true,"virtualTouch" end
            end
        end
        return false,"touch unavailable"
    end
    local function handleStoneMini()
        if not R.enabled or C.State.AutoHaki then return end
        local mini=getActiveMini()
        R.minigameName=mini and tostring(mini.Name) or "-"
        if not mini or mini.Name~="StoneBreak" then return end
        local gui=player.PlayerGui:FindFirstChild("StoneBreakGui")
        if not gui or not gui.Enabled then
            R.stoneStatus="StoneBreak ativo, esperando interface"
            return
        end
        local targetLayer=gui:FindFirstChild("Targets",true)
        if not targetLayer then return end
        R.minigameFound=0
        for _,frame in ipairs(targetLayer:GetChildren()) do
            if frame:IsA("GuiObject") and frame.Name:match("^Target%d+")
                and frame.Visible then
                local hit=frame:FindFirstChild("Hit")
                if hit and hit:IsA("GuiButton") and hit.Visible then
                    R.minigameFound+=1
                    if os.clock()-(stoneMiniLastTap[hit] or -100)>.28 then
                        stoneMiniLastTap[hit]=os.clock()
                        local success,method=pressMiniButton(hit)
                        if success then
                            R.minigameClicks+=1
                            R.minigameLastClick=frame.Name.." / "..method
                            R.stoneStatus="Acertando alvos do StoneBreak: "..R.minigameClicks
                            R.status=R.stoneStatus
                        end
                    end
                end
            end
        end
    end
    task.spawn(function()
        while C.running() do
            if R.enabled and not C.State.AutoHaki then
                local ok,err=pcall(handleStoneMini)
                if not ok then
                    R.failures+=1
                    R.stoneStatus="Erro no StoneBreak: "..tostring(err)
                end
            end
            task.wait(R.enabled and .045 or 1.1)
        end
    end)
    local function doZone(quest,obj,pos)
        local id=tostring(obj.ObjectiveID or "")
        if not zoneModules[id] then
            if pos then moveTo(pos,5,"Indo ao objetivo "..id) end
            R.status="Ação especial pendente: "..id
            return
        end
        if not moveTo(pos,3.3,"Interagindo com "..id) then return end
        R.desertStatus=(quest.island=="Golden Dunes" and id or "-")
        if passiveZone[id] then
            R.zoneStatus="Zona passiva "..id
            R.status="Zona alcançada; aguardando atualização: "..id
            return
        end
        if id:match("^Break_TrainingStone_FS_%d+$") then
            local mini=getActiveMini()
            if mini and mini.Name=="StoneBreak" then
                R.stoneStatus="Minigame da pedra em execução"
                R.status=R.stoneStatus
                return
            end
            once("SQTrainingStone:"..id,2.6,function()
                R.stoneRequests+=1
                R.zoneStatus="Punch "..id
                R.stoneStatus="Pedindo minigame "..id
                server("QuestZones",id,"Punch")
                R.status=R.stoneStatus
            end)
            return
        end
        if zoneCustom[id] then
            once("SQZoneCustom:"..id,1.25,function()
                R.interactionAttempts+=1
                local ok=interactMarker(pos,id)
                R.zoneStatus=(ok and "Interação local" or "Minigame próprio").." "..id
                R.status=(ok and "Interagindo em " or "Aguardando ação especial em ")..id
            end)
            return
        end
        if zoneUseOnly[id] then
            once("SQZoneOnlyUse:"..id,2.6,function()
                R.zoneAttempts+=1
                R.zoneStatus="Use "..id
                server("QuestZones",id,"Use")
                R.status="Acionando passagem "..id
            end)
            return
        end
        once("SQZone:"..id,id=="Build_Snowman_SQ" and 3.8 or 3.15,function()
            local d=data()
            local q=active(d)
            local current=q and nextObjective(q,d)
            if not current or current.ObjectiveID~=id then return end
            R.zoneAttempts+=1
            R.zoneStatus="Start "..id
            if server("QuestZones",id,"Start") then
                local zoneDelay=id=="Build_Snowman_SQ" and 2.72 or
                    (id=="Fill_WaterBucket_SQ" and 1.30 or 1.50)
                task.delay(zoneDelay,function()
                    if not R.enabled or not C.running() then return end
                    local currentData=data()
                    local activeQuest=active(currentData)
                    local pending=activeQuest and nextObjective(activeQuest,currentData)
                    local _,root,hum,aliveNow=alive()
                    if pending and pending.ObjectiveID==id and aliveNow and
                        typeof(pos)=="Vector3" and (root.Position-pos).Magnitude<=8 then
                        R.zoneStatus="Use "..id
                        server("QuestZones",id,"Use")
                    end
                end)
                R.status="Executando objetivo "..id
            end
        end)
    end
    local function startQuest(quest)
        if quest.category=="Wanted Posters" then
            local _,root,hum,ok=alive()
            if not ok then return end
            local ignore=workspace:FindFirstChild("IgnoreList")
            local folder=ignore and ignore:FindFirstChild("Int")
            local marker=folder and folder:FindFirstChild("WantedBoard",true)
            if not marker then marker=workspace:FindFirstChild("WantedBoard",true) end
            local point=position(marker)
            if not moveTo(point,12,"Indo ao quadro de procurados") then return end
            once("SQStart:"..quest.name,8,function()
                C.enviarQuest("AcceptWanted",quest.name)
                R.status="Solicitando recompensa: "..quest.name
            end)
            return
        end
        local npc=NPC[quest.name]
        if not npc then
            R.status="Missão sem início automático identificado no ZIP: "..quest.name
            R.skipped[quest.name]=os.clock()+60
            return
        end
        local _,root,hum,ok=alive()
        if not ok then return end
        local converse,actor,action=table.unpack(npc)
        if quest.name=="The Great Show" and circusDoor(true) then
            return
        end
        if converse=="" then
            R.status="Missão sem diálogo: "..quest.name
            R.skipped[quest.name]=os.clock()+30
            return
        end
        local pos,model=converseInfo(converse,root)
        if not pos then pos,model=npcPosition(actor,root) end
        R.lastNPC=actor
        if not moveTo(pos,6.0,"Indo ao NPC "..actor,true) then
            if not pos then R.skipped[quest.name]=os.clock()+25 end
            return
        end
        local tracker=R.startTracking[quest.name]
        if not tracker then
            tracker={count=0,since=os.clock()}
            R.startTracking[quest.name]=tracker
        end
        if tracker.count>=7 and os.clock()-tracker.since>=6 then
            R.skipped[quest.name]=os.clock()+120
            R.startRejected=quest.name.." | sem confirmação após "..tracker.count.." pedidos"
            R.startRetryCount+=1
            R.status="Pulando temporariamente "..quest.name..
                ": o servidor não confirmou a aceitação"
            stopRoute()
            R.startTracking[quest.name]=nil
            return
        end
        once("SQStart:"..quest.name,1.25,function()
            R.interactionAttempts+=1
            tracker.count+=1
            R.startAttemptsCurrent=tracker.count
            if server("Elysium_Converse",converse,action) then
                R.npcRequests+=1
                R.npcStatus=converse.." / "..action
                R.status="Solicitado "..quest.name.." com "..actor..
                    " ("..tracker.count.."/7); aguardando aceitação"
            end
        end)
    end
    local function restoreFishing()
        if R.fishHover then pcall(function() R.fishHover:Destroy() end) end
        R.fishHover=nil
        R.fishHoverPoint=nil
        if R.busyFishing then
            R.busyFishing=false
            if C.State.AutoFishing~=R.previousFishing then
                C.mudarAutoFishing(R.previousFishing)
            end
            if C.State.AutoCastFishing~=R.previousCast then
                C.mudarAutoCastFishing(R.previousCast)
            end
        end
    end
    local function holdFishingSpot(pos)
        local _,root,hum,ok=alive()
        if not ok or typeof(pos)~="Vector3" then return false end
        local goal=R.fishHoverPoint
        if typeof(goal)~="Vector3" then
            local args=RaycastParams.new()
            args.FilterType=Enum.RaycastFilterType.Include
            args.FilterDescendantsInstances={workspace.Terrain}
            args.IgnoreWater=false
            local ray=workspace:Raycast(pos+Vector3.new(0,240,0),
                Vector3.new(0,-600,0),args)
            local level=ray and ray.Position.Y or pos.Y
            goal=Vector3.new(root.Position.X,math.max(level+5,root.Position.Y+2),
                root.Position.Z)
            R.fishHoverPoint=goal
        end
        local hover=R.fishHover
        if not hover or hover.Parent~=root then
            if hover then pcall(function() hover:Destroy() end) end
            hover=Instance.new("BodyPosition")
            hover.Name="GRSecondaryFishingHover"
            hover.P=55000
            hover.D=6000
            hover.MaxForce=Vector3.new(1e8,1e8,1e8)
            hover.Position=goal
            hover.Parent=root
            R.fishHover=hover
        end
        hover.Position=goal
        return true
    end
    local objectiveHandlers={}
    objectiveHandlers.TempleRun=function(quest,obj,id,pos,marker)
        restoreFishing()
        if not phantomObjective(quest,obj) then
            R.actionBlocked="TempleRun: objetivo não reconhecido "..id
        end
    end
    objectiveHandlers.Combat=function(quest,obj,id,pos,marker)
        restoreFishing()
        attack(quest,obj,pos)
    end
    objectiveHandlers.Dialogue=function(quest,obj,id,pos,marker)
        restoreFishing()
        doTalk(obj,pos)
    end
    objectiveHandlers.Tomatoes=function(quest,obj,id,pos,marker)
        restoreFishing()
        local mini=tomatoManager and tomatoManager.Active
        if (mini and mini.Name=="Dodge") or R.clownMiniRunning then
            R.status="Bobo: desafio dos tomates em execução"
        else
            startTomatoShow(pos)
        end
    end
    objectiveHandlers.Zone=function(quest,obj,id,pos,marker)
        restoreFishing()
        doZone(quest,obj,pos)
    end
    objectiveHandlers.Fishing=function(quest,obj,id,pos,marker)
        if not pos then R.status="Ponto de pesca não carregado";return end
        if not C.encontrarVaraPesca() then
            R.status="Fishing Rod necessária para "..quest.name
            return
        end
        if moveTo(pos,13,"Indo pescar para "..quest.name) then
            stopRoute()
            if not R.busyFishing then
                R.previousFishing=C.State.AutoFishing
                R.previousCast=C.State.AutoCastFishing
                R.busyFishing=true
            end
            if holdFishingSpot(pos) then
                if not C.State.AutoFishing then C.mudarAutoFishing(true) end
                if not C.State.AutoCastFishing then C.mudarAutoCastFishing(true) end
                R.status="Pescando para "..quest.name.." | "..R.progress
            else
                R.status="Aguardando posição segura para pesca"
            end
        end
    end
    objectiveHandlers.WorldInteraction=function(quest,obj,id,pos,marker)
        restoreFishing()
        if not pos then
            R.actionBlocked="Sem coordenadas carregadas para "..id
            R.status=R.actionBlocked
            stopRoute()
            return
        end
        if moveTo(pos,3.2,"Indo completar "..id) then
            once("SQSpecial:"..id,.95,function()
                R.interactionAttempts+=1
                local touched=interactMarker(pos,id,marker)
                R.desertStatus=quest.island=="Golden Dunes" and id or "-"
                R.status=(touched and "Interação local em " or "Aguardando gatilho em ")..id
            end)
        end
    end
    local function objectiveKind(quest,id)
        if quest.name=="The Phantom Tablet" then return "TempleRun" end
        if id=="Dodge_Tomatoes_SQ" then return "Tomatoes" end
        if id=="Catch_Fish" then return "Fishing" end
        if id:sub(1,7)=="Defeat_" then return "Combat" end
        if id:sub(1,5)=="Talk_" then return "Dialogue" end
        if zoneModules[id] then return "Zone" end
        return "WorldInteraction"
    end
    local function dispatchObjective(quest,obj,id)
        local handler=objectiveKind(quest,id)
        R.actionHandler=handler
        R.actionBlocked="-"
        local stalled=math.floor(os.clock()-(R.lastProgressTime or os.clock()))
        if stalled>30 then
            R.actionBlocked="Sem progresso por "..stalled.." s: "..id
        end
        if handler=="TempleRun" then
            objectiveHandlers.TempleRun(quest,obj,id,nil,nil)
            return
        end
        local pos,marker=objectivePoint(quest,obj)
        if marker and handler~="Combat" and
            interactDoor(pos,marker) then
            R.actionHandler="WorldDoor"
            return
        end
        local runner=objectiveHandlers[handler]
        if runner then runner(quest,obj,id,pos,marker)
        else
            R.actionBlocked="Sem automação identificada para "..handler
            R.status=R.actionBlocked
        end
    end
    local function step()
        if not R.enabled or not C.running() then return end
        if C.State.AutoBoss or C.State.AutoRaid or C.State.AutoSeaBeast
            or C.State.AutoFarmQuest or C.State.AutoFarmFruit
            or C.State.AutoHaki or C.FeatureState.islandTraveling then
            if C.FeatureState.islandTraveling then
                R.status="Viajando entre ilhas"
            else
                R.status="Auto Quest pausado por outra atividade"
                stopRoute()
            end
            return
        end
        local d=data()
        local _,root,hum,ok=alive()
        if not d or not ok then R.status="Aguardando dados/personagem";return end
        local quest=active(d)
        if not quest then
            if R.name and not R.sessionDone[R.name] and completed(R.name) then
                R.sessionDone[R.name]=true
                R.completed+=1
            end
            local sameLocation=tostring(C.localAtual() or "")
            local best,score=nil,math.huge
            R.actionable=0
            R.actionHandler="QuestSelection"
            R.objectiveStage=0
            R.objectiveIndex=0
            R.progress="-"
            R.npcReady=false
            R.prerequisiteInfo="-"
            for _,entry in ipairs(secondary) do
                if entry.name~="The Sky Hermit" and entry.name~="Vox Sense Training" and entry.name~="Vox Armor Training"
                    and entry.name~="Vox Sense Mastery" and entry.name~="Vox Armor Mastery"
                    and entry.category~="Treasure Hunt" and entry.category~="Beggar Rescue"
                    and entry.category~="Wanted Posters"
                    and NPC[entry.name]
                    and canStartQuest(entry,d)
                    and os.clock()>=(R.skipped[entry.name] or 0) then
                    R.actionable+=1
                    local home=entry.island=="Sky Hermit" and "Solmar Island" or entry.island
                    local extra=norm(home)==norm(sameLocation) and 0 or 500
                    local value=extra+(tonumber(entry.info.MinLevel) or 0)*.15
                    if value<score then best,score=entry,value end
                end
            end
            if not best then
                R.status=R.prerequisiteInfo~="-" and
                    ("Quests bloqueadas por requisito: "..R.prerequisiteInfo) or
                    "Sem quests secundárias iniciáveis disponíveis (nível / NPC / mapa)"
                R.name=nil
                stopRoute()
                return
            end
            R.name=best.name
            R.objective="Iniciar"
            R.objectiveStage=0
            R.objectiveIndex=0
            R.progress="Não aceita"
            restoreFishing()
            if travelTo(best) then return end
            startQuest(best)
            return
        end
        if R.startTracking[quest.name] then
            R.startTracking[quest.name]=nil
            R.startConfirmed+=1
            R.startAttemptsCurrent=0
            R.startRejected="-"
        end
        if R.name~=quest.name then
            R.name=quest.name
            R.tomatoSession=nil
            R.tomatoMiniActive=false
            R.clownMiniRunning=false
            R.clownStartUntil=0
            R.lastEnemy=nil
            R.lastEnemyName=nil
            R.objective=nil
            R.lastProgressKey=nil
        end
        R.currentIsland=tostring(C.localAtual() or "")
        local obj,stage,index,count=nextObjective(quest,d)
        if not obj then
            restoreFishing()
            R.status="Aguardando progresso válido ou conclusão: "..quest.name
            stopRoute()
            return
        end
        local id=tostring(obj.ObjectiveID or "")
        R.objective=id
        R.objectiveStage=stage
        R.objectiveIndex=index
        R.progress=tostring(count).."/"..tostring(obj.Goal or "?")
        local key=quest.name..":"..stage..":"..index..":"..tostring(count)
        if key~=R.lastProgressKey then
            R.lastProgressKey=key
            R.lastProgressTime=os.clock()
        end
        local zone=zoneModules[id]
        local zoneIsland=zone and zone.Parent and zone.Parent.Parent
            and zone.Parent.Parent.Name or nil
        local targetIsland=TALK_ISLAND[id] or zoneIsland or quest.island
        if quest.name=="The Sky Hermit" and
            (id=="Activate_HeavenstepCheckpoints" or id=="Talk_SkyHermitSummit") then
            R.status="Heavenstep: seguindo objetivo na montanha"
        elseif targetIsland~=quest.island then
            if travelTo({island=targetIsland}) then return end
        elseif travelTo(quest) then return end
        dispatchObjective(quest,obj,id)
    end
    function R.setAuto(v)
        R.enabled=v==true
        C.State.AutoSecondary=R.enabled
        if R.enabled then
            R.sessionDone={}
            R.startTracking={}
            R.startAttemptsCurrent=0
            R.prerequisiteInfo="-"
            R.lastProgressKey=nil
            R.lastProgressTime=os.clock()
            R.clownStartUntil=0
            R.clownMiniRunning=false
            R.tomatoSession=nil
            if C.State.AutoFarmQuest then C.definirFarm(false) end
            if C.State.AutoFarmFruit then C.definirFarmFruta(false) end
            if C.State.AutoHaki then C.VoxHaki.setFullAuto(false) end
            if C.State.AutoRaid then C.Raid.setAuto(false) end
            if C.State.AutoBoss then C.BossFarm.setAuto(false) end
            if C.State.AutoSeaBeast then C.Sea.setAuto(false) end
            R.status="Procurando quests secundárias ("..R.total.." no catálogo)"
        else
            restoreFishing()
            stopRoute()
            R.status="Desligado"
        end
    end
    function R.stop()
        R.setAuto(false)
    end
    task.spawn(function()
        while C.running() do
            if R.enabled then
                local ok,err=pcall(step)
                if not ok then
                    R.failures+=1
                    R.status="Erro quest secundária: "..tostring(err)
                    if R.failures%7==1 then warn("[GR Secondary Quest]",err) end
                end
            end
            task.wait(R.enabled and .23 or 1.4)
        end
        R.stop()
    end)
    return R
end