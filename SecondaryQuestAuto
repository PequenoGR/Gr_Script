    local function checkPrerequisite(name)
        local gate=prerequisiteQuests[name]
        if not gate then return true end
        local utils=C.mainModulo and C.mainModulo.QuestsUtils
        if not utils or type(utils.QuestIsCompleted)~="function" then
            R.prerequisiteBlocked[name]=gate.name.." (dados indisponíveis)"
            return false
        end
        local ok,value=pcall(utils.QuestIsCompleted,player,gate.name)
        local allowed=ok and (
            (gate.kind=="positive" and
                (type(value)=="number" and value>0 or value==true)) or
            (gate.kind=="exists" and value~=nil and value~=false)
        )
        if not allowed then
            R.prerequisiteBlocked[name]=gate.name
            return false
        end
        R.prerequisiteBlocked[name]=nil
        return true
    end
    local function canStartQuest(quest,d)
        local info=quest.info
        if (tonumber(info.MinLevel) or 0)>C.lerNivel(d) then return false end
        if completed(quest.name) or R.sessionDone[quest.name] then return false end
        if not checkPrerequisite(quest.name) then
            if R.prerequisiteInfo=="-" then
                R.prerequisiteInfo=quest.name.." precisa de "..
                    tostring(R.prerequisiteBlocked[quest.name])
            end
            return false
        end
        if type(info.CanTake)=="function" then
            local ok,result=pcall(info.CanTake,player)
            if ok and result==false then return false end
        end
        return true
    end
    completed=function(name)
        if R.sessionDone[name] then return true end
        local fn=C.mainModulo and C.mainModulo.QuestsUtils
        if not fn or type(fn.QuestIsCompleted)~="function" then return false end
        local ok,val=pcall(fn.QuestIsCompleted,player,name)
        return ok and val~=nil and val~=false and val~=0
    end
    local function active(d)
        local results={}
        local quests=d and d.Quests and d.Quests.Actives
        if type(quests)=="table" then
            for name in pairs(quests) do
                if secondaryByName[name] and
                    not name:match("^Vox ") and name~="The Sky Hermit" then results[#results+1]=secondaryByName[name] end
            end
        end
        table.sort(results,function(a,b)
            if a.name==R.name then return true end
            if b.name==R.name then return false end
            return a.name<b.name
        end)
        return results[1]
    end
    local function position(v)
        return C.posicaoDe(v)
