        local okParts,nearby=pcall(workspace.GetPartBoundsInRadius,workspace,pos,5)
        if okParts and type(nearby)=="table" then
            for _,p in ipairs(nearby) do table.insert(points,p) end
        end
        local seen={}
        for _,node in ipairs(points) do
            if seen[node] then continue end
            seen[node]=true
            local match=(typeof(marker)=="Instance" and
                    (node==marker or node:IsDescendantOf(marker)))
                or norm(node.Name)==norm(objId)
                or (node.Position-pos).Magnitude<2.0
            if match then
                if type(firetouchinterest)=="function" then
                    local done=pcall(function()
                        firetouchinterest(root,node,0)
                        firetouchinterest(root,node,1)
                    end)
                    interacted=interacted or done
