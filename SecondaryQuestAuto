    local function pressTomato(side)
        if side=="A" then side="Left" elseif side=="D" then side="Right" end
        if side~="Left" and side~="Right" then return false end
        local gui=player.PlayerGui:FindFirstChild("DodgeMinigameGui")
        local button=gui and gui:FindFirstChild(side.."Touch",true)
        if button and button:IsA("GuiButton") and button.Visible then
            if type(getconnections)=="function" then
                local ok,connections=pcall(getconnections,button.MouseButton1Down)
                if ok and type(connections)=="table" then
                    for _,conn in ipairs(connections) do
                        local fired=pcall(function() conn:Fire() end)
                        if not fired then
                            local cb
                            pcall(function() cb=conn.Function end)
                            if type(cb)=="function" then fired=pcall(cb) end
                        end
                        if fired then
                            R.tomatoInputs+=1
                            R.tomatoStatus="Bobo: toque "..side.." por conexão"
                            R.clownLastInputMethod="connection"
                            return true
                        end
                    end
                end
            end
            if type(firesignal)=="function" and pcall(firesignal,button.MouseButton1Down) then
                R.tomatoInputs+=1
                R.tomatoStatus="Bobo: toque "..side.." por sinal"
                R.clownLastInputMethod="firesignal"
                return true
            end
            if tomatoInput then
                local p,z=button.AbsolutePosition,button.AbsoluteSize
                local x,y=math.floor(p.X+z.X*.5),math.floor(p.Y+z.Y*.5)
                local ok=pcall(function()
