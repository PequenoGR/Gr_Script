        R.phantomActiveId=activeId
        if not sessionActive then
            local folder=phantomQuestParts()
            local marker=folder and folder:FindFirstChild("ActivateMinigamePart")
            if not marker or not marker:IsA("BasePart") then
                R.phantomStatus="Ativador TempleRun ainda não carregado"
