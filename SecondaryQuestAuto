                    R.phantomStatus="TempleRun Activate solicitado; aguardando sessão"
                    R.status=R.phantomStatus
                end
            end)
            return true
        end
        if remaining<=4 then
            R.phantomStatus="Fim válido do corredor; aguardando TempleRun End"
            R.status=R.phantomStatus
            once("SQTempleRunEnd",2.7,function()
                R.phantomAttempts+=1
                if server("MinigamesService","TempleRun",
                    {GameAction="End",id=activeId}) then
                    R.phantomStatus="TempleRun End solicitado; aguardando progresso"
                    R.status=R.phantomStatus
                end
            end)
            return true
        end
        local direction=Vector3.new(finish.X-root.Position.X,
            0,finish.Z-root.Position.Z)
        if direction.Magnitude<.01 then return true end
        local maxStep=math.min(direction.Magnitude,16)
        local desired=root.Position+direction.Unit*maxStep
        desired=Vector3.new(desired.X,start.Y+3.2,desired.Z)
