    local function interactMarker(pos,objId,marker)
        local _,root,hum,ok=alive()
        if not ok then return false end
        local interacted=false
        local points={}
        if typeof(marker)=="Instance" then
            if marker:IsA("BasePart") then table.insert(points,marker) end
            if marker:IsA("Model") then
                for _,v in ipairs(marker:GetDescendants()) do
                    if v:IsA("BasePart") then table.insert(points,v) end
                end
            end
        end
        local okParts,nearby=pcall(workspace.GetPartBoundsInRadius,workspace,pos,5)
        if okParts and type(nearby)=="table" then
            for _,p in ipairs(nearby) do table.insert(points,p) end
        end
        local seen={}
        for _,node in ipairs(points) do
            if seen[node] then continue end
            seen[node]=true
            local match=(typeof(marker)=="Instance" and
                    (node==marker or node:IsDescendantOf(marker)))
                or norm(node.Name)==norm(objId)
                or (node.Position-pos).Magnitude<2.0
            if match then
                if type(firetouchinterest)=="function" then
                    local done=pcall(function()
                        firetouchinterest(root,node,0)
                        firetouchinterest(root,node,1)
                    end)
                    interacted=interacted or done
                end
                local prompt=node:FindFirstChildWhichIsA("ProximityPrompt",true)
                if prompt and type(fireproximityprompt)=="function" then
                    interacted=pcall(fireproximityprompt,prompt) or interacted
                end
                local click=node:FindFirstChildWhichIsA("ClickDetector",true)
                if click and type(fireclickdetector)=="function" then
                    interacted=pcall(fireclickdetector,click) or interacted
                end
            end
        end
        return interacted
    end
    local function doZone(quest,obj,pos)
        local id=tostring(obj.ObjectiveID or "")
        if not zoneModules[id] then
            if pos then moveTo(pos,5,"Indo ao objetivo "..id) end
            R.status="Ação especial pendente: "..id
            return
        end
        if not moveTo(pos,3.3,"Interagindo com "..id) then return end
        R.desertStatus=(quest.island=="Golden Dunes" and id or "-")
        if passiveZone[id] then
            R.status="Zona alcançada; aguardando atualização: "..id
            return
        end
        once("SQZone:"..id,3.0,function()
            local d=data()
            local q=active(d)
            local current=q and nextObjective(q,d)
            if not current or current.ObjectiveID~=id then return end
            R.zoneAttempts+=1
            R.zoneStatus="Start "..id
            if server("QuestZones",id,"Start") then
                local zoneDelay=id=="Fill_WaterBucket_SQ" and 1.3 or
                    (id:find("^Read_LostInscription") and 1.48 or 1.35)
                task.delay(zoneDelay,function()
                    if not R.enabled or not C.running() then return end
                    local currentData=data()
                    local activeQuest=active(currentData)
                    local pending=activeQuest and nextObjective(activeQuest,currentData)
                    local _,root,hum,aliveNow=alive()
                    if pending and pending.ObjectiveID==id and aliveNow and
                        typeof(pos)=="Vector3" and (root.Position-pos).Magnitude<=8 then
                        R.zoneStatus="Use "..id
                        server("QuestZones",id,"Use")
                    end
                end)
                R.status="Executando objetivo "..id
            end
        end)
