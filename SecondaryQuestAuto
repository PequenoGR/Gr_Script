    local function moveTo(pos,near,label)
        R.interactionTarget=tostring(label)
        if typeof(pos)~="Vector3" then
            stopRoute()
            R.status="Posição não carregada: "..label
            R.interactionDistance=nil
            return false
        end
        local _,root,hum,ok=alive()
        if not ok then return false end
        local dist=(root.Position-pos).Magnitude
        R.interactionDistance=math.floor(dist*10)/10
        local arrival=math.clamp(tonumber(near) or 3.5,2.4,7)
        local yOffset=dist>15 and 1.8 or 0.35
        if dist>arrival then
            C.definirDestino(pos+Vector3.new(0,yOffset,0),"SecondaryQuest")
            R.status=label.." ("..math.floor(dist).." studs)"
            return false
        end
        stopRoute()
        return true
    end
    local function travelTo(quest)
        local island=quest.island
        R.currentIsland=tostring(C.localAtual() or "")
        if island=="Treasure Hunt" or island=="Wanted Posters" or island=="Beggar Rescue" then return false end
        if island=="Sky Hermit" then island="Solmar Island" end
        if norm(R.currentIsland)==norm(island) or
            (island=="Circus Town" and R.currentIsland=="Circus") or
            (island=="Golden Dunes" and
                (R.currentIsland=="Black Market" or
                 R.currentIsland=="Interior of the Pyramid")) then return false end
        if C.IslandTeleport.traveling then
            R.status="Viajando para "..island
            return true
        end
        local map=workspace:FindFirstChild("Map")
        local areas=map and map:FindFirstChild("Areas")
        if not areas or not areas:FindFirstChild(island) then
            R.status="Mapa não carregado: "..island
            return true
        end
        local _,root,hum,ok=alive()
        if not ok then return true end
        local center=areas[island]:GetAttribute("MapCenter")
        if typeof(center)=="Vector3" and (root.Position-center).Magnitude<600 then return false end
        if os.clock()-R.lastTravel>28 then
            R.lastTravel=os.clock()
            C.IslandTeleport.choose(island)
            C.IslandTeleport.go()
            R.status="Auto Quest: viajando até "..island
        else
            R.status="Auto Quest: aguardando viagem a "..island
        end
        return true
    end
    local function nextObjective(quest,d)
        local qs=d and d.Quests and d.Quests.Actives
        local rows=qs and qs[quest.name]
        if type(rows)~="table" then return nil end
        local activeIds=liveObjectives()
        local fallback
        for stage,step in ipairs(quest.info.SubQuests or {}) do
            local values=rows[stage] or {}
            local pending=false
            for i,objective in ipairs(step.Objectives or {}) do
                local current=tonumber(values[i]) or 0
                if current<(tonumber(objective.Goal) or 1) then
                    pending=true
                    local valid=true
                    if type(objective.Validate)=="function" then
                        local ok,res=pcall(objective.Validate,player)
                        valid=ok and res~=false
                    end
                    if valid then
                        local candidate={objective,stage,i,current}
                        if activeIds and activeIds[objective.ObjectiveID]~=nil then
                            return table.unpack(candidate)
                        end
                        if not fallback then fallback=candidate end
                    end
                end
            end
            if pending then break end
        end
        if fallback and not activeIds then return table.unpack(fallback) end
        return nil
    end
    local function objectivePoint(quest,obj)
        local callable=obj.InterestPoint
        local function resolve(where)
            local point=position(where)
            if point then return point,where end
            if type(where)=="table" then
                for _,value in pairs(where) do
                    local p=position(value)
                    if p then return p,value end
                end
            end
            return nil
        end
        if type(callable)=="function" then
            local ok,where=pcall(callable)
            if ok then
                local p,inst=resolve(where)
                if p then return p,inst end
            end
        else
            local p,inst=resolve(callable)
            if p then return p,inst end
        end
        local objId=tostring(obj.ObjectiveID or "")
        local zoneData=modulePath(workspace,{"IgnoreList","Data","Quests","Zones"})
        local folder=zoneData and zoneData:FindFirstChild(quest.island)
        if folder then
            local part=folder:FindFirstChild(objId,true)
            if part then
                local p,inst=resolve(part)
                if p then return p,inst end
            end
            local attr=folder:GetAttribute(objId)
            if typeof(attr)=="Vector3" then return attr,nil end
        end
        local map=workspace:FindFirstChild("Map")
        local areas=map and map:FindFirstChild("Areas")
        local area=areas and areas:FindFirstChild(quest.island)
        local worldObject=area and area:FindFirstChild(objId,true)
        if worldObject then
            local p,inst=resolve(worldObject)
            if p then return p,inst end
        end
        return nil,nil
    end
    local function doorForPoint(obj)
        if typeof(obj)~="Instance" then return nil end
        if obj.Name=="Entrance" and obj.Parent and
            (obj.Parent.Name=="Enter" or obj.Parent.Name=="Leave") then
            return obj.Parent,obj
        end
        if obj.Name:sub(1,5)=="Door_" then
            local private=modulePath(workspace,{"IgnoreList","Int","PrivateAreas"})
            if private then
                local raw=obj.Name:sub(6)
                for _,island in ipairs(private:GetChildren()) do
                    for _,section in ipairs(island:GetChildren()) do
                        for _,action in ipairs({"Enter","Leave"}) do
                            if norm(island.Name.."_"..section.Name.."_"..action)==norm(raw) then
                                local gate=section:FindFirstChild(action)
                                return gate,gate and gate:FindFirstChild("Entrance")
                            end
                        end
                    end
                end
            end
        end
        return nil
    end
    local function interactDoor(point,marker)
        local door,part=doorForPoint(marker)
        if not door then return false end
        if not moveTo(point,3.1,"Passando pela porta "..door.Name) then
            R.doorStatus="Aproximando da porta "..door.Name
            return true
        end
        once("SQDoor:"..door:GetFullName(),1.2,function()
            R.doorAttempts+=1
            R.doorStatus="Ativando porta "..door.Name
            local _,root,hum,valid=alive()
            if not valid then return end
            if part and part:IsA("BasePart") and type(firetouchinterest)=="function" then
                pcall(function()
                    firetouchinterest(root,part,0)
                    firetouchinterest(root,part,1)
                end)
            end
            local prompt=door:FindFirstChildWhichIsA("ProximityPrompt",true)
            if prompt then
                if type(fireproximityprompt)=="function" then
                    pcall(fireproximityprompt,prompt)
                else
                    pcall(function()
                        prompt:InputHoldBegin()
                        task.delay(math.max(prompt.HoldDuration,.1),function()
                            if prompt.Parent then prompt:InputHoldEnd() end
                        end)
                    end)
                end
            end
            if C.privateClient and C.privateClient.Current then
                server("PrivateAreas","EnterArea",C.privateClient.Current)
            end
            pcall(function() hum:MoveTo(point) end)
        end)
        R.status=R.doorStatus
        return true
    end
    local function findTarget(name,root)
        if os.clock()-R.lastEnemyScan<.55 and R.lastEnemy
            and R.lastEnemyName==name and C.valido(R.lastEnemy) then return R.lastEnemy end
        R.lastEnemyScan=os.clock()
        local item=C.encontrarInimigo(name,root)
        if item and C.valido(item) then R.lastEnemy=item;R.lastEnemyName=name;return item end
        local ignore=workspace:FindFirstChild("IgnoreList")
        local int=ignore and ignore:FindFirstChild("Int")
        local play=workspace:FindFirstChild("Playability")
        local best=math.huge
        for _,base in ipairs({play or false,int or false}) do
            if base then
                local folder=base:FindFirstChild("Enemys") or base:FindFirstChild("Enemies")
                if folder then
                    for _,model in ipairs(folder:GetChildren()) do
                        if model:IsA("Model") and C.valido(model) then
                            local r=C.rootInimigo(model)
                            local actor=norm(model.Name)
                            local wanted=norm(name)
                            if r and (actor==wanted or actor==wanted.."history" or
                                norm(model:GetAttribute("EnemyName"))==wanted) then
                                local dist=(r.Position-root.Position).Magnitude
                                if dist<best then best=dist;item=model end
                            end
                        end
                    end
                end
            end
        end
        R.lastEnemy=item
        R.lastEnemyName=name
        return item
    end
    local function attack(quest,obj,pos)
        local name=tostring(obj.ObjectiveID):gsub("^Defeat_","")
        local _,root,hum,ok=alive()
        if not ok then return end
        local enemy=findTarget(name,root)
        local er=enemy and C.rootInimigo(enemy)
        if not er then
            if pos then moveTo(pos,7,"Procurando "..name) else
                R.status="Aguardando inimigo "..name.." carregar" end
            return
        end
        if not moveTo(er.Position+Vector3.new(0,2.5,0),8,"Atacando "..name) then return end
        local tool=C.equiparArma()
        if not tool then
            local bp=player:FindFirstChildOfClass("Backpack")
            local candidate=bp and bp:FindFirstChild("Combat")
            if candidate then
                pcall(function() hum:EquipTool(candidate) end)
                tool=candidate.Parent==player.Character and candidate or nil
            end
        end
        if not tool then R.status="Equipe uma espada ou Combat para derrotar "..name;return end
        once("SQAttack",.17,function()
            tool:Activate()
            if C.CombatEvent then C.CombatEvent:FireServer("Activate",tool.Name) end
            R.status="Derrotando "..name
        end)
    end
