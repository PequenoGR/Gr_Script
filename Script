    end
    FeatureState.alvoFruta = nil
    FeatureState.nomeFrutaAtual = nil
    FeatureState.frutaOcupada = false
    FeatureState.inicioTentativaFruta = 0
    FeatureState.ultimoContatoFruta = 0
    FeatureState.ultimoProgressoFruta = 0
