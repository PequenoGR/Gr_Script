            for _,item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local n=item.Name:lower()
                    if n:find("fishing",1,true) and (n:find("rod",1,true) or n:find("road",1,true)) then
                        return item
                    end
                end
            end
        end
    end
    return nil
end
local function atualizarLancamentoPesca()
    if not State.AutoFishing or not State.AutoCastFishing or not running() then return end
    if pescaHUD and pescaHUD.Parent and pescaHUD.Visible then return end
    if os.clock()<bloquearAtePesca or os.clock()-ultimoLancamentoPesca<8 then return end
    local _,root,hum=character()
    if not root or not hum or hum.Health<=0 or frutaOcupada then return end
    local vara=encontrarVaraPesca()
    if not vara then statusPesca="Fishing Rod não encontrada";return end
    ultimoLancamentoPesca=os.clock()
    bloquearAtePesca=os.clock()+1.5
    pescandoAgora=true
    liberarVoo()
    if vara.Parent~=player.Character then
        pcall(function() hum:EquipTool(vara) end)
        task.wait(0.15)
    end
    if vara.Parent==player.Character then
        local ok=pcall(function() vara:Activate() end)
        statusPesca=ok and "Lançando vara; aguardando peixe" or "Falha ao lançar vara"
    else
        statusPesca="Não foi possível equipar vara"
    end
end
local function parar()
    State.AutoFarmQuest=false
    State.AutoFarmFruit=false
    frutaOcupada=false
    State.FruitESP=false
    State.AutoStoreFruit=false
    State.AutoStats=false
    State.AutoFishing=false
    State.AutoCastFishing=false
    pescandoAgora=false
    limparConexoesPesca()
    loopId+=1
    liberarVoo()
    if limparFrutasESPGeral then limparFrutasESPGeral() end
    if afkConn then afkConn:Disconnect();afkConn=nil end
    for _,c in ipairs(conexoes) do pcall(function() c:Disconnect() end) end
    table.clear(conexoes)
    for hum,data in pairs(origHum) do
        if hum.Parent then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,data.fall)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,data.rag)
            end)
        end
    end
    if running() then env.GRHubRun=runId+1 end
end
