local function nomeConfere(e,nome)
    if not e or not e:IsA("Model") then return false end
    if e.Name:lower():find("history",1,true) then return false end
    local esperado=normalizar(nome)
    if esperado=="" then return false end
    local nomes={
        e.Name,
        e:GetAttribute("OriginalName"),
        e:GetAttribute("EnemyName"),
        e:GetAttribute("AlternativeName"),
        e:GetAttribute("DisplayName"),
        e:GetAttribute("NPCName"),
        e:GetAttribute("MobName"),
        e:GetAttribute("EntityName")
    }
    for _,n in pairs(nomes) do
        if n~=nil then
            local atual=normalizar(tostring(n):gsub("[_%- ]?%d+$",""))
            if atual==esperado or (#atual>#esperado and atual:sub(1,#esperado)==esperado) then
                return true
            end
        end
    end
    return false
end

local function vidaInimigo(e)
    local h=e:GetAttribute("HandlerHealth")
    if type(h)=="number" then return h end
    local hum=e:FindFirstChildOfClass("Humanoid")
