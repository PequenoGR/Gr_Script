local function pastaFrutas()
    if FeatureState.pastaFrutasCache and FeatureState.pastaFrutasCache.Parent then return FeatureState.pastaFrutasCache end
    local p=workspace:FindFirstChild("Playability")
    FeatureState.pastaFrutasCache=p and p:FindFirstChild("DroppedTools")
    return FeatureState.pastaFrutasCache
end

local function nomeDaFruta(item)
    if not item or not item:IsA("Tool") then return nil end
    local base=item.Name:gsub("%s+[Ff]ruit$", "")
    local att=item:GetAttribute("Fruit")
    if type(att)=="string" and att~="" then base=att:gsub("%s+[Ff]ruit$", "") end
    local key=base:lower()
    for _,name in ipairs(FRUIT_NAMES) do
        if name:lower()==key then return name end
    end
    for apelido,canonico in pairs(FRUIT_ALIASES) do
        if apelido:lower()==key then return canonico end
    end
    return nil
end

local function frutaValida(item)
    return item and item.Parent and item:IsA("Tool")
        and (item:GetAttribute("Fruit")~=nil or item.Name:match("[Ff]ruit$"))
        and nomeDaFruta(item)~=nil
end

local function handleFruta(item)
    if not item then return nil end
    local h=item:FindFirstChild("Handle")
    if h and h:IsA("BasePart") then return h end
    for _,v in ipairs(item:GetDescendants()) do
        if v:IsA("BasePart") then return v end
    end
    return nil
end

local function atualizarListaFrutas()
    if os.clock()-FeatureState.ultimaVarreduraFrutas<0.5 then return end
    FeatureState.ultimaVarreduraFrutas=os.clock()
    table.clear(FeatureState.frutasVisiveis)
    local folder=pastaFrutas()
    if not folder then return end
    for _,item in ipairs(folder:GetChildren()) do
        if frutaValida(item) and handleFruta(item) then
            table.insert(FeatureState.frutasVisiveis,item)
        end
    end
end

local function apagarESP(item)
    local info=FeatureState.espFrutas[item]
    if not info then return end
    FeatureState.espFrutas[item]=nil
    for _,obj in ipairs(info.objects) do
        pcall(function() if obj and obj.Parent then obj:Destroy() end end)
    end
end

limparFrutasESPGeral=function()
    for item in pairs(FeatureState.espFrutas) do apagarESP(item) end
end

local function adicionarESP(item)
    if FeatureState.espFrutas[item] then return end
    local h=handleFruta(item)
    local name=nomeDaFruta(item)
    if not h or not name then return end
    local rarity=FRUIT_RARITY[name] or "Common"
    local color=FRUIT_COLOR[rarity] or Color3.new(1,1,1)
    local glow=Instance.new("Highlight")
    glow.Name="GRHubFruitHighlight"
    glow.Adornee=h
    glow.FillColor=color
    glow.OutlineColor=color
    glow.FillTransparency=0.72
    glow.OutlineTransparency=0
    glow.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    glow.Parent=h
    local bb=Instance.new("BillboardGui")
    bb.Name="GRHubFruitESP"
    bb.AlwaysOnTop=true
    bb.Adornee=h
    bb.Size=UDim2.fromOffset(185,42)
    bb.StudsOffsetWorldSpace=Vector3.new(0,3.5,0)
    bb.MaxDistance=100000
    bb.Parent=h
    local text=Instance.new("TextLabel")
    text.BackgroundTransparency=1
    text.Size=UDim2.fromScale(1,1)
    text.TextColor3=color
    text.TextStrokeColor3=Color3.new(0,0,0)
    text.TextStrokeTransparency=0
    text.Font=Enum.Font.GothamBold
    text.TextSize=13
    text.TextWrapped=true
    text.Parent=bb
    FeatureState.espFrutas[item]={objects={glow,bb},label=text,handle=h,name=name}
end

local function atualizarESP()
    if not State.FruitESP then
        if next(FeatureState.espFrutas) then limparFrutasESPGeral() end
        return
    end
    local _,root=character()
    for _,item in ipairs(FeatureState.frutasVisiveis) do adicionarESP(item) end
    for item,info in pairs(FeatureState.espFrutas) do
        if not frutaValida(item) or not item:IsDescendantOf(pastaFrutas() or workspace) then
            apagarESP(item)
        elseif info.label and info.label.Parent and info.handle.Parent then
            local dist=root and math.floor((root.Position-info.handle.Position).Magnitude) or 0
            info.label.Text=(FeatureState.frutasSelecionadas[info.name] and "✓ " or "")
                ..info.name.." Fruit ["..FRUIT_RARITY[info.name].."]\n"..dist.." studs"
        end
    end
end

local function finalizarTentativaFruta(bloquear, pausa)
    local antiga = FeatureState.alvoFruta
    if rota and antiga and rota.chave == antiga then
        liberarVoo()
    end
    if bloquear and antiga then
        FeatureState.blacklistFrutas[antiga] = os.clock() + 18
        FeatureState.falhasFrutas += 1
        if FeatureState.falhasFrutas >= 2 then
            FeatureState.cooldownFrutasAte = os.clock() + 10
            FeatureState.falhasFrutas = 0
        end
    elseif pausa and pausa > 0 then
        FeatureState.cooldownFrutasAte = os.clock() + pausa
    end
    FeatureState.alvoFruta = nil
    FeatureState.nomeFrutaAtual = nil
    FeatureState.frutaOcupada = false
    FeatureState.inicioTentativaFruta = 0
    FeatureState.ultimoContatoFruta = 0
    FeatureState.ultimoProgressoFruta = 0
    FeatureState.distanciaAnteriorFruta = math.huge
    FeatureState.frutaTPFeito = false
    FeatureState.faseFruta = "Parado"
end

local function setFrutasEscolhidas(lista)
    finalizarTentativaFruta(false, 0)
    table.clear(FeatureState.frutasSelecionadas)
    if type(lista) ~= "table" then return end
    for _, v in ipairs(lista) do
        local s = type(v) == "table" and (v.Name or v.Value) or v
        if type(s) == "string" then
            for _, name in ipairs(FRUIT_NAMES) do
                if s == name then
                    FeatureState.frutasSelecionadas[name] = true
                    break
                end
            end
        end
    end
    FeatureState.cooldownFrutasAte = 0
end

local function encontrarFruta(root)
    local escolhida, menor = nil, math.huge
    local agora = os.clock()
    for _, item in ipairs(FeatureState.frutasVisiveis) do
        local name = nomeDaFruta(item)
        local h = handleFruta(item)
        if name and h and FeatureState.frutasSelecionadas[name]
            and h.Position.Y >= -250
            and (not FeatureState.blacklistFrutas[item] or agora >= FeatureState.blacklistFrutas[item]) then
            local dist = (root.Position - h.Position).Magnitude
            if dist < menor then
                escolhida, menor = item, dist
            end
        end
    end
    return escolhida
end

local function frutaNoInventario(item, nome)
    local char = player.Character
    local mochila = player:FindFirstChild("Backpack")
    if item and (item.Parent == char or item.Parent == mochila) then
        return true
    end
    for _, base in ipairs({char or false, mochila or false}) do
        if base then
            for _, tool in ipairs(base:GetChildren()) do
                if tool:IsA("Tool") and tool:GetAttribute("Fruit")
                    and nomeDaFruta(tool) == nome then
                    return true
                end
            end
        end
    end
    return false
end

local function tocarFruta(item, handle, char, root, humanoid)
    if not handle or not handle.Parent then return false end
    if (root.Position - handle.Position).Magnitude > 12 then return false end

    if rota and rota.chave == item then
        liberarVoo()
    end

    if firetouchinterest then
        for _, nome in ipairs({"HumanoidRootPart", "UpperTorso", "Torso", "RightFoot", "LeftFoot"}) do
            local parte = char:FindFirstChild(nome)
            if parte and parte:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(parte, handle, 0)
                    firetouchinterest(parte, handle, 1)
                end)
            end
        end
    end
    local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            pcall(fireproximityprompt, prompt)
        else
            pcall(function()
                prompt:InputHoldBegin()
                task.delay(math.max(prompt.HoldDuration, 0.12), function()
                    if prompt.Parent then prompt:InputHoldEnd() end
                end)
            end)
        end
    end
    pcall(function() humanoid:MoveTo(handle.Position) end)
    return true
end

local function coletarFruta(item)
    local handle = handleFruta(item)
    local char, root, humanoid = character()
    if not handle or not root or not humanoid or humanoid.Health <= 0 then
        return false
    end
    if emTransicao() or dentroVulcao() or handle.Position.Y < -250 then
        return false
    end

    local destino = handle.Position + Vector3.new(0, 2, 0)
    local distancia = (root.Position - handle.Position).Magnitude
    local agora = os.clock()

    if not FeatureState.frutaTPFeito then
        FeatureState.frutaTPFeito = true
        FeatureState.faseFruta = "TP inicial"
        if rota then liberarVoo() end
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(destino) * root.CFrame.Rotation
        end)
        distancia = (root.Position - handle.Position).Magnitude
    end

    if distancia > 10 then
        FeatureState.faseFruta = "Voo até a fruta"
        FeatureState.statusFruta = "Indo até " .. tostring(FeatureState.nomeFrutaAtual)
        definirDestino(destino, item)
    else
        FeatureState.faseFruta = "Tentando coletar"
        FeatureState.statusFruta = "Coletando " .. tostring(FeatureState.nomeFrutaAtual)
        if agora - FeatureState.ultimoContatoFruta >= 0.65 then
            FeatureState.ultimoContatoFruta = agora
            tocarFruta(item, handle, char, root, humanoid)
        end
    end
    return true
end

