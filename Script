    local function autoHakiMission()
        if not V.fullAuto or not running() then return end
        if not hakiFree() then
            V.status="Auto Haki pausado por outra atividade"
            stopHakiRoute()
            return
        end
        local info=V.miniManager or minigameInfo()
        if info and info.Active then
            V.status="Auto Haki: minigame "..tostring(info.Active.Name)
            stopHakiRoute()
            return
        end
        local data=lerDados()
        local _,root,hum=character()
        if not root or not hum or hum.Health<=0 or not data then return end
        local quest=activeQuest(data)
        if checkSkullTravel(root) then return end
        if quest~="Vox Sense Training" then
            V.fishingReady=false
            FeatureState.hakiFishingLookAt=nil
        end
        if not quest then
            local sense,armor=levels(data)
            local candidate=sense<1 or armor<1
            if not candidate then
                candidate=trainingStep("Kenbushoku",sense+1)~=nil or
                    trainingStep("Busoshoku",armor+1)~=nil
            end
            if not candidate then
                V.status="Auto Haki: Vox Sense / Armor no máximo"
                stopHakiRoute()
                return
            end
            if lerNivel(data)<145 then
                V.status="Auto Haki: precisa de nível 145 para começar"
                stopHakiRoute()
                return
            end
            if moveHakiTo(trainerPosition(),16,"indo até Askard") then
                tryRequest()
            end
            return
        end
        local objective=currentObjective(quest,data)
        if objective~="Catch_Fish" then
            V.fishingReady=false
            FeatureState.hakiFishingLookAt=nil
        end
        V.activeQuest=quest
        V.activeObjective=objective
        if not objective then
            V.status="Auto Haki: aguardando objetivo atualizado em "..quest
            stopHakiRoute()
            return
        end
        if lastObjective~=objective then
            lastObjective=objective
            V.fishingReady=false
            V.status="Auto Haki: novo objetivo "..objective
        end
        if objective:sub(1,11)=="Talk_Askard" then
            if moveHakiTo(trainerPosition(),14,"conversar com Askard") then
                autoAction(objective,4,function()
                    network(nil)
                    V.status="Auto Haki: conversando com Askard"
                end)
            end
        elseif objective=="Defeat_Boar" then
            autoFight("Boar",skullMarker("InterestPoints","BoarField"))
        elseif objective=="Defeat_GiantBoarHistory" then
            autoFight("Giant Boar",skullMarker("InterestPoints","GiantBoarArena"))
        elseif objective=="Defeat_AskardHistory" then
            autoFight("Askard",trainerPosition())
        elseif objective=="Trial1_Askard_HK" or objective=="Trial2_Askard_HK" then
            if moveHakiTo(trainerPosition(),5,"teste final com Askard") then
                autoAction(objective,5,function() network(nil) end)
            end
        elseif objective=="Collect_WaterBarrel_HK" then
            local area=skullArea()
            local instances=area and area:FindFirstChild("Instances")
            local well=instances and instances:FindFirstChild("Poço")
            local pos=posicaoDe(well) or skullMarker("Zones","Collect_WaterBarrel_HK")
            if moveHakiTo(pos,4,"indo ao poço da Skull Island") then
                autoAction(objective,5,function()
                    if dadosModulo and dadosModulo.Network then
                        dadosModulo.Network:FireServer("QuestZones",objective,"Start")
                        task.delay(1.25,function()
                            if not running() or not V.fullAuto or not objectiveActive(objective) then return end
                            local _,r=character()
                            if not r or (r.Position-pos).Magnitude>12 then return end
                            pcall(function()
                                dadosModulo.Network:FireServer("QuestZones",objective,"Use")
                            end)
                        end)
                        V.status="Auto Haki: enchendo o barril"
                    end
                end)
            end
        elseif objective=="Catch_Fish" then
            local marker=skullMarker("InterestPoints","FishingSpot_HK")
            V.fishMarker=marker
            if not encontrarVaraPesca() then
                V.fishingReady=false
                stopHakiRoute()
                local inventory=data and data.Tools
                if type(inventory)~="table" then inventory=data and data.Base and data.Base.Tools end
                local stored=inventory and inventory.Unequiped
                local equipped=inventory and inventory.Equiped
                local function isRod(item)
                    if type(item)~="table" then return false end
                    local n=tostring(item.Name or ""):lower()
                    return n:find("fishing",1,true) and
                        (n:find("rod",1,true) or n:find("road",1,true))
                end
                local rodIndex,rodName
                if type(stored)=="table" then
                    for index,item in ipairs(stored) do
                        if isRod(item) then rodIndex=index;rodName=item.Name;break end
                    end
                end
                if rodIndex and dadosModulo and dadosModulo.Network then
                    autoAction("HakiEquipRod",5,function()
                        dadosModulo.Network:FireServer("ToolsData","Equip",rodIndex,rodName)
                        V.status="Auto Haki: equipando "..rodName.." do inventário"
                    end)
                else
                    local owned=false
                    if type(equipped)=="table" then
                        for _,item in ipairs(equipped) do
                            if isRod(item) then owned=true;break end
                        end
                    end
                    if not owned and objectiveActive("Buy_FishingRod_WB")
                        and dadosModulo and dadosModulo.Network
                        and type(dadosModulo.Network.SafeInvokeServer)=="function" then
                        autoAction("HakiBuyRod",12,function()
                            local answer=dadosModulo.Network:SafeInvokeServer(5,"Elysium_Converse","Fisherman")
                            V.status="Auto Haki: compra da vara com Fisherman: "..tostring(answer)
                        end)
                    else
                        V.status=owned and "Auto Haki: vara equipada; aguardando Backpack"
                            or "Auto Haki: sem vara no inventário; compra pelo Fisherman requer Buy_FishingRod_WB"
                    end
                end
            else
                local point=fishingHoverPoint(marker)
                V.fishBank=point
                if not point then
                    stopHakiRoute()
                    V.fishingReady=false
                    V.status="Auto Haki: ponto de pesca não carregado"
                elseif V.fishingHover and V.fishingHoverPosition then
                    V.fishingReady=updateHakiFishingHover()
                    V.status="Auto Haki: parado no ar pescando 10 peixes"
                elseif moveHakiTo(point-Vector3.new(0,2.5,0),4,"voando até a água para pescar") then
                    V.fishingHoverPosition=point
                    if updateHakiFishingHover() then
                        V.fishingReady=true
                        FeatureState.hakiFishingLookAt=marker
                        V.status="Auto Haki: parado no ar, pescando 10 peixes"
                    else
                        V.fishingReady=false
                        V.status="Auto Haki: iniciando voo parado"
                    end
                end
            end
        elseif objective:find("^Break_Stone_HK_") or objective=="Train_VoxArmor_VX" then
            local n=tonumber(objective:match("_(%d+)$"))
            if not n then
                local _,lv=levels(data)
                local step=trainingStep("Busoshoku",lv+1)
                n=step and step.Stone or 10
            end
            if n then
                V.stoneIndex=n
                local pos=stonePoint(n)
                if moveHakiTo(pos,10,"indo até pedra "..n) then
                    tryStartHakiMini()
                    V.status="Auto Haki: treinando Vox Armor na pedra "..n
                end
            else
                V.status="Auto Haki: nenhuma pedra do Vox Armor disponível no nível atual"
            end
        elseif objective=="Dodge_Stones_HK" or objective=="Dodge_Blindfold_HK"
            or objective=="Spar_Askard_HK" or objective=="Train_VoxSense_VX" then
            if moveHakiTo(trainerPosition(),16,"indo ao treino de reflexos") then
                tryStartHakiMini()
                V.status="Auto Haki: iniciando "..objective
            end
        elseif objective:sub(1,6)=="Watch_" then
            if moveHakiTo(trainerPosition(),16,"indo à história do Haki") then
                autoAction(objective,5,function() network(nil) end)
            end
        else
            V.status="Auto Haki: etapa pendente "..objective
        end
    end
    task.spawn(function()
        while running() do
            if V.fullAuto then
                local ok,err=pcall(autoHakiMission)
                if not ok and os.clock()-V.lastError>5 then
                    V.lastError=os.clock()
                    V.status="Erro Auto Haki: "..tostring(err)
                    warn("[GR Hub Haki Auto]",err)
                end
            end
            task.wait(V.fullAuto and .22 or 1.2)
        end
        stopHakiRoute()
    end)

    function V.setMini(v)
        V.autoMini=(v==true)
        V.miniStatus=V.autoMini and "Aguardando minigame Haki" or "Desligado"
        if V.autoMini then
            minigameInfo()
            watchMinigame()
        end
    end
    function V.setMiniStart(v)
        V.autoMiniStart=(v==true)
        if V.autoMiniStart then V.miniLastStart=0 end
    end
    function V.showMini()
        notify("Auto Haki Completo: "..tostring(V.fullAuto)..
            " | Auto minigame: "..tostring(V.fullAuto or V.autoMini)..
            " | Pesca Vox: "..tostring(V.fullAuto or V.autoMiniFishing)..
            " | Início perto do treino: "..tostring(V.fullAuto or V.autoMiniStart)..
            " | Comandos enviados: "..V.miniInputs..
            " | Inícios pedidos: "..V.miniStarts..
            " | "..V.miniStatus)
    end
    function V.setFullAuto(v)
        V.fullAuto=(v==true)
        State.AutoHaki=V.fullAuto
        if V.fullAuto then
            if State.AutoFarmQuest then definirFarm(false) end
            if State.AutoFarmFruit then definirFarmFruta(false) end
            if State.AutoBoss then BossFarm.setAuto(false) end
            if State.AutoSeaBeast then Sea.setAuto(false) end
            if State.AutoRaid then Raid.setAuto(false) end
            if FeatureState.islandTraveling then IslandTeleport.stop() end
            V.lastRequest=-100
            V.miniLastStart=-100
            V.miniStatus="Auto Haki Completo: procurando treinos"
            V.status="Auto Haki Completo: ligado"
            minigameInfo()
            watchMinigame()
        else
            V.miniStatus=V.autoMini and "Auto MiniGames individual ligado" or "Auto Haki Completo desligado"
            V.status="Auto Haki Completo: desligado"
            restoreHakiFishing()
            stopHakiRoute()
        end
    end
    local function stopMini()
        State.AutoHaki=false
        stopHakiRoute()
        V.fullAuto=false
        V.autoMini=false
        V.autoMiniStart=false
        V.miniSession=nil
        local c=V.miniConnection
        V.miniConnection=nil
        if c then pcall(function() c:Disconnect() end) end
        restoreHakiFishing()
        if env.GRHubVoxMinigameStop==stopMini then env.GRHubVoxMinigameStop=nil end
    end
    env.GRHubVoxMinigameStop=stopMini
    task.spawn(function()
        while running() do
            if V.fullAuto or V.autoMini then
                local ok,err=pcall(function()
                    watchMinigame()
                    local active=minigameActive()
                    if active then
                        if active.Name=="Dodge" then doDodge()
                        elseif active.Name=="StoneBreak" then doStoneClicks() end
                    else
                        tryStartHakiMini()
                    end
                end)
                if not ok and os.clock()-V.lastError>5 then
                    V.lastError=os.clock()
                    V.miniStatus="Erro minigame: "..tostring(err)
                    warn("[GR Hub Vox Minigames]",err)
                end
            end
            task.wait((V.fullAuto or V.autoMini) and .025 or .85)
        end
        stopMini()
    end)
    task.spawn(function()
        while running() do
            local ok,err=pcall(function()
                if V.fullAuto or V.autoArmor then activate("Busoshoku") end
                if V.fullAuto or V.autoSense then activate("Kenbushoku") end
                tryRequest()
                updateHakiFishing()
            end)
            if not ok and os.clock()-V.lastError>5 then
                V.lastError=os.clock()
                V.status="Erro Vox: "..tostring(err)
                warn("[GR Hub Vox]",err)
            end
            task.wait((V.fullAuto or V.autoArmor or V.autoSense or V.autoUnlock or V.autoMastery or V.autoMiniFishing) and .75 or 2)
        end
    end)
    return V
end)()

