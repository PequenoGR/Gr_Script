local function questPeloHUD()
    local melhor,score=nil,0
    for _,texto in ipairs(lerLabels()) do
        if not texto:match("%d+%s*/%s*%d+") then
            local t=normalizar(texto)
            for _,c in ipairs(CAMPANHAS) do
                for _,n in ipairs({c.title,c.questName}) do
                    local nome=normalizar(n)
                    if #nome>score and t:find(nome,1,true) then melhor,score=c,#nome end
                end
            end
        end
    end
    return melhor
end
