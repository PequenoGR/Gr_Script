    local function tap(button)
        if not button or not button:IsA("GuiButton") or
            not button.Parent or not button.Visible then return false end
        local size=button.AbsoluteSize
        local p=button.AbsolutePosition
        if size.X<3 or size.Y<3 then return false end
        local signal=button.MouseButton1Down
        if type(getconnections)=="function" then
            local ok,connections=pcall(getconnections,signal)
            if ok and type(connections)=="table" then
                for _,conn in ipairs(connections) do
                    if conn.Enabled~=false then
                        local fired=pcall(function() conn:Fire() end)
                        if not fired then
                            local fn
                            pcall(function() fn=conn.Function end)
                            if type(fn)=="function" then fired=pcall(fn) end
                        end
                        if fired then
                            V.miniInputs+=1
                            V.miniInputMethod="Conexão do botão"
                            return true
                        end
                    end
                end
            end
        end
        if type(firesignal)=="function" then
            local ok=pcall(firesignal,signal)
            if ok then
                V.miniInputs+=1
                V.miniInputMethod="firesignal"
                return true
            end
        end
        if miniVim then
            local x=math.floor(p.X+size.X*.5)
            local y=math.floor(p.Y+size.Y*.5)
            local ok=pcall(function()
                miniVim:SendMouseButtonEvent(x,y,0,true,game,0)
                miniVim:SendMouseButtonEvent(x,y,0,false,game,0)
            end)
            if ok then
                V.miniInputs+=1
