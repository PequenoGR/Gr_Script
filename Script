    local function doDodge()
        if not V.fullAuto and not V.autoMini and not hakiObjective("Dodge") then return end
        local gui=player.PlayerGui:FindFirstChild("DodgeMinigameGui")
        if not gui or not gui.Enabled or gui:FindFirstChild("Result",true) then return end
        local session=V.miniSession
        if not session then return end
        local info=session.info or {}
        local mode=tostring(info.Mode or (gui:FindFirstChild("KeyPads",true) and "Spar" or "Stones"))
        V.miniMode=mode
        local schedule=info.Schedule
        if type(schedule)=="table" and #schedule>0 then
            if not session.clockSynced then
                session.started=os.clock()
                session.clockSynced=true
                session.next=1
                session.noteAttempts={}
            end
            local now=os.clock()-session.started
            local note=schedule[session.next]
            if type(note)=="table" then
                local spawn=tonumber(note.SpawnTime) or 0
                local travel=tonumber(info.Travel) or 0.6
                local due=mode=="Spar" and spawn+.16 or spawn+travel-(info.Touch and .08 or .03)
                local expiration=spawn+travel+(mode=="Spar" and .20 or .27)
                local last=session.noteAttempts[session.next] or -100
                if now>=due and now<expiration and now-last>=.17 then
                    session.noteAttempts[session.next]=now
                    local key=note.Key or note.Side
                    if type(key)=="string" and miniInput(key,mode) then
                        V.miniStatus="Auto "..mode.." "..key.." | "..session.next.."/"..#schedule
                        session.next+=1
                    else
                        V.miniStatus="Auto "..mode..": entrada "..tostring(key).." indisponível"
                    end
                elseif now>=expiration then
                    V.miniStatus="Auto "..mode..": nota "..session.next.." expirou"
                    session.next+=1
                end
            end
            return
        end
        local keyHint=gui:FindFirstChild("KeyHint",true)
        local letter=keyHint and keyHint:FindFirstChild("Letter",true)
        if not letter then return end
        local word=tostring(letter.Text):upper():gsub("%s+","")
        local letters={A="Left",LEFT="Left",D="Right",RIGHT="Right",F="F",G="G",H="H"}
        local key=letters[word]
        if not key then return end
        if mode=="Spar" then
            if word~=session.lastVisualKey or os.clock()-(session.lastVisualPress or -100)>.38 then
                if miniInput(key,mode) then
                    session.lastVisualKey=word
                    session.lastVisualPress=os.clock()
                    V.miniStatus="Auto Spar visual: "..word
                end
            end
            return
        end
        local fill=keyHint:FindFirstChild("Fill",true)
        if not fill then return end
        local progress=fill.Size.X.Scale
        if progress<.58 then
            session.wasPressed=false
            return
        end
        local threshold=mode=="Blind" and .93 or .90
        if progress>=threshold and progress<=1.08 and not session.wasPressed
            and os.clock()-V.miniLastPress>.15 and miniInput(key,mode) then
            session.wasPressed=true
            V.miniLastPress=os.clock()
            V.miniStatus="Auto Dodge: "..word
        end
    end
