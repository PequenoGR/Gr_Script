local function atualizarAutoStats()
    if not State.AutoStats or not running() then return end
    if os.clock()-ultimoUpgradeStats<2.5 then return end
    ultimoUpgradeStats=os.clock()
    local d=lerDados()
    local stat=d and d.Statistics
    local bal=mainModulo and mainModulo.BalancingFeatures
    local network=dadosModulo and dadosModulo.Network
    if type(stat)~="table" or not bal or not network or type(network.FireServer)~="function" then
        statusStats="Dados de Stats indisponíveis"
        return
    end
    local nivel=tonumber(stat.Level)
    local porNivel=tonumber(bal.PointsPerLevel)
    local limite=tonumber(bal.MaxLevel)
    if not nivel or not porNivel or porNivel<=0 or not limite then
        statusStats="Limites de Stats indisponíveis"
        return
    end
    local total=0
    for _,nome in ipairs(STATS_NAMES) do
        total+=tonumber(stat[nome]) or 1
    end
    local gastos=math.max(0,total-#STATS_NAMES)
    local disponiveis=math.max(0,math.floor((nivel-1)*porNivel-gastos))
    local atual=tonumber(stat[statSelecionado]) or 1
    local quantidade=math.min(disponiveis,math.max(0,math.floor(limite-atual)))
    if quantidade<1 then
        statusStats=disponiveis==0 and "Sem pontos disponíveis" or (statSelecionado.." no limite")
        return
    end
    local ok,erro=pcall(function()
        network:FireServer("StatisticsData","UpgradeStats",{[statSelecionado]=quantidade})
    end)
    if ok then
        ultimaQuantidadeStats=quantidade
        statusStats="Enviado: "..quantidade.." em "..statSelecionado
    else
        statusStats="Erro: "..tostring(erro)
    end
end
