        return closest
    end
    local function hazardClass(label)
        local text=tostring(label or ""):lower()
        if text:find("waterprojectile",1,true) or text:find("waterbomb",1,true)
            or text:find("bubbleprojectile",1,true) then return "Projétil de água","projectile",15 end
        if text:find("hurricane",1,true) or text:find("tornado",1,true)
            or text:find("whirlpool",1,true) then return "Redemoinho","area",31 end
        if text:find("tidalwave",1,true) or text:find("shockwave",1,true)
            or text:find("airwave",1,true) then return "Onda de choque","area",33 end
        if text:find("tailwhip",1,true) or text:find("tailattack",1,true) then return "Golpe de cauda","attack",29 end
        if text:find("leapgrab",1,true) or text:find("bite",1,true)
            or text:find("grab",1,true) then return "Mordida / agarrão","attack",24 end
        if text:find("roar",1,true) or text:find("dive",1,true)
            or text:find("slam",1,true) then return "Ataque em área","attack",33 end
        if text:find("dangerzone",1,true) or text:find("telegraph",1,true)
            or text:find("warning",1,true) then return "Área de perigo","area",33 end
        return nil
    end
    local function planar(a,b)
        return (Vector2.new(a.X,a.Z)-Vector2.new(b.X,b.Z)).Magnitude
    end
    local function hazard(m,root,hum,head)
        local previous=S.lastHealth
        S.lastHealth=hum.Health
        if previous and hum.Health<previous-math.max(6,hum.MaxHealth*.025) then
            return {reason="Dano recebido",center=head,radius=31,kind="hit",token="hit:"..tostring(math.floor(os.clock()*2))}
        end
        if (root.Position-head).Magnitude>265 then S.cachedThreat=nil;return nil end
        local now=os.clock()
        if now<S.nextThreatScan then return S.cachedThreat end
        S.nextThreatScan=now+.12
        local danger,score=nil,math.huge
        local ignored=workspace:FindFirstChild("IgnoreList")
        local temp=ignored and ignored:FindFirstChild("Temp")
        if temp then
            for _,obj in ipairs(temp:GetChildren()) do
                local name,kind,radius=hazardClass(obj.Name)
                if name and (kind=="projectile" or kind=="area") then
                    local pos,part
                    if obj:IsA("BasePart") then pos=obj.Position;part=obj
                    elseif obj:IsA("Model") then
                        pos=obj:GetPivot().Position
                        part=obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart",true)
                    end
                    if pos and (pos-head).Magnitude<235 then
                        if part then radius=math.max(radius,math.min(58,math.max(part.Size.X,part.Size.Z)*.5)) end
                        local predicted=pos
                        local velocity=part and part.AssemblyLinearVelocity or Vector3.zero
                        if kind=="projectile" and velocity.Magnitude>8 then
                            local approach=(root.Position-pos):Dot(velocity)/velocity:Dot(velocity)
                            predicted=pos+velocity*math.clamp(approach,0,.75)
                        end
                        local h=planar(predicted,root.Position)
                        if h<radius+13 and math.abs(predicted.Y-root.Position.Y)<math.max(radius+16,33) then
                            local urgency=h/math.max(radius,1)
                            if urgency<score then
                                score=urgency
                                danger={reason=name,center=predicted,radius=radius,kind=kind,token=obj}
                            end
                        end
                    end
                end
            end
        end
        if not danger then
            local signal=m:GetAttribute("CurrentSkill") or m:GetAttribute("Skill") or m:GetAttribute("Action")
            local reason,kind,radius=hazardClass(signal)
            if reason and planar(head,root.Position)<radius+26 then
                danger={reason=reason,center=head,radius=radius,kind=kind,token="skill:"..tostring(signal)}
            end
        end
        if not danger then
            local animator=m:FindFirstChildWhichIsA("Animator",true)
            if animator and planar(head,root.Position)<78 then
                for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
                    local descriptor=tostring(track.Name).." "..tostring(track.Animation and track.Animation.Name or "")
                    local reason,kind,radius=hazardClass(descriptor)
                    if reason then
                        danger={reason=reason,center=head,radius=radius,kind=kind,token=track}
                        break
                    end
                end
            end
        end
        S.cachedThreat=danger
        return danger
    end
    local function chooseDodge(root,head,threat)
        local danger=threat.center
        local away=Vector3.new(root.Position.X-danger.X,0,root.Position.Z-danger.Z)
        if away.Magnitude<.75 then
            away=Vector3.new(root.Position.X-head.X,0,root.Position.Z-head.Z)
        end
        if away.Magnitude<.75 then away=Vector3.new(1,0,0) end
        away=away.Unit
        local side=Vector3.new(-away.Z,0,away.X)
        local currentDist=planar(root.Position,danger)
        local step=math.clamp(threat.radius+17-currentDist,20,53)
        local vectors={away,side,-side,(away+side).Unit,(away-side).Unit}
        local best,bestScore=nil,-math.huge
        for _,dir in ipairs(vectors) do
            local pt=root.Position+dir*step+Vector3.new(0,threat.kind=="area" and 9 or 4,0)
            local safety=planar(pt,danger)
            local headDistance=planar(pt,head)
            local score=safety-headDistance*.32
            if safety<threat.radius+7 then score-=120 end
            if score>bestScore then best,bestScore=pt,score end
        end
        return best
    end
    local function skillUse(tool)
        if not S.skills then
            local mods=RS:FindFirstChild("Modules")
            local combat=mods and mods:FindFirstChild("Combat")
            local ability=combat and combat:FindFirstChild("AbilitySystem")
            local client=ability and ability:FindFirstChild("AbilitySystem Client")
            local module=client and client:FindFirstChild("SkillsSystem Client")
            if module then
                local ok,r=pcall(require,module)
                if ok and type(r)=="table" then S.skills=r end
            end
        end
        local skills=S.skills
        if not skills or not skills.SkillUI or type(skills.SkillUI.RequestMobile)~="function" then return end
        local keys={"Z","X","C","V","F"}
        for i=1,#keys do
            S.skillIndex=S.skillIndex%#keys+1
            local key=keys[S.skillIndex]
            local exists=true
            if skills.Skills and type(skills.Skills.GetByKey)=="function" then
                local ok,skill=pcall(function() return skills.Skills:GetByKey(tool.Name,key) end)
                exists=ok and skill~=nil
            end
            if exists then
                local ok=pcall(function() skills.SkillUI.RequestMobile(key) end)
                if ok then S.attack="Skill "..key;return end
            end
        end
    end
    local function tick()
        scan()
        draw()
        if State.AutoRaid or os.clock()<(FeatureState.islandUntil or 0) then return end
        if not State.AutoSeaBeast then
            if S.target then S.target=nil; S.status="Desligado" end
            return
        end
        if emTransicao() or FeatureState.pescandoAgora then
            S.status="Aguardando transição ou pesca"
            return
        end
        local char,root,hum=character()
        if not root or not hum or hum.Health<=0 then S.status="Personagem indisponível";return end
        local boss=choose(root)
        if not boss then
            S.target=nil
            local pos=eventPosition()
            if pos then
                S.status="Indo ao evento Sea Beast"
                if (root.Position-pos).Magnitude>110 then definirDestino(pos+Vector3.new(0,35,0),"SeaEvent")
                elseif rota and rota.chave=="SeaEvent" then liberarVoo() end
            else
                S.status="Aguardando Sea Beast aparecer"
                if rota and type(rota.chave)=="string" and rota.chave:sub(1,3)=="Sea" then liberarVoo() end
            end
            return
        end
        if S.target~=boss then
            S.lastHealth=nil
            S.cachedThreat=nil
            S.nextThreatScan=0
            S.lastThreatToken=nil
        end
        S.target=boss
        local bp=alive(boss)
        if not bp then return end
        local delta=root.Position-bp.Position
        local flat=Vector3.new(delta.X,0,delta.Z)
        if flat.Magnitude<.1 then flat=Vector3.new(1,0,0) end
        local dist=delta.Magnitude
        local head=headPosition(boss,bp)
        local now=os.clock()
        local threat=hazard(boss,root,hum,head)
        if threat and now-S.lastDodge>0.68
            and (S.lastThreatToken~=threat.token or now-S.lastDodge>2.4) then
            S.lastDodge=now
            S.lastThreatToken=threat.token
            S.dodgeUntil=now+(threat.kind=="projectile" and .55 or .75)
            S.threat=threat.reason
            S.dodgePoint=chooseDodge(root,head,threat)
            S.dodges+=1
            if rota and rota.chave=="SeaBoss" then liberarVoo() end
        end
        if now<S.dodgeUntil and S.dodgePoint then
            S.status="Desviando: "..S.threat
            definirDestino(S.dodgePoint,"SeaDodge")
            if (root.Position-S.dodgePoint).Magnitude<5 then
                S.dodgeUntil=math.min(S.dodgeUntil,now+.12)
            end
            return
        end
        local headVelocity=bp.AssemblyLinearVelocity*0.025
        if headVelocity.Magnitude>1.5 then headVelocity=headVelocity.Unit*1.5 end
        local goal=head+Vector3.new(0,0.45,0)+headVelocity
        local oceanHeight=getOceanHeight(root.Position)
        local diving=false
        if oceanHeight and (root.Position-head).Magnitude<170 then
            diving=head.Y<oceanHeight-2.5
            local safeHeight=oceanHeight+1.65
            if goal.Y<safeHeight then
                goal=Vector3.new(goal.X,safeHeight,goal.Z)
            end
            S.waterStatus=diving and "Sea Beast mergulhado" or
                (head.Y<oceanHeight+1.5 and "Seguindo superfície das ondas" or "Cabeça acima da água")
        end
        local headDistance=(root.Position-head).Magnitude
        if diving then
            S.status="Aguardando Sea Beast subir da água"
        else
            S.status=(root.Position-goal).Magnitude>1.6 and
                ("Aproximando suavemente: "..tostring(kind(boss))) or
                ("Encostado na cabeça: "..tostring(kind(boss)))
        end
        definirDestino(goal,"SeaBoss")
        local tool=equiparArma()
        if not tool then S.attack="Tool não encontrada";return end
        if not diving and headDistance<9 and os.clock()-S.m1>.035 then
            S.m1=os.clock()
            local face=Vector3.new(head.X-root.Position.X,0,head.Z-root.Position.Z)
            if face.Magnitude>0.15 then
                pcall(function() root.CFrame=CFrame.lookAt(root.Position,root.Position+face) end)
            end
            pcall(function() tool:Activate() end)
            S.attack="M1 na cabeça "..tool.Name
        elseif headDistance>=9 then
            S.attack="Aproximando para M1 ("..math.floor(headDistance).." studs)"
        end
        if not diving and headDistance<80 and os.clock()-S.skill>.95 then
            S.skill=os.clock()
            pcall(skillUse,tool)
        end
    end
    FeatureState.seaApproachSpeed=230
    function S.setApproachSpeed(v)
