            local utils=swim and swim:FindFirstChild("Utils")
            if utils and utils:IsA("ModuleScript") then
                local ok,obj=pcall(require,utils)
                if ok and type(obj)=="table" and type(obj.GetOceanHeight)=="function" then
                    S.oceanUtils=obj
                end
            end
        end
        if not S.oceanUtils then
            S.oceanHeight=nil
            S.waterStatus="Utilitário de ondas não encontrado"
            return nil
        end
        local ok,value=pcall(S.oceanUtils.GetOceanHeight,CFrame.new(pos))
