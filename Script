    local equipada=char:FindFirstChildWhichIsA("Tool")
    if equipada and tipoRealTool(equipada)==FeatureState.tipoToolSelecionado then
        return equipada
    end
    local bp=player:FindFirstChild("Backpack")
    local escolhida
    if bp then
        for _,item in ipairs(bp:GetChildren()) do
