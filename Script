local function escolherStat(v)
    if type(v)=="table" then v=v.Name or v.Value end
    if type(v)~="string" then return end
    for _,nome in ipairs(STATS_NAMES) do
        if v==nome then statSelecionado=v;ultimoUpgradeStats=0;return end
