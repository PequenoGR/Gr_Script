    local function currentObjective(quest,data)
        local infos=mainModulo and mainModulo.QuestsInfo
        local info=infos and infos[quest]
        local current=data and data.Quests and data.Quests.Actives
        local raw=current and current[quest]
        if info and type(info.SubQuests)=="table" and type(raw)=="table" then
            for stageIndex,stage in ipairs(info.SubQuests) do
                local values=raw[stageIndex]
                if type(values)=="table" then
                    local stageDone=true
                    for objectiveIndex,item in ipairs(stage.Objectives or {}) do
                        local count=tonumber(values[objectiveIndex]) or 0
                        if count<(tonumber(item.Goal) or 1) then
                            local valid=true
                            if type(item.Validate)=="function" then
                                local ok,res=pcall(item.Validate,player)
                                valid=ok and res~=false
                            end
                            if valid then
                                V.objectiveProgress=count
                                V.objectiveGoal=tonumber(item.Goal) or 1
                                V.objectiveStage=stageIndex
                                return item.ObjectiveID
                            end
                            stageDone=false
                        end
                    end
                    if not stageDone then break end
                end
            end
        end
        local progress=getProgress()
        local activeIds=progress and progress.ObjectiveIds or {}
        local sequence=objectiveOrder[quest]
        if not sequence then return nil end
        for _,id in ipairs(sequence) do
            if activeIds[id]~=nil or objectiveActive(id) then
                V.objectiveProgress=nil
                V.objectiveGoal=tonumber(activeIds[id])
                return id
            end
        end
        return nil
    end
    local lastSkullTrip=-100
