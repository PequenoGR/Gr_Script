    local hakiLastBroadScan=-100
    local hakiExtraTargets={}
    local function findHakiEnemy(name,root)
        reindexar()
        local wanted=normalizar(name)
        local closest,dist,found=nil,math.huge,0
        local used={}
        local function matchEnemy(e)
            local values={
                e.Name,e:GetAttribute("AlternativeName"),
                e:GetAttribute("EnemyName"),e:GetAttribute("OriginalName"),
                e:GetAttribute("MobName"),e:GetAttribute("DisplayName")
            }
            for _,value in pairs(values) do
                local normalized=normalizar(value)
                if normalized==wanted or normalized==wanted.."history"
                    or normalized=="history"..wanted then
                    return true
                end
            end
            return false
        end
        local function include(e)
            if not e or used[e] or not e:IsA("Model") then return end
            used[e]=true
            if matchEnemy(e) and valido(e) then
                local er=rootInimigo(e)
                if er then
                    found+=1
                    local distance=(root.Position-er.Position).Magnitude
                    if distance<dist then closest=e;dist=distance end
                end
            end
        end
        for _,e in ipairs(indexInimigos) do include(e) end
        if os.clock()-hakiLastBroadScan>2 then
            hakiLastBroadScan=os.clock()
            table.clear(hakiExtraTargets)
            local play=workspace:FindFirstChild("Playability")
            local ignore=workspace:FindFirstChild("IgnoreList")
            local int=ignore and ignore:FindFirstChild("Int")
            for _,scope in ipairs({play or false,int or false,ignore or false}) do
                if scope then
                    for _,inst in ipairs(scope:GetDescendants()) do
                        if inst:IsA("Model") and matchEnemy(inst) then
                            table.insert(hakiExtraTargets,inst)
                        end
                    end
                end
            end
        end
        for _,e in ipairs(hakiExtraTargets) do include(e) end
        V.hakiEnemyCount=found
        V.hakiEnemyTarget=closest and closest.Name or nil
        V.hakiEnemyDistance=closest and math.floor(dist) or nil
        return closest
    end
    local function autoFight(name,point)
        local _,root,hum=character()
        if not root or not hum or hum.Health<=0 then return end
        local enemy=findHakiEnemy(name,root)
        local enemyRoot=enemy and rootInimigo(enemy)
        if not enemyRoot or not valido(enemy) then
            local spawn=point or pontoGrupoInimigo(name,root)
            if typeof(spawn)=="Vector3" then
                moveHakiTo(spawn,6,"procurando "..name.." na área de spawn")
            else
