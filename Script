    local function selectBoss(root)
        scan(false)
        local best,dist=nil,math.huge
        if B.target and valid(B.target)
            and (B.chosen=="Mais próximo" or bossName(B.target)==B.chosen) then
            local oldRoot=enemyRoot(B.target)
            if oldRoot then best=B.target;dist=(root.Position-oldRoot.Position).Magnitude end
        end
        for _,candidate in ipairs(B.list) do
            local targetRoot=valid(candidate)
            if targetRoot and (B.chosen=="Mais próximo" or bossName(candidate)==B.chosen) then
                local d=(root.Position-targetRoot.Position).Magnitude
                if d<dist-15 or not best then best=candidate;dist=d end
            end
        end
        return best
    end


    local function planar(p,q)
        local dx=p.X-q.X
        local dz=p.Z-q.Z
        return math.sqrt(dx*dx+dz*dz)
    end
    local function profile()
        if B.dodgeMode=="Agressivo" then
            return {margin=5,steps={22,34,48,64},speed=680,interval=.36,attackRadius=6}
        elseif B.dodgeMode=="Defensivo" then
            return {margin=11,steps={38,55,75,100},speed=820,interval=.28,attackRadius=11}
        end
        return {margin=8,steps={28,42,60,80},speed=740,interval=.33,attackRadius=8}
    end
    function B.setDodgeMode(v)
