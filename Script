    end
    local function remote(cmd,arg)
        if not dadosModulo or not dadosModulo.Network then return false end
        return pcall(function()
            if arg==nil then dadosModulo.Network:FireServer("FortRaid",cmd)
            else dadosModulo.Network:FireServer("FortRaid",cmd,arg) end
        end)
