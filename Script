                    local mark=Instance.new("Highlight")
                    mark.Name="GR_SeaBeastESP"
                    mark.Adornee=m
                    mark.FillTransparency=.82
                    mark.OutlineTransparency=0
                    mark.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                    mark.FillColor=entry.kind=="Ancestral" and Color3.fromRGB(170,70,240) or Color3.fromRGB(35,180,235)
                    mark.OutlineColor=entry.kind=="Ancestral" and Color3.fromRGB(225,140,255) or Color3.fromRGB(115,235,255)
                    mark.Parent=m
                    local gui=Instance.new("BillboardGui")
                    gui.Name="GR_SeaLabel"
                    gui.Size=UDim2.fromOffset(190,43)
                    gui.StudsOffsetWorldSpace=Vector3.new(0,18,0)
                    gui.AlwaysOnTop=true
                    gui.Adornee=p
                    gui.Parent=p
                    local lab=Instance.new("TextLabel")
                    lab.Name="Text"
                    lab.Size=UDim2.fromScale(1,1)
                    lab.BackgroundColor3=Color3.fromRGB(15,15,20)
                    lab.BackgroundTransparency=.2
                    lab.TextColor3=Color3.fromRGB(240,240,240)
                    lab.TextStrokeTransparency=.7
                    lab.TextScaled=true
                    lab.Font=Enum.Font.GothamBold
                    lab.Parent=gui
                    local corner=Instance.new("UICorner")
                    corner.CornerRadius=UDim.new(0,7)
                    corner.Parent=lab
                    a={mark,gui}
                    S.marks[m]=a
                end
                if a[2] then
                    a[2].Adornee=p
                    local lab=a[2]:FindFirstChild("Text")
                    if lab then
                        local dist=root and math.floor((root.Position-p.Position).Magnitude) or 0
                        lab.Text=(entry.kind=="Ancestral" and "ANCESTRAL SEA BEAST" or "SEA BEAST").."\n"..dist.." studs"
                    end
                end
            end
        end
        for m in pairs(S.marks) do if not seen[m] then clearMark(m) end end
        local pos=eventPosition()
        if pos then
            if not S.eventPart then
                local anchor=Instance.new("Part")
                anchor.Name="GR_SeaEventMarker"
                anchor.Anchored=true
                anchor.CanCollide=false
                anchor.CanTouch=false
                anchor.CanQuery=false
                anchor.Transparency=1
                anchor.Size=Vector3.one
                anchor.Parent=workspace
                local gui=Instance.new("BillboardGui")
                gui.Size=UDim2.fromOffset(210,35)
                gui.AlwaysOnTop=true
                gui.StudsOffsetWorldSpace=Vector3.new(0,12,0)
                gui.Parent=anchor
                local t=Instance.new("TextLabel")
                t.Size=UDim2.fromScale(1,1)
                t.BackgroundColor3=Color3.fromRGB(25,25,25)
                t.BackgroundTransparency=.25
                t.TextColor3=Color3.fromRGB(255,225,100)
                t.Font=Enum.Font.GothamBold
                t.TextScaled=true
                t.Text="SEA BEAST EVENT"
                t.Parent=gui
                S.eventPart=anchor
            end
            S.eventPart.Position=pos
        elseif S.eventPart then
            S.eventPart:Destroy()
            S.eventPart=nil
        end
    end
    local function choose(root)
        local closest,dist
        dist=math.huge
        for _,entry in ipairs(S.list) do
            if (S.mode=="Todos" or entry.kind==S.mode) then
                local p=alive(entry.model)
                if p then
                    local d=(p.Position-root.Position).Magnitude
                    if d<dist then closest=entry.model;dist=d end
                end
            end
        end
        return closest
    end
    local function hazardClass(label)
        local text=tostring(label or ""):lower()
        if text:find("waterprojectile",1,true) or text:find("waterbomb",1,true)
            or text:find("bubbleprojectile",1,true) then return "Projétil de água","projectile",15 end
        if text:find("hurricane",1,true) or text:find("tornado",1,true)
            or text:find("whirlpool",1,true) then return "Redemoinho","area",31 end
        if text:find("tidalwave",1,true) or text:find("shockwave",1,true)
            or text:find("airwave",1,true) then return "Onda de choque","area",33 end
        if text:find("tailwhip",1,true) or text:find("tailattack",1,true) then return "Golpe de cauda","attack",29 end
        if text:find("leapgrab",1,true) or text:find("bite",1,true)
            or text:find("grab",1,true) then return "Mordida / agarrão","attack",24 end
        if text:find("roar",1,true) or text:find("dive",1,true)
            or text:find("slam",1,true) then return "Ataque em área","attack",33 end
        if text:find("dangerzone",1,true) or text:find("telegraph",1,true)
            or text:find("warning",1,true) then return "Área de perigo","area",33 end
        return nil
    end
    local function planar(a,b)
        return (Vector2.new(a.X,a.Z)-Vector2.new(b.X,b.Z)).Magnitude
    end
    local function hazard(m,root,hum,head)
        local previous=S.lastHealth
        S.lastHealth=hum.Health
        if previous and hum.Health<previous-math.max(6,hum.MaxHealth*.025) then
            return {reason="Dano recebido",center=head,radius=31,kind="hit",token="hit:"..tostring(math.floor(os.clock()*2))}
        end
        if (root.Position-head).Magnitude>265 then S.cachedThreat=nil;return nil end
        local now=os.clock()
        if now<S.nextThreatScan then return S.cachedThreat end
        S.nextThreatScan=now+.12
        local danger,score=nil,math.huge
        local ignored=workspace:FindFirstChild("IgnoreList")
        local temp=ignored and ignored:FindFirstChild("Temp")
        if temp then
            for _,obj in ipairs(temp:GetChildren()) do
                local name,kind,radius=hazardClass(obj.Name)
                if name and (kind=="projectile" or kind=="area") then
                    local pos,part
                    if obj:IsA("BasePart") then pos=obj.Position;part=obj
                    elseif obj:IsA("Model") then
                        pos=obj:GetPivot().Position
                        part=obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart",true)
                    end
                    if pos and (pos-head).Magnitude<235 then
                        if part then radius=math.max(radius,math.min(58,math.max(part.Size.X,part.Size.Z)*.5)) end
                        local predicted=pos
                        local velocity=part and part.AssemblyLinearVelocity or Vector3.zero
                        if kind=="projectile" and velocity.Magnitude>8 then
                            local approach=(root.Position-pos):Dot(velocity)/velocity:Dot(velocity)
                            predicted=pos+velocity*math.clamp(approach,0,.75)
                        end
                        local h=planar(predicted,root.Position)
                        if h<radius+13 and math.abs(predicted.Y-root.Position.Y)<math.max(radius+16,33) then
                            local urgency=h/math.max(radius,1)
                            if urgency<score then
                                score=urgency
                                danger={reason=name,center=predicted,radius=radius,kind=kind,token=obj}
                            end
                        end
                    end
                end
            end
        end
        if not danger then
            local signal=m:GetAttribute("CurrentSkill") or m:GetAttribute("Skill") or m:GetAttribute("Action")
            local reason,kind,radius=hazardClass(signal)
            if reason and planar(head,root.Position)<radius+26 then
                danger={reason=reason,center=head,radius=radius,kind=kind,token="skill:"..tostring(signal)}
            end
        end
        if not danger then
            local animator=m:FindFirstChildWhichIsA("Animator",true)
            if animator and planar(head,root.Position)<78 then
                for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
                    local descriptor=tostring(track.Name).." "..tostring(track.Animation and track.Animation.Name or "")
                    local reason,kind,radius=hazardClass(descriptor)
                    if reason then
                        danger={reason=reason,center=head,radius=radius,kind=kind,token=track}
                        break
                    end
                end
            end
        end
        S.cachedThreat=danger
        return danger
    end
    local function chooseDodge(root,head,threat)
        local danger=threat.center
        local away=Vector3.new(root.Position.X-danger.X,0,root.Position.Z-danger.Z)
        if away.Magnitude<.75 then
            away=Vector3.new(root.Position.X-head.X,0,root.Position.Z-head.Z)
        end
        if away.Magnitude<.75 then away=Vector3.new(1,0,0) end
        away=away.Unit
        local side=Vector3.new(-away.Z,0,away.X)
        local currentDist=planar(root.Position,danger)
        local step=math.clamp(threat.radius+17-currentDist,20,53)
        local vectors={away,side,-side,(away+side).Unit,(away-side).Unit}
        local best,bestScore=nil,-math.huge
        for _,dir in ipairs(vectors) do
            local pt=root.Position+dir*step+Vector3.new(0,threat.kind=="area" and 9 or 4,0)
            local safety=planar(pt,danger)
            local headDistance=planar(pt,head)
            local score=safety-headDistance*.32
            if safety<threat.radius+7 then score-=120 end
            if score>bestScore then best,bestScore=pt,score end
        end
        return best
    end
    local function skillUse(tool)
        if not S.skills then
            local mods=RS:FindFirstChild("Modules")
            local combat=mods and mods:FindFirstChild("Combat")
            local ability=combat and combat:FindFirstChild("AbilitySystem")
            local client=ability and ability:FindFirstChild("AbilitySystem Client")
            local module=client and client:FindFirstChild("SkillsSystem Client")
            if module then
                local ok,r=pcall(require,module)
                if ok and type(r)=="table" then S.skills=r end
            end
        end
        local skills=S.skills
        if not skills or not skills.SkillUI or type(skills.SkillUI.RequestMobile)~="function" then return end
        local keys={"Z","X","C","V","F"}
        for i=1,#keys do
            S.skillIndex=S.skillIndex%#keys+1
            local key=keys[S.skillIndex]
            local exists=true
            if skills.Skills and type(skills.Skills.GetByKey)=="function" then
                local ok,skill=pcall(function() return skills.Skills:GetByKey(tool.Name,key) end)
                exists=ok and skill~=nil
            end
            if exists then
                local ok=pcall(function() skills.SkillUI.RequestMobile(key) end)
                if ok then S.attack="Skill "..key;return end
            end
        end
    end
    local function tick()
        scan()
        draw()
        if State.AutoRaid or os.clock()<(FeatureState.islandUntil or 0) then return end
        if not State.AutoSeaBeast then
            if S.target then S.target=nil; S.status="Desligado" end
            return
        end
        if emTransicao() or FeatureState.pescandoAgora then
            S.status="Aguardando transição ou pesca"
            return
        end
        local char,root,hum=character()
        if not root or not hum or hum.Health<=0 then S.status="Personagem indisponível";return end
        local boss=choose(root)
        if not boss then
            S.target=nil
            local pos=eventPosition()
            if pos then
                S.status="Indo ao evento Sea Beast"
                if (root.Position-pos).Magnitude>110 then definirDestino(pos+Vector3.new(0,35,0),"SeaEvent")
                elseif rota and rota.chave=="SeaEvent" then liberarVoo() end
            else
                S.status="Aguardando Sea Beast aparecer"
                if rota and type(rota.chave)=="string" and rota.chave:sub(1,3)=="Sea" then liberarVoo() end
            end
            return
        end
        if S.target~=boss then
            S.lastHealth=nil
            S.cachedThreat=nil
            S.nextThreatScan=0
            S.lastThreatToken=nil
        end
        S.target=boss
        local bp=alive(boss)
        if not bp then return end
        local delta=root.Position-bp.Position
        local flat=Vector3.new(delta.X,0,delta.Z)
        if flat.Magnitude<.1 then flat=Vector3.new(1,0,0) end
        local dist=delta.Magnitude
        local head=headPosition(boss,bp)
        local now=os.clock()
        local threat=hazard(boss,root,hum,head)
        if threat and now-S.lastDodge>0.68
            and (S.lastThreatToken~=threat.token or now-S.lastDodge>2.4) then
            S.lastDodge=now
            S.lastThreatToken=threat.token
            S.dodgeUntil=now+(threat.kind=="projectile" and .55 or .75)
            S.threat=threat.reason
            S.dodgePoint=chooseDodge(root,head,threat)
            S.dodges+=1
            if rota and rota.chave=="SeaBoss" then liberarVoo() end
        end
        if now<S.dodgeUntil and S.dodgePoint then
            S.status="Desviando: "..S.threat
            definirDestino(S.dodgePoint,"SeaDodge")
            if (root.Position-S.dodgePoint).Magnitude<5 then
                S.dodgeUntil=math.min(S.dodgeUntil,now+.12)
            end
            return
        end
        local outward=head-bp.Position
        local towardFront=Vector3.new(outward.X,0,outward.Z)
        if towardFront.Magnitude<.5 then
            local forward=bp.CFrame.LookVector
            towardFront=Vector3.new(forward.X,0,forward.Z)
        end
        if towardFront.Magnitude<.1 then towardFront=Vector3.new(1,0,0) end
        local advance=bp.AssemblyLinearVelocity*0.1
        if advance.Magnitude>7 then advance=advance.Unit*7 end
        local goal=head+towardFront.Unit*7+Vector3.new(0,2.5,0)+advance
        local headDistance=(root.Position-head).Magnitude
        S.status=(root.Position-goal).Magnitude>6 and ("Aproximando da cabeça: "..tostring(kind(boss))) or ("Atacando perto da cabeça: "..tostring(kind(boss)))
        definirDestino(goal,"SeaBoss")
        if rota and rota.chave=="SeaBoss" and headDistance>30 and dist<380 then
            rota.cruzeiro=math.max(root.Position.Y,goal.Y)+4
        end
        local tool=equiparArma()
        if not tool then S.attack="Tool não encontrada";return end
        if headDistance<13 and os.clock()-S.m1>.08 then
            S.m1=os.clock()
            local face=Vector3.new(head.X-root.Position.X,0,head.Z-root.Position.Z)
            if face.Magnitude>0.15 then
                pcall(function() root.CFrame=CFrame.lookAt(root.Position,root.Position+face) end)
            end
            pcall(function() tool:Activate() end)
            S.attack="M1 na cabeça "..tool.Name
        elseif headDistance>=13 then
            S.attack="Aproximando para M1 ("..math.floor(headDistance).." studs)"
        end
        if headDistance<80 and os.clock()-S.skill>.95 then
            S.skill=os.clock()
            pcall(skillUse,tool)
        end
    end
    function S.setMode(v)
        if type(v)=="table" then v=v.Name or v.Value or v.Valor end
        if v=="Todos" or v=="Normal" or v=="Ancestral" then S.mode=v end
    end
    function S.setAuto(v)
        State.AutoSeaBeast=(v==true)
        if State.AutoSeaBeast then
            finalizarTentativaFruta(false,0)
            S.lastHealth=nil
            S.lastThreatToken=nil
            S.cachedThreat=nil
            S.nextThreatScan=0
            S.dodgeUntil=0
            S.dodgePoint=nil
            S.status="Procurando Sea Beast"
            liberarVoo()
        else
            S.status="Desligado"
            S.target=nil
            S.dodgeUntil=0
            S.dodgePoint=nil
            S.cachedThreat=nil
            if rota and type(rota.chave)=="string" and rota.chave:sub(1,3)=="Sea" then liberarVoo() end
        end
    end
    function S.setESP(v)
        State.SeaBeastESP=(v==true)
        S.scanned=0
        if not v then clearESP() end
    end
    function S.cleanup()
        S.dead=true
        State.AutoSeaBeast=false
        State.SeaBeastESP=false
        clearESP()
    end
    env.GRHubSeaCleanup=S.cleanup
    task.spawn(function()
        while running() and not S.dead do
            local ok,err=pcall(tick)
            if not ok then
                S.status="Erro: "..tostring(err)
                if os.clock()-(S.lastError or 0)>5 then
                    S.lastError=os.clock()
                    warn("[GR Hub Sea]",err)
                end
            end
            task.wait(State.AutoSeaBeast and .045 or State.SeaBeastESP and .4 or 1)
        end
        S.cleanup()
    end)
    return S
end)()



local Raid = (function()
    State.AutoRaid=false
    local R={status="Desligado",state="-",fort="-",wave=0,waves=0,enemy=nil,chests={},retry={},skills=nil,lastSkill=0,skillIndex=0,lastM1=0,lastScan=0,lastVault=0,lastChests=0,lastChest=0,cache={},cacheFort=nil,dead=false,connection=nil,lastError=0,dodgeUntil=0,dodgePos=nil,lastDodge=0,dodgeReason="-",lastHP=nil,dodges=0,m1Count=0,skillCount=0,lastBoss=nil}
    local function area()
        local map=workspace:FindFirstChild("Map")
        local areas=map and map:FindFirstChild("Areas")
        return areas and areas:FindFirstChild("Marine Forts")
    end
    local function fortInfo()
        local a=area()
        return a,a and a:GetAttribute("ActivePosition"),a and a:GetAttribute("RaidState"),a and a:GetAttribute("ActiveFort")
    end
    local function remote(cmd,arg)
        if not dadosModulo or not dadosModulo.Network then return false end
        return pcall(function()
            if arg==nil then dadosModulo.Network:FireServer("FortRaid",cmd)
            else dadosModulo.Network:FireServer("FortRaid",cmd,arg) end
        end)
    end
    local function enemyRoot(model)
        if not model or not model:IsA("Model") or not model.Parent then return nil end
        local root=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("HumanoidRootPart",true)
        if not root or not root:IsA("BasePart") then return nil end
        local hum=model:FindFirstChildWhichIsA("Humanoid",true)
        if hum and hum.Health<=0 then return nil end
        local health=model:GetAttribute("HandlerHealth")
        if type(health)=="number" and health<=0 then return nil end
        return root
    end
    local function raidEnemy(model)
        local names={model.Name,model:GetAttribute("OriginalName"),model:GetAttribute("EnemyName"),model:GetAttribute("AlternativeName"),model:GetAttribute("DisplayName")}
        local title=tostring(model:GetAttribute("Title") or ""):lower()
        if title=="marine fort" or title=="marine fort commander" then return true end
        for _,name in pairs(names) do
            if type(name)=="string" then
                local n=name:lower()
                if n:find("fort marine",1,true) or n:find("fort commander",1,true) or n:find("marine swordsman",1,true)
                or n:find("marine duelist",1,true) or n:find("marine gunner",1,true) or n:find("commodore garrick",1,true) then return true end
            end
        end
        return false
    end
    local function scan(center)
        if os.clock()-R.lastScan<1.2 then return end
        R.lastScan=os.clock()
        local found,seen={},{}
        local play=workspace:FindFirstChild("Playability")
        local ignore=workspace:FindFirstChild("IgnoreList")
        local inside=ignore and ignore:FindFirstChild("Int")
        local sources={}
        if play then table.insert(sources,play) end
        if inside then table.insert(sources,inside) end
        if ignore then
            local folder=ignore:FindFirstChild("Enemys") or ignore:FindFirstChild("Enemies")
            if folder then table.insert(sources,folder) end
        end
        for _,src in ipairs(sources) do
            for _,model in ipairs(src:GetDescendants()) do
                if model:IsA("Model") and not seen[model] then
                    seen[model]=true
                    if raidEnemy(model) then
                        local root=enemyRoot(model)
                        if root and (root.Position-center).Magnitude<850 then table.insert(found,model) end
                    end
                end
            end
        end
        R.cache=found
    end
    local function isCommander(model)
        if not model then return false end
        local text=(tostring(model.Name).." "..tostring(model:GetAttribute("AlternativeName") or "").." "..tostring(model:GetAttribute("Title") or "")):lower()
        return text:find("commodore garrick",1,true)~=nil or text:find("fort commander",1,true)~=nil
    end
    local function closest(center,root)
        scan(center)
        local best,distance=nil,math.huge
        for _,model in ipairs(R.cache) do
            local e=enemyRoot(model)
            if e and (e.Position-center).Magnitude<850 then
                local d=(e.Position-root.Position).Magnitude
                if R.wave>=R.waves and R.waves>0 and isCommander(model) then d-=500 end
                if d<distance then distance=d;best=model end
            end
        end
        return best
    end
    local function approach(root,point,key,radius)
        if key=="RaidEnemy" then
            definirDestino(point,key)
            return (root.Position-point).Magnitude<=radius
        end
        if (root.Position-point).Magnitude>radius then definirDestino(point,key);return false end
        if rota and rota.chave==key then liberarVoo() end
        return true
    end
    local function ability()
        if R.skills then return R.skills end
        local mods=RS:FindFirstChild("Modules")
        local combat=mods and mods:FindFirstChild("Combat")
        local sys=combat and combat:FindFirstChild("AbilitySystem")
        local client=sys and sys:FindFirstChild("AbilitySystem Client")
        local module=client and client:FindFirstChild("SkillsSystem Client")
        if module then
            local ok,obj=pcall(require,module)
            if ok and type(obj)=="table" then R.skills=obj end
        end
        return R.skills
    end
    local function warning(root,bossRoot)
        local cam=workspace.CurrentCamera
        local folder=cam and cam:FindFirstChild("BossTelegraphs")
        if not folder or not bossRoot then return nil end
        if (root.Position-bossRoot.Position).Magnitude>260 then return nil end
        for _,part in ipairs(folder:GetDescendants()) do
            if part:IsA("BasePart") and part.Name=="Telegraph"
                and (part.Position-bossRoot.Position).Magnitude<280
                and (root.Position.Y-part.Position.Y)<55
                and (root.Position.Y-part.Position.Y)>-18 then
                local danger=false
                local radius=0
                if part.Shape==Enum.PartType.Cylinder then
                    radius=math.max(part.Size.Y,part.Size.Z)*.5
                    local dx=root.Position.X-part.Position.X
                    local dz=root.Position.Z-part.Position.Z
                    danger=(dx*dx+dz*dz)<(radius+7)^2
                else
                    local localPos=part.CFrame:PointToObjectSpace(root.Position)
                    danger=math.abs(localPos.X)<part.Size.X*.5+7 and math.abs(localPos.Z)<part.Size.Z*.5+7
                    radius=math.min(80,math.max(part.Size.X,part.Size.Z))
                end
                if danger then
                    local away=Vector3.new(root.Position.X-part.Position.X,0,root.Position.Z-part.Position.Z)
                    if away.Magnitude<1 then
                        if part.Shape~=Enum.PartType.Cylinder and part.Size.Z>part.Size.X then
                            away=part.CFrame.RightVector
                        else
                            away=Vector3.new(root.Position.X-bossRoot.Position.X,0,root.Position.Z-bossRoot.Position.Z)
                        end
                    end
                    if away.Magnitude<.1 then away=Vector3.new(1,0,0) end
                    return "Aviso vermelho do boss",away.Unit,math.clamp(radius+23,42,85)
                end
            end
        end
        return nil
    end
    local function evade(root,why,away,distance)
        local now=os.clock()
        if now-R.lastDodge<1.05 then return false end
        R.lastDodge=now
        R.dodges+=1
        R.dodgeReason=why
        R.dodgeUntil=now+0.95
        local horizontal=Vector3.new(away.X,0,away.Z)
        if horizontal.Magnitude<.1 then horizontal=Vector3.new(1,0,0) end
        R.dodgePos=root.Position+horizontal.Unit*(distance or 50)+Vector3.new(0,9,0)
        liberarVoo()
        return true
    end
    local function attemptSkill(tool)
        if os.clock()-R.lastSkill<1.3 then return end
        local client=ability()
        if not client then return end
        local inputs={"Z","X","C","V","F"}
        local selected
        for _=1,#inputs do
            R.skillIndex=R.skillIndex%#inputs+1
            local key=inputs[R.skillIndex]
            local valid=true
            if client.Skills and type(client.Skills.GetByKey)=="function" then
                local ok,result=pcall(function() return client.Skills:GetByKey(tool.Name,key) end)
                valid=ok and result~=nil
            end
            if valid then selected=key;break end
        end
        if not selected then return end
        R.lastSkill=os.clock()
        local vim
        pcall(function() vim=game:GetService("VirtualInputManager") end)
        if vim then
            local success=pcall(function()
                vim:SendKeyEvent(true,Enum.KeyCode[selected],false,game)
                task.delay(0.11,function()
                    pcall(function() vim:SendKeyEvent(false,Enum.KeyCode[selected],false,game) end)
                end)
            end)
            if success then R.skillCount+=1;return end
        end
        if client.SkillUI and type(client.SkillUI.RequestMobile)=="function" then
            pcall(client.SkillUI.RequestMobile,selected)
        end
    end
    local function attack(model,root)
        R.enemy=model
        local e=enemyRoot(model)
        if not e then return end
        local commander=isCommander(model)
        local now=os.clock()
        if commander then
            local _,_,hum=character()
            local threat,avoid,range=warning(root,e)
            if hum and hum.MaxHealth>0 then
                if R.lastBoss~=model then R.lastHP=hum.Health;R.lastBoss=model end
                if R.lastHP and hum.Health<R.lastHP-math.max(9,hum.MaxHealth*.035) and not threat then
                    threat="Dano do boss"
                    avoid=Vector3.new(root.Position.X-e.Position.X,0,root.Position.Z-e.Position.Z)
                    range=55
                end
                R.lastHP=hum.Health
            end
            if threat and now>=R.dodgeUntil then evade(root,threat,avoid,range) end
        else
            R.lastHP=nil
            R.lastBoss=nil
        end
        if now<R.dodgeUntil and R.dodgePos then
            R.status="Desviando: "..R.dodgeReason
            definirDestino(R.dodgePos,"RaidDodge")
            return
        end
        local forward=e.CFrame.LookVector
        local lateral=Vector3.new(forward.X,0,forward.Z)
        if lateral.Magnitude<.1 then lateral=Vector3.new(0,0,1) end
        local point=e.Position+Vector3.new(0,4,0)-lateral.Unit*1.1
        R.status=(commander and "Boss por cima: " or "Atacando por cima: ")..model.Name
        local aligned=approach(root,point,"RaidEnemy",2.5)
        if rota and rota.chave=="RaidEnemy" and (root.Position-point).Magnitude<30 then
            rota.cruzeiro=math.max(root.Position.Y,point.Y)+2
        end
        if not aligned and (root.Position-point).Magnitude>9 then return end
        local tool=equiparArma()
        if not tool then R.status="Tool selecionada indisponível";return end
        local diff=e.Position-root.Position
        local aim=Vector3.new(diff.X,0,diff.Z)
        if aim.Magnitude>.1 then
            pcall(function() root.CFrame=CFrame.lookAt(root.Position,root.Position+aim) end)
        end
        if (root.Position-e.Position).Magnitude<=12 and os.clock()-R.lastM1>.16 then
            R.lastM1=os.clock()
            local ok=pcall(function() tool:Activate() end)
            if ok then R.m1Count+=1 end
        end
        attemptSkill(tool)
    end
    local function onEvent(action,fort,rarities,opened,positions)
        if R.dead then return end
        if action=="Chests" and type(fort)=="string" and type(rarities)=="table" and type(opened)=="table" and type(positions)=="table" then
            if R.cacheFort~=fort then return end
            local boxes={}
            for id,rarity in ipairs(rarities) do
                local cf=positions[id]
                if opened[id]~=true and typeof(cf)=="CFrame" then boxes[id]={position=cf.Position,rarity=rarity} end
            end
            R.chests=boxes
        elseif action=="ChestOpened" and type(fort)=="number" then
            R.chests[fort]=nil
            R.retry[fort]=nil
        end
    end
    local function loot(a,fort,root)
        if a:GetAttribute("VaultOpened")==false then
            local data=a:FindFirstChild("Data")
            local group=data and data:FindFirstChild(fort)
            local door=group and group:FindFirstChild("BankDoor")
            if not door or not door:IsA("Model") then R.status="Aguardando porta do cofre";return end
            local center=door:GetBoundingBox().Position
            local delta=root.Position-center
            local flat=Vector3.new(delta.X,0,delta.Z)
            if flat.Magnitude<.01 then flat=Vector3.new(1,0,0) end
            local goal=center+flat.Unit*8+Vector3.new(0,2,0)
            if not approach(root,goal,"RaidVault",5) then R.status="Indo ao cofre";return end
            if (root.Position-center).Magnitude<=24 and os.clock()-R.lastVault>2.5 then
                R.lastVault=os.clock()
                if remote("OpenVault") then R.status="Abrindo cofre" end
            end
            return
        end
        if a:GetAttribute("VaultOpened")~=true then R.status="Aguardando cofre";return end
        if os.clock()-R.lastChests>8 then
            R.lastChests=os.clock()
            remote("GetChests")
        end
        local chosen,id,distance=nil,nil,math.huge
        for k,v in pairs(R.chests) do
            if os.clock()>=(R.retry[k] or 0) then
                local d=(root.Position-v.position).Magnitude
                if d<distance then chosen=v;id=k;distance=d end
            end
        end
        if not chosen then
            R.status="Aguardando baús / Raid concluída"
            if rota and type(rota.chave)=="string" and rota.chave:sub(1,4)=="Raid" then liberarVoo() end
            return
        end
        if not approach(root,chosen.position+Vector3.new(0,3,0),"RaidChest",5) then
            R.status="Indo até baú "..id
            return
        end
        if distance<=10 and os.clock()-R.lastChest>1.2 then
            R.lastChest=os.clock()
            R.retry[id]=os.clock()+2.5
            if remote("OpenChest",id) then R.status="Abrindo baú "..id end
        end
    end
    local function tick()
        if not State.AutoRaid then return end
        if os.clock()<(FeatureState.islandUntil or 0) or emTransicao() then R.status="Aguardando transição";return end
        local a,pos,mode,fort=fortInfo()
        R.state=tostring(mode or "-")
        R.fort=tostring(fort or "-")
        R.wave=a and (tonumber(a:GetAttribute("RaidWave")) or 0) or 0
        R.waves=a and (tonumber(a:GetAttribute("RaidWaves")) or 0) or 0
        if not a or typeof(pos)~="Vector3" or type(fort)~="string" then
            R.status="Aguardando Marine Fort Raid ativa";R.enemy=nil;return
        end
        if mode~="Open" and mode~="Completed" then
            R.status="Raid não disponível: "..tostring(mode);return
        end
        if lerNivel(lerDados())<325 then R.status="Raid exige nível 325+";return end
        if R.cacheFort~=fort then
            R.cacheFort=fort;R.chests={};R.retry={};R.lastChests=0
        end
        local _,root,hum=character()
        if not root or not hum or hum.Health<=0 then R.status="Personagem indisponível";return end
        if mode=="Completed" then R.enemy=nil;loot(a,fort,root);return end
        local enemy=closest(pos,root)
        if enemy then attack(enemy,root);return end
        R.enemy=nil
        R.status=(R.wave>=R.waves and "Aguardando boss" or ("Aguardando onda "..R.wave.."/"..R.waves))
        approach(root,pos+Vector3.new(0,14,0),"RaidFort",55)
    end
    function R.setAuto(v)
        State.AutoRaid=v==true
        if State.AutoRaid then
            R.status="Procurando raid";R.lastScan=0;R.dodgeUntil=0;R.lastHP=nil;FeatureState.frutaOcupada=false;liberarVoo()
        else
            R.status="Desligado";R.dodgeUntil=0;R.lastHP=nil
