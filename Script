        scanned = 0, lastGlobal = 0, m1 = 0, skill = 0,
        skillIndex = 0, lastDodge = 0, dodgeUntil = 0,
        dodgePoint = nil, dodgeSide = 1, lastHealth = nil,
        dodges = 0, nextThreatScan = 0, cachedThreat = nil, lastThreatToken = nil,
        oceanUtils = nil, oceanHeight = nil, lastOceanScan = -20,
        waterStatus = "Aguardando água", followSpeed = 0,
        eventPart = nil, dead = false, skills = nil
    }
    local function kind(m)
        if not m or not m:IsA("Model") then return nil end
        local s = tostring(m.Name).." "..tostring(m:GetAttribute("OriginalName") or "").." "..tostring(m:GetAttribute("EnemyName") or "").." "..tostring(m:GetAttribute("BossName") or "")
        s = s:lower()
        if s:find("ancestral",1,true) and (s:find("sea beast",1,true) or s:find("abyssal beast",1,true)) then return "Ancestral" end
        if s:find("sea beast",1,true) or s:find("abyssal beast",1,true) then return "Normal" end
        return nil
    end
    local function part(m)
        if not m or not m.Parent then return nil end
        local p = m:FindFirstChild("RootPart",true) or m:FindFirstChild("HumanoidRootPart",true) or m.PrimaryPart
        if p and p:IsA("BasePart") then return p end
        return nil
    end
    local function alive(m)
        local p = part(m)
        if not p then return nil end
        local h = m:FindFirstChildWhichIsA("Humanoid",true)
        if h and h.Health <= 0 then return nil end
        local health = m:GetAttribute("Health")
        if type(health)=="number" and health <= 0 then return nil end
        return p
    end
    local function headPosition(m,bp)
        for _,name in ipairs({"Head","HeadHitbox","head","jaw","jaw.002"}) do
            local node=m:FindFirstChild(name,true)
            if node then
                if node:IsA("BasePart") then return node.Position end
                if node:IsA("Attachment") or node:IsA("Bone") then
                    return node.WorldCFrame.Position
                end
                if node:IsA("Model") then return node:GetPivot().Position end
            end
        end
        local cf,size=m:GetBoundingBox()
        if size.Y>0 and size.Y<260 then
            return Vector3.new(bp.Position.X,math.max(bp.Position.Y,cf.Position.Y+size.Y*.34),bp.Position.Z)
        end
        return bp.Position
    end
    local function getOceanHeight(pos)
        if os.clock()-S.lastOceanScan<.25 then return S.oceanHeight end
        S.lastOceanScan=os.clock()
        local ignore=workspace:FindFirstChild("IgnoreList")
        local water=ignore and ignore:FindFirstChild("Water")
        if not water or not water:FindFirstChild("OceanChunks") then
            S.oceanHeight=nil
            S.waterStatus="Oceano não carregado"
