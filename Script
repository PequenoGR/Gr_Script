        local contact=enemyRoot.Position+Vector3.new(0,3.2,0)
        if not moveHakiTo(contact,7,"aproximando do "..name) then return end
        local tool=styleTool()
        if not tool then V.status="Auto Haki: precisa de um Fighting Style equipado";return end
        autoAction("HakiM1",.13,function()
            local flat=Vector3.new(enemyRoot.Position.X-root.Position.X,0,
                enemyRoot.Position.Z-root.Position.Z)
            if flat.Magnitude>.1 then
                root.CFrame=CFrame.lookAt(root.Position,root.Position+flat)
            end
            tool:Activate()
            if CombatEvent then CombatEvent:FireServer("Activate",tool.Name) end
