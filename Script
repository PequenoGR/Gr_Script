    end
    env.GRHubSeaCleanup=S.cleanup
    task.spawn(function()
        while running() and not S.dead do
            local ok,err=pcall(tick)
            if not ok then
                S.status="Erro: "..tostring(err)
                if os.clock()-(S.lastError or 0)>5 then
                    S.lastError=os.clock()
                    warn("[GR Hub Sea]",err)
                end
            end
            task.wait(State.AutoSeaBeast and .02 or State.SeaBeastESP and .4 or 1)
        end
        S.cleanup()
    end)
    return S
end)()



local Raid = (function()
    State.AutoRaid=false
    local R={status="Desligado",state="-",fort="-",wave=0,waves=0,enemy=nil,chests={},retry={},skills=nil,lastSkill=0,skillIndex=0,lastM1=0,lastScan=0,lastVault=0,lastChests=0,lastChest=0,cache={},cacheFort=nil,dead=false,connection=nil,lastError=0,dodgeUntil=0,dodgePos=nil,lastDodge=0,dodgeReason="-",lastHP=nil,dodges=0,m1Count=0,skillCount=0,lastBoss=nil}
    local function area()
        local map=workspace:FindFirstChild("Map")
        local areas=map and map:FindFirstChild("Areas")
        return areas and areas:FindFirstChild("Marine Forts")
    end
    local function fortInfo()
