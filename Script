local function alturaSegura(origem,destino)
    local horizontal=Vector3.new(destino.X-origem.X,0,destino.Z-origem.Z).Magnitude
    local y=math.max(origem.Y,destino.Y)
    if horizontal<20 then return y end
    if dentroVulcao() then return y+math.min(alturaVoo,8) end
    y+=alturaVoo
    local filtros={workspace.Terrain}
    for _,nome in ipairs({"Map","Islands"}) do
        local v=workspace:FindFirstChild(nome)
        if v then table.insert(filtros,v) end
    end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances=filtros
    params.IgnoreWater=true
    local amostras=math.clamp(math.ceil(horizontal/75),2,35)
    local topo=y+1500
    for i=0,amostras do
        local pt=origem:Lerp(destino,i/amostras)
        local hit=workspace:Raycast(Vector3.new(pt.X,topo,pt.Z),Vector3.new(0,-4000,0),params)
        if hit then y=math.max(y,hit.Position.Y+35) end
    end
    return y
end
local function criarRota(root,destino,chave)
    local origem=root.Position
    local horizontal=Vector3.new(destino.X-origem.X,0,destino.Z-origem.Z).Magnitude
    local cruzeiro=(chave=="RaidEnemy" or chave=="RaidDodge" or chave=="AutoBoss" or chave=="BossReturn" or chave=="BossDodge" or chave=="SeaBoss" or chave=="SeaDodge") and (math.max(origem.Y,destino.Y)+4) or alturaSegura(origem,destino)
    rota={root=root,chave=chave,destino=destino,cruzeiro=cruzeiro,fase=horizontal<20 and 3 or 1,concluida=false}
    ultimoInicioRota=os.clock()
end
local function definirDestino(destino,chave)
    if typeof(destino)~="Vector3" then liberarVoo();return end
    local _,root=character()
    if not root then liberarVoo();return end
    if not rota or rota.chave~=chave or rota.root~=root then
        criarRota(root,destino,chave);return
    end
    local diff=(rota.destino-destino).Magnitude
    local tempo=os.clock()-ultimoInicioRota
    if rota.concluida then
        local margem=chave=="SeaBoss" and 1 or ((chave=="RaidEnemy" or chave=="AutoBoss") and 2 or 6)
        local espera=chave=="SeaBoss" and 0.10 or ((chave=="RaidEnemy" or chave=="AutoBoss") and 0.18 or 0.35)
        local distancia=(root.Position-destino).Magnitude
        if chave=="RaidEnemy" or chave=="RaidDodge" or chave=="RaidFort" then
            distancia=Vector3.new(root.Position.X-destino.X,0,root.Position.Z-destino.Z).Magnitude
            margem=1.5
        end
        if distancia>margem and tempo>espera then criarRota(root,destino,chave)
        else rota.destino=destino end
        return
    end
    if diff>28 and tempo>0.75 then criarRota(root,destino,chave);return end
    rota.destino=destino
    if destino.Y>rota.cruzeiro then rota.cruzeiro=destino.Y+3;rota.fase=1 end
    if rota.fase==3 then
        local h=Vector3.new(destino.X-root.Position.X,0,destino.Z-root.Position.Z).Magnitude
        if h>4 then rota.fase=2 end
    end
end
local function atualizarVoo(dt)
    if os.clock()<(FeatureState.islandUntil or 0) and not FeatureState.islandTraveling then return end
    if not (State.AutoFarmQuest or State.AutoFarmFruit or State.AutoSeaBeast or State.AutoRaid or State.AutoBoss or State.AutoHaki or State.AutoSecondary or State.AutoSkyHermit or FeatureState.islandTraveling) or not running() then return end
    local r=rota
    if not r or typeof(r.destino)~="Vector3" then return end
    if emTransicao() then liberarVoo();return end
    local char,root,hum=character()
    if not char or not root or not hum or hum.Health<=0 or r.root~=root then liberarVoo();return end
    prepararVoo(char,root,hum)
    if rota~=r then return end
    if os.clock()-ultimaColisao>0.5 then ultimaColisao=os.clock();atualizarColisao(char) end
    if State.AutoRaid and (r.chave=="RaidEnemy" or r.chave=="RaidDodge" or r.chave=="RaidFort") then
        if FeatureState.raidHover then
            pcall(function() FeatureState.raidHover:Destroy() end)
            FeatureState.raidHover=nil
        end
        if bodyVelocity then
            bodyVelocity.MaxForce=Vector3.new(0,math.max(10000,root.AssemblyMass*workspace.Gravity*1.5),0)
            bodyVelocity.Velocity=Vector3.zero
        end
        local shift=Vector3.new(r.destino.X-root.Position.X,0,r.destino.Z-root.Position.Z)
        local distance=shift.Magnitude
        if distance>0.65 then
            local speed=r.chave=="RaidDodge" and 500
                or (r.chave=="RaidEnemy" and math.max(220,modo.Velocidade) or 160)
            local step=math.min(distance,speed*math.min(dt,0.065))
            char:TranslateBy(shift.Unit*step)
            r.concluida=false
        else
            r.concluida=true
        end
        faseVoo=r.chave=="RaidDodge" and "Raid: esquiva lateral"
            or (r.chave=="RaidEnemy" and "Raid: indo pelo lado do inimigo"
                or "Raid: aguardando onda no mesmo nivel")
        return
    end
    if State.AutoSeaBeast and r.chave=="SeaBoss" then
        if FeatureState.raidHover then
            pcall(function() FeatureState.raidHover:Destroy() end)
            FeatureState.raidHover=nil
        end
        if bodyVelocity then
            bodyVelocity.MaxForce=Vector3.new(0,math.max(10000,root.AssemblyMass*workspace.Gravity*1.5),0)
        end
        local delta=r.destino-root.Position
        local distance=delta.Magnitude
        local baseSpeed=FeatureState.seaApproachSpeed or 230
        local speed=distance>70 and baseSpeed or
            (distance>20 and baseSpeed*.74 or
            (distance>6 and baseSpeed*.48 or baseSpeed*.27))
        FeatureState.seaFollowSpeed=math.floor(speed)
        if distance>0.42 then
            local step=math.min(distance,speed*math.min(dt,.045))
            char:TranslateBy(delta.Unit*step)
        end
        faseVoo=distance<1.6 and "Sea: encostado na cabeça" or "Sea: voo suave"
        return
    end
    if r.chave=="AutoBoss" then
        if FeatureState.raidHover then
            pcall(function() FeatureState.raidHover:Destroy() end)
            FeatureState.raidHover=nil
        end
        if bodyVelocity then
            bodyVelocity.MaxForce=Vector3.new(0,math.max(10000,root.AssemblyMass*workspace.Gravity*1.5),0)
        end
        local shift=r.destino-root.Position
        local distance=shift.Magnitude
        local baseSpeed=FeatureState.bossApproachSpeed or 180
        local speed=distance>70 and baseSpeed or
            (distance>25 and baseSpeed*.7 or
            (distance>8 and baseSpeed*.48 or baseSpeed*.3))
        if distance>.45 then
            char:TranslateBy(shift.Unit*math.min(distance,speed*math.min(dt,.05)))
        end
        faseVoo=distance<2 and "Boss: perto do alvo" or "Boss: aproximação suave"
        return
    end
    if ((State.AutoRaid and r.chave=="RaidEnemy") or (State.AutoSeaBeast and r.chave=="SeaBoss")) and (root.Position-r.destino).Magnitude<=30 then
        if not FeatureState.raidHover or FeatureState.raidHover.Parent~=root then
            if FeatureState.raidHover then pcall(function() FeatureState.raidHover:Destroy() end) end
            local hold=Instance.new("BodyPosition")
            hold.Name="GRHubCombatHover"
            hold.MaxForce=Vector3.new(1e8,1e8,1e8)
            hold.P=r.chave=="SeaBoss" and 50000 or 30000
            hold.D=r.chave=="SeaBoss" and 4500 or 3500
            hold.Position=r.destino
            hold.Parent=root
            FeatureState.raidHover=hold
        end
        FeatureState.raidHover.Position=r.destino
        if bodyVelocity then bodyVelocity.MaxForce=Vector3.zero end
        faseVoo=r.chave=="SeaBoss" and "Sea: colado na cabeça" or (r.chave=="AutoBoss" and "Boss: acima do inimigo" or "Raid: parado em cima do inimigo")
        return
    elseif FeatureState.raidHover then
        pcall(function() FeatureState.raidHover:Destroy() end)
        FeatureState.raidHover=nil
        if bodyVelocity then
            bodyVelocity.MaxForce=Vector3.new(0,math.max(10000,root.AssemblyMass*workspace.Gravity*1.5),0)
        end
    end
    local flat=Vector3.new(r.destino.X-root.Position.X,0,r.destino.Z-root.Position.Z)
    if flat.Magnitude>0.1 and bodyGyro then bodyGyro.CFrame=CFrame.lookAt(root.Position,root.Position+flat) end
    if r.chave=="BossReturn" then
        local offset=r.destino-root.Position
        local distance=offset.Magnitude
        if distance<1.8 then
            r.concluida=true
            faseVoo="Boss: retorno concluído"
            return
        end
        local configured=FeatureState.bossReturnSpeed or 360
        local velocity=distance>50 and configured or
            (distance>20 and math.min(configured,260) or
            (distance>8 and math.min(configured,155) or math.min(configured,95)))
        local step=math.min(distance,velocity*math.min(dt,.05))
        char:TranslateBy(offset.Unit*step)
        faseVoo="Boss: aproximação suave"
        return
    end
    if r.chave=="BossDodge" then
        local shift=r.destino-root.Position
        if shift.Magnitude<2 then r.concluida=true;faseVoo="Esquiva concluída";return end
        local speed=FeatureState.bossDodgeSpeed or 740
        local step=math.min(shift.Magnitude,math.max(speed,modo.Velocidade)*math.min(dt,.1))
        char:TranslateBy(shift.Unit*step)
        faseVoo="Boss: esquiva rápida"
        return
    end
    if r.concluida then faseVoo="No destino";return end
    local velocidade=r.chave=="IslandTP" and (FeatureState.islandSpeed or 45) or ((r.chave=="SeaBoss" or r.chave=="SeaDodge") and math.max(modo.Velocidade,r.chave=="SeaDodge" and 520 or 420) or modo.Velocidade)
    local restante=velocidade*math.min(dt,0.1)
    for _=1,12 do
        if restante<=0 or rota~=r then break end
        local pos=root.Position
        local destino
        if r.fase==1 then
            faseVoo="Subindo"
            destino=Vector3.new(pos.X,r.cruzeiro,pos.Z)
        elseif r.fase==2 then
            faseVoo="Voo horizontal"
            destino=Vector3.new(r.destino.X,r.cruzeiro,r.destino.Z)
        elseif r.fase==3 then
            faseVoo="Descendo"
            if Vector3.new(pos.X-r.destino.X,0,pos.Z-r.destino.Z).Magnitude>3 then r.fase=2;continue end
            destino=Vector3.new(pos.X,r.destino.Y,pos.Z)
        else
            r.concluida=true;faseVoo="No destino";break
        end
        local delta=destino-pos
        local dist=delta.Magnitude
        if dist<0.25 then r.fase+=1;continue end
        local passo=math.min(dist,restante,18)
        char:TranslateBy(delta.Unit*passo)
        restante-=passo
        if passo>=dist-0.25 then r.fase+=1 end
    end
end

