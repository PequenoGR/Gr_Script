local function getHRP()
	local char = player.Character or player.CharacterAdded:Wait()
	return char:WaitForChild("HumanoidRootPart")
end

local function tp(pos)
	local hrp = getHRP()
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = typeof(pos) == "Vector3" and CFrame.new(pos) or pos
	end
end

local function fireTouch(part)
	local hrp = getHRP()
	if hrp and part then
		local touch = part:FindFirstChild("TouchInterest")
		if touch and firetouchinterest then
			firetouchinterest(hrp, part, 0)
			task.wait()
			firetouchinterest(hrp, part, 1)
			return true
		end
	end
	return false
end

local function getSpawners(folder)
	local parts = workspace:FindFirstChild("DropperParts")
	if parts then
		local spawners = parts:FindFirstChild("ItemSpawners")
		if spawners then
			return spawners:FindFirstChild(folder)
		end
	end
	return nil
end

