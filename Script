            local ok,obj=pcall(require,module)
            if ok and type(obj)=="table" then R.skills=obj end
        end
        return R.skills
    end
    local function warning(root,bossRoot)
        local cam=workspace.CurrentCamera
        local folder=cam and cam:FindFirstChild("BossTelegraphs")
        if not folder or not bossRoot then return nil end
        if (root.Position-bossRoot.Position).Magnitude>260 then return nil end
        for _,part in ipairs(folder:GetDescendants()) do
            if part:IsA("BasePart") and part.Name=="Telegraph"
                and (part.Position-bossRoot.Position).Magnitude<280
                and (root.Position.Y-part.Position.Y)<55
                and (root.Position.Y-part.Position.Y)>-18 then
                local danger=false
                local radius=0
                if part.Shape==Enum.PartType.Cylinder then
                    radius=math.max(part.Size.Y,part.Size.Z)*.5
                    local dx=root.Position.X-part.Position.X
                    local dz=root.Position.Z-part.Position.Z
                    danger=(dx*dx+dz*dz)<(radius+7)^2
                else
                    local localPos=part.CFrame:PointToObjectSpace(root.Position)
                    danger=math.abs(localPos.X)<part.Size.X*.5+7 and math.abs(localPos.Z)<part.Size.Z*.5+7
                    radius=math.min(80,math.max(part.Size.X,part.Size.Z))
                end
                if danger then
                    local away=Vector3.new(root.Position.X-part.Position.X,0,root.Position.Z-part.Position.Z)
                    if away.Magnitude<1 then
                        if part.Shape~=Enum.PartType.Cylinder and part.Size.Z>part.Size.X then
                            away=part.CFrame.RightVector
                        else
                            away=Vector3.new(root.Position.X-bossRoot.Position.X,0,root.Position.Z-bossRoot.Position.Z)
                        end
                    end
                    if away.Magnitude<.1 then away=Vector3.new(1,0,0) end
                    return "Aviso vermelho do boss",away.Unit,math.clamp(radius+23,42,85)
                end
            end
        end
        return nil
    end
    local function evade(root,why,away,distance)
        local now=os.clock()
        if now-R.lastDodge<1.05 then return false end
        R.lastDodge=now
        R.dodges+=1
        R.dodgeReason=why
        R.dodgeUntil=now+0.95
        local horizontal=Vector3.new(away.X,0,away.Z)
        if horizontal.Magnitude<.1 then horizontal=Vector3.new(1,0,0) end
        R.dodgePos=root.Position+horizontal.Unit*(distance or 50)
        liberarVoo()
        return true
    end
    local function attemptSkill(tool)
        if os.clock()-R.lastSkill<1.3 then return end
        local client=ability()
        if not client then return end
        local inputs={"Z","X","C","V","F"}
        local selected
        for _=1,#inputs do
            R.skillIndex=R.skillIndex%#inputs+1
            local key=inputs[R.skillIndex]
            local valid=true
            if client.Skills and type(client.Skills.GetByKey)=="function" then
                local ok,result=pcall(function() return client.Skills:GetByKey(tool.Name,key) end)
                valid=ok and result~=nil
            end
            if valid then selected=key;break end
        end
        if not selected then return end
        R.lastSkill=os.clock()
        local vim
        pcall(function() vim=game:GetService("VirtualInputManager") end)
        if vim then
