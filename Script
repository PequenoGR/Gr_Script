local function advanceQuest()
    local d=lerDados()
    local now=os.clock()
    local level=lerNivel(d)
    local wanted=questPorNivel(level)
    local active=questAtiva(d)
    if not wanted then
        status="Nenhuma missão para este nível";campanha=nil;objetivo=nil;destinoNPC=nil;limparAlvo();return
    end
    if active and active.questName~=wanted.questName then
        if State.AbandonarOutra or level>=active.maxLevel then
            status="Abandonando missão anterior: "..active.questName
            campanha=wanted;objetivo=nil;destinoNPC=nil;limparAlvo()
            if now-ultimoPedido>=1.5 then ultimoPedido=now;enviarQuest("Abandon",active.questName) end
            return
        end
        wanted=active
    end
    local selected=active or wanted
    if campanha~=selected then
        campanha=selected;objetivo=nil;destinoNPC=nil;conclusaoDesde=0;limparAlvo();liberarVoo()
    end
    if active and active.questName==selected.questName then
        repeatPending=0
        local novo,conhecido=objetivoPendente(d,selected)
        if objetivo~=novo then objetivo=novo;limparAlvo() end
        destinoNPC=nil
        if novo then status="Farmando: "..novo;conclusaoDesde=0
        elseif conhecido then
            status="Aguardando conclusão da missão"
            if conclusaoDesde==0 then conclusaoDesde=now end
            if tentarRepeat(selected) then return end
            if now-conclusaoDesde>5 and now-ultimoPedido>=2 then
                ultimoPedido=now;enviarQuest("Abandon",selected.questName);conclusaoDesde=0
            end
        else status="Aguardando progresso" end
        return
    end
    objetivo=nil;limparAlvo()
    if now-repeatPending<3 then destinoNPC=nil;status="Aguardando Auto Repeat";return end
    if tentarRepeat(wanted) then destinoNPC=nil;return end
    local cf,model=encontrarNPC(wanted)
    if not cf then status="NPC não encontrado: "..wanted.giver;destinoNPC=nil;return end
    local pos=cf.Position+cf.LookVector*3+Vector3.new(0,2,0)
    destinoNPC=CFrame.lookAt(pos,cf.Position)
    status="Indo ao NPC: "..wanted.giver
    local _,root=character()
    if root and (root.Position-pos).Magnitude<8 then
        liberarVoo()
        status="Aceitando missão: "..wanted.questName
        if now-ultimoPedido>=1.5 then
            ultimoPedido=now;enviarQuest("AcceptGrinding",wanted.questName)
            task.spawn(interagirNPC,cf,model)
        end
    end
end
local function buscarEAtacar()
    local char,root,hum=character()
    if not root or not hum or hum.Health<=0 then liberarVoo();limparAlvo();return end
    if verificarPassagemVulcao() then return end
    if not objetivo then
        if destinoNPC and (root.Position-destinoNPC.Position).Magnitude>7 then
            definirDestino(destinoNPC.Position,"NPC_"..tostring(campanha and campanha.questName))
        else liberarVoo() end
        return
    end
    if alvo and not valido(alvo) then limparAlvo() end
    if alvo then
        local vida=vidaInimigo(alvo)
        if vida then
            if not alvoVida or vida<alvoVida then alvoVida=vida;alvoSemDano=os.clock()
            elseif os.clock()-alvoSemDano>6 then
                local er=alvo:FindFirstChild("HumanoidRootPart")
                if er and (root.Position-er.Position).Magnitude<14 then
                    blacklist[alvo]=os.clock();limparAlvo()
                end
            end
        end
    end
    if not alvo and os.clock()-ultimaBusca>0.25 then
        ultimaBusca=os.clock();alvo=encontrarInimigo(objetivo,root)
        if alvo then alvoVida=vidaInimigo(alvo);alvoSemDano=os.clock() end
    end
    if not alvo then
        local ponto=pontoGrupoInimigo(objetivo,root)
        if ponto then
            local destino=ponto+Vector3.new(0,alturaInimigo,0)
            if (root.Position-destino).Magnitude>9 then
                status="Indo ao spawn: "..objetivo
                definirDestino(destino,"Spawn_"..objetivo)
            else
                status="Aguardando inimigo aparecer: "..objetivo
                liberarVoo()
            end
        else
            status="Procurando: "..objetivo.." (sem marcador)"
            liberarVoo()
        end
        return
    end
    local er=rootInimigo(alvo)
    if not er then limparAlvo();liberarVoo();return end
    definirDestino(er.Position+Vector3.new(0,alturaInimigo,0),alvo)
end
local function atacar()
    if not State.AutoFarmQuest or State.AutoSeaBeast or State.AutoRaid or State.AutoBoss or os.clock()<(FeatureState.islandUntil or 0) or FeatureState.frutaOcupada or not alvo or not valido(alvo) then return end
    if emTransicao() or (campanha and campanha.ilha=="Volcano Island" and not dentroVulcao()) then return end
    local _,root,hum=character()
    if not root or not hum or hum.Health<=0 then return end
    local er=alvo:FindFirstChild("HumanoidRootPart")
    if not er or (root.Position-er.Position).Magnitude>14 then return end
    if os.clock()-ultimoAtaque<modo.Ataque then return end
    ultimoAtaque=os.clock()
    local tool=equiparArma()
    if not tool then return end
    pcall(function() tool:Activate() end)
    if CombatEvent then pcall(function() CombatEvent:FireServer("Activate",tool.Name) end) end
end

local function definirFarm(v)
    local ligado=toggle(v,State.AutoFarmQuest)
    if ligado==State.AutoFarmQuest then return end
    State.AutoFarmQuest=ligado
    loopId+=1
    liberarVoo();limparAlvo()
    campanha,objetivo,destinoNPC=nil,nil,nil
    ultimaQuest,ultimaBusca,ultimoPedido,repeatPending,conclusaoDesde=0,0,0,0,0
    ultimaIndexacao=0
    blacklist=setmetatable({}, {__mode="k"})
    if not ligado then status="Desligado";return end
    status="Iniciando Auto Farm"
    local id=loopId
    task.spawn(function()
        while running() and State.AutoFarmQuest and id==loopId do
            local ok,err=pcall(function()
                if os.clock()>=(FeatureState.islandUntil or 0) and not State.AutoSeaBeast and not State.AutoRaid and not State.AutoBoss and not FeatureState.frutaOcupada and not FeatureState.pescandoAgora then
                    if os.clock()-ultimaQuest>0.3 then ultimaQuest=os.clock();advanceQuest() end
