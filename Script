local function tocarFruta(item, handle, char, root, humanoid)
    if not handle or not handle.Parent then return false end
    if (root.Position - handle.Position).Magnitude > 12 then return false end

    if rota and rota.chave == item then
        liberarVoo()
    end

    if firetouchinterest then
        for _, nome in ipairs({"HumanoidRootPart", "UpperTorso", "Torso", "RightFoot", "LeftFoot"}) do
            local parte = char:FindFirstChild(nome)
            if parte and parte:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(parte, handle, 0)
                    firetouchinterest(parte, handle, 1)
                end)
            end
        end
    end
    local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            pcall(fireproximityprompt, prompt)
        else
            pcall(function()
                prompt:InputHoldBegin()
                task.delay(math.max(prompt.HoldDuration, 0.12), function()
                    if prompt.Parent then prompt:InputHoldEnd() end
                end)
            end)
        end
    end
    pcall(function() humanoid:MoveTo(handle.Position) end)
    return true
end

local function coletarFruta(item)
    local handle = handleFruta(item)
    local char, root, humanoid = character()
    if not handle or not root or not humanoid or humanoid.Health <= 0 then
        return false
    end
    if emTransicao() or dentroVulcao() or handle.Position.Y < -250 then
        return false
    end

    local destino = handle.Position + Vector3.new(0, 2, 0)
    local distancia = (root.Position - handle.Position).Magnitude
    local agora = os.clock()

    if not frutaTPFeito then
        frutaTPFeito = true
        faseFruta = "TP inicial"
        if rota then liberarVoo() end
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(destino) * root.CFrame.Rotation
        end)
        distancia = (root.Position - handle.Position).Magnitude
    end

    if distancia > 10 then
        faseFruta = "Voo até a fruta"
        statusFruta = "Indo até " .. tostring(nomeFrutaAtual)
        definirDestino(destino, item)
    else
        faseFruta = "Tentando coletar"
        statusFruta = "Coletando " .. tostring(nomeFrutaAtual)
        if agora - ultimoContatoFruta >= 0.65 then
            ultimoContatoFruta = agora
            tocarFruta(item, handle, char, root, humanoid)
        end
    end
    return true
end

