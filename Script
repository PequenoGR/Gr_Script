local function nomeDaFruta(item)
    if not item or not item:IsA("Tool") then return nil end
    local base=item.Name:gsub("%s+[Ff]ruit$", "")
    local att=item:GetAttribute("Fruit")
    if type(att)=="string" and att~="" then base=att:gsub("%s+[Ff]ruit$", "") end
    local key=base:lower()
    for _,name in ipairs(FRUIT_NAMES) do
        if name:lower()==key then return name end
    end
    for apelido,canonico in pairs(FRUIT_ALIASES) do
        if apelido:lower()==key then return canonico end
    end
    return nil
end

local function frutaValida(item)
    return item and item.Parent and item:IsA("Tool")
        and (item:GetAttribute("Fruit")~=nil or item.Name:match("[Ff]ruit$"))
        and nomeDaFruta(item)~=nil
end

local function handleFruta(item)
    if not item then return nil end
    local h=item:FindFirstChild("Handle")
    if h and h:IsA("BasePart") then return h end
    for _,v in ipairs(item:GetDescendants()) do
        if v:IsA("BasePart") then return v end
