-- AUTO PORTAL 4x
-- ============================================
task.spawn(function()
	while task.wait(0.1) do
		if not autoPortal4xAtivo then continue end
		local char = player.Character
		if not char then continue end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then continue end
		local portal = nil
		for _, name in ipairs(portalTools) do
			portal = player.Backpack:FindFirstChild(name) or char:FindFirstChild(name)
			if portal then break end
		end
		if portal and portal.Parent ~= char then
			hum:EquipTool(portal)
		end
		local popup = player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("GUI") and player.PlayerGui.GUI:FindFirstChild("HUD") and player.PlayerGui.GUI.HUD:FindFirstChild("PortalPopup")
		if popup then
			local btn = popup:FindFirstChild("Portal4xButton")
			if btn and (btn.Visible or popup.Visible) then
				pcall(function()
					if fireclickdetector then fireclickdetector(btn) end
					if firesignal then firesignal(btn.MouseButton1Click) end
					btn:Fire()
					btn:Click()
				end)
			end
		end
	end
end)

-- ============================================
-- FARM DE ÁREAS - SIMPLES E RÁPIDO
-- ============================================
task.spawn(function()
	while task.wait(CONFIG.INTERVALO) do
		if not farmAtivo then continue end
		local spawners = getSpawners(areaSelecionada.Folder)
		if spawners and #spawners:GetChildren() > 0 then
			local pegou = false
			for _, model in spawners:GetChildren() do
				if not farmAtivo or pegou then break end
				local part = model:FindFirstChild("HumanoidRootPart", true)
				if part then
					local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
					if prompt then
						tp(part.CFrame + Vector3.new(0, 2, 0))
						task.wait(CONFIG.TEMPO_APOS_TP)
						if fireproximityprompt then
							fireproximityprompt(prompt)
						else
							prompt:InputHoldBegin()
							task.wait(0.03)
							prompt:InputHoldEnd()
						end
						pegou = true
						task.wait(0.02)
					end
				end
			end
			if pegou then
				tp(areaSelecionada.Retorno)
				task.wait(CONFIG.TEMPO_APOS_TP)
			end
		else
			tp(areaSelecionada.Entrada)
			task.wait(CONFIG.TEMPO_APOS_TP)
		end
	end
end)

-- ============================================
-- FARM DE PLOTS
-- ============================================
task.spawn(function()
	while task.wait(CONFIG.INTERVALO) do
		if not farmPlotsAtivo then continue end
		local plot = workspace:FindFirstChild("Plot_" .. player.Name)
		if plot and plot:IsA("Model") then
			for floorNum = 1, 3 do
				local floor = plot:FindFirstChild("Floor"..floorNum)
				if floor then
					local slots = floor:FindFirstChild("Slots")
					if slots then
						for slotNum = 1, 10 do
							if not farmPlotsAtivo then break end
							local slot = slots:FindFirstChild("Slot"..slotNum)
							if slot then
								local temPlanta = false
								for _, child in slot:GetChildren() do
									if string.match(child.Name, "Base") then
										temPlanta = true
										break
									end
								end
								if temPlanta then
									local touch = slot:FindFirstChild("CollectTouch")
									if touch and touch:IsA("BasePart") then
										fireTouch(touch)
										task.wait(0.02)
									end
								end
							end
						end
					end
				end
			end
		else
			task.wait(0.3)
		end
	end
end)

-- ============================================
-- FARM DE EVENTO (AdminCoin)
-- ============================================
task.spawn(function()
	while task.wait(CONFIG.INTERVALO) do
		if not farmEventoAtivo then continue end
		local hrp = getHRP()
		if not hrp then
			task.wait(0.3)
			continue
		end
		local target = hrp.Position + Vector3.new(0, CONFIG.ALTURA_SEGURA, 0)
		local encontrou = false
		for _, obj in workspace:GetChildren() do
			if obj.Name == "AdminCoin" and obj:IsA("Model") then
				encontrou = true
				if not obj.PrimaryPart then
					for _, p in obj:GetDescendants() do
						if p:IsA("BasePart") then
							obj.PrimaryPart = p
							break
						end
					end
				end
				if obj.PrimaryPart then
					local pos = obj:GetPivot().Position
					if (pos - target).Magnitude > 3 then
						obj:PivotTo(CFrame.new(pos:Lerp(target, CONFIG.VELOCIDADE_EVENTO)) * obj:GetPivot().Rotation)
					end
					fireTouch(obj.PrimaryPart)
					task.wait(0.02)
				end
			end
		end
		if not encontrou then
			task.wait(0.3)
		end
	end
end)
