local function objetivoPendente(d,c)
    local actives=d and d.Quests and d.Quests.Actives
    local progress=actives and actives[c.questName]
    local sub=type(progress)=="table" and (progress[1] or progress["1"])
    if type(sub)=="table" then
        local count=0
        for i,o in ipairs(c.objetivos) do
            local v=tonumber(sub[i] or sub[tostring(i)])
            if v~=nil then
                count+=1
                if v<o.total then return o.nome,true end
            end
        end
        if count==#c.objetivos then return nil,true end
    end
    local reconheceu=false
    local labels=lerLabels()
    for _,o in ipairs(c.objetivos) do
        for _,s in ipairs(labels) do
            local a,b=s:match("(%d+)%s*/%s*(%d+)")
            if a and b and normalizar(s):find(normalizar(o.nome),1,true) then
                reconheceu=true
                if tonumber(a)<tonumber(b) then return o.nome,true end
            end
        end
    end
    return nil,reconheceu
end

