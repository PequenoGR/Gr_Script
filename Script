local function guardarFruta()
    if not State.AutoStoreFruit or os.clock()-FeatureState.ultimaLojaFruta<2.5 then return end
    local char,_,hum=character()
    if not char or not hum or hum.Health<=0 then return end
    if State.AutoFarmQuest and not State.AutoFarmFruit then return end
    local backpack=player:FindFirstChild("Backpack")
    local item=char:FindFirstChildWhichIsA("Tool")
    if not (item and item:GetAttribute("Fruit")) then item=nil end
    if not item and backpack then
        for _,tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("Fruit") then item=tool;break end
        end
    end
    if not item then return end
    if item.Parent~=char then
        pcall(function() hum:EquipTool(item) end)
        if item.Parent~=char then
            FeatureState.statusFruta="Aguardando equipar "..item.Name
            return
        end
    end
    FeatureState.ultimaLojaFruta=os.clock()
    local ok=remoteStoreFruit()
    if ok then
        FeatureState.statusFruta="Solicitado guardar: "..item.Name
    else
        FeatureState.statusFruta="Remoto ToolsData/Store indisponível"
    end
end

local function atualizarFarmFruta()
    if State.AutoRaid or State.AutoBoss or os.clock()<(FeatureState.islandUntil or 0) then FeatureState.frutaOcupada=false;return end
    if State.AutoSeaBeast then
        FeatureState.frutaOcupada=false
        return
    end
    if not State.AutoFarmFruit then
        FeatureState.frutaOcupada = false
        return
    end

    if emTransicao() then
        finalizarTentativaFruta(false, 0)
        FeatureState.statusFruta = "Aguardando transição"
        return
    end

    if dentroVulcao() then
        finalizarTentativaFruta(false, 0)
        FeatureState.statusFruta = "Interior: Auto Quest continua até sair"
        return
    end

    if not next(FeatureState.frutasSelecionadas) then
        finalizarTentativaFruta(false, 0)
        FeatureState.statusFruta = "Nenhuma fruta selecionada"
        return
    end

    local char, root, hum = character()
    if not root or not hum or hum.Health <= 0 then
        finalizarTentativaFruta(false, 0)
        return
    end

    local agora = os.clock()
    if agora < FeatureState.cooldownFrutasAte then
        FeatureState.frutaOcupada = false
        FeatureState.statusFruta = "Aguardando nova tentativa; Quest liberada"
        return
    end

    local folder = pastaFrutas()
    if FeatureState.alvoFruta and (not folder or not FeatureState.alvoFruta:IsDescendantOf(folder)) then
        if frutaNoInventario(FeatureState.alvoFruta, FeatureState.nomeFrutaAtual) then
            FeatureState.contadorFrutas += 1
            FeatureState.falhasFrutas = 0
            FeatureState.statusFruta = "Fruta adquirida: " .. tostring(FeatureState.nomeFrutaAtual)
            finalizarTentativaFruta(false, 1)
        else
            FeatureState.statusFruta = "Fruta desapareceu do mapa"
            finalizarTentativaFruta(false, 2)
        end
        return
    end

    if FeatureState.alvoFruta and (not frutaValida(FeatureState.alvoFruta) or not handleFruta(FeatureState.alvoFruta)) then
        finalizarTentativaFruta(true, 0)
        return
    end

    if not FeatureState.alvoFruta then
        FeatureState.alvoFruta = encontrarFruta(root)
        if not FeatureState.alvoFruta then
            FeatureState.frutaOcupada = false
            FeatureState.statusFruta = "Sem frutas elegíveis; Auto Quest continua"
            return
        end
        FeatureState.nomeFrutaAtual = nomeDaFruta(FeatureState.alvoFruta)
        FeatureState.inicioTentativaFruta = agora
        FeatureState.ultimoProgressoFruta = agora
        FeatureState.ultimoContatoFruta = 0
        FeatureState.distanciaAnteriorFruta = math.huge
        FeatureState.frutaTPFeito = false
        FeatureState.faseFruta = "Selecionada"
        FeatureState.frutaOcupada = true
        if rota then liberarVoo() end
    end

    FeatureState.frutaOcupada = true
    status = "Buscando fruta: " .. tostring(FeatureState.nomeFrutaAtual)
    local handle = handleFruta(FeatureState.alvoFruta)
    if not handle then finalizarTentativaFruta(true, 0); return end

    local distancia = (root.Position - handle.Position).Magnitude
    if distancia < FeatureState.distanciaAnteriorFruta - 3 then
        FeatureState.ultimoProgressoFruta = agora
    end
    FeatureState.distanciaAnteriorFruta = distancia

    local limite = math.clamp(distancia / math.max(modo.Velocidade, 50) * 2 + 8, 10, 40)
    if agora - FeatureState.inicioTentativaFruta > limite
        or (agora - FeatureState.ultimoProgressoFruta > 5 and distancia > 12)
        or (distancia <= 12 and agora - FeatureState.inicioTentativaFruta > 7) then
        FeatureState.statusFruta = "Não foi possível coletar " .. tostring(FeatureState.nomeFrutaAtual) .. "; Quest liberada"
        finalizarTentativaFruta(true, 0)
        return
    end

    coletarFruta(FeatureState.alvoFruta)
end

