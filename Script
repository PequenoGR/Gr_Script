local function tipoRealTool(tool)
    if not tool or not tool:IsA("Tool") then return nil end
    local function traduzTipo(t)
        t=tostring(t or ""):lower()
        if t=="sword" then return "Sword" end
        if t=="style" or t=="combat" or t=="fightingstyle" or t=="melee" then return "Combat" end
        if t=="fruit" or t=="devilfruit" then return "Fruit" end
        if t=="gun" then return "Gun" end
        return nil
    end
    local candidatos={tool.Name}
    for _,a in ipairs({"ToolName","OriginalName"}) do
        local nome=tool:GetAttribute(a)
        if type(nome)=="string" and nome~="" then
            table.insert(candidatos,nome)
        end
    end
    local tabelaInfo=mainModulo and mainModulo.Tools and mainModulo.Tools.ToolsInfo
    if type(tabelaInfo)=="table" then
        for _,nome in ipairs(candidatos) do
            local info=tabelaInfo.Infos and tabelaInfo.Infos[nome]
            if not info and type(tabelaInfo.Get)=="function" then
                local ok,resultado=pcall(function() return tabelaInfo:Get(nome) end)
                if ok then info=resultado end
            end
            if type(info)=="table" then
                local classe=traduzTipo(info.ToolType)
                if classe then return classe end
            end
        end
    end
    local shared=RS:FindFirstChild("Shared")
    local main=shared and shared:FindFirstChild("MainModules")
    local tools=main and main:FindFirstChild("Tools")
    local infos=tools and tools:FindFirstChild("ToolsInfo")
    if infos then
        for _,categoria in ipairs({"Sword","Style","Fruit","Gun"}) do
            local pasta=infos:FindFirstChild(categoria)
            if pasta then
                for _,nome in ipairs(candidatos) do
                    if pasta:FindFirstChild(nome) then
                        return traduzTipo(categoria)
                    end
                end
            end
        end
    end
    local porAtributo=traduzTipo(tool:GetAttribute("ToolType"))
        or traduzTipo(tool:GetAttribute("Type"))
    if porAtributo then return porAtributo end
    if tool.Name=="Combat" then return "Combat" end
    return nil
end

