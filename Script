local function reindexar()
    if os.clock()-ultimaIndexacao<0.8 then return end
    ultimaIndexacao=os.clock()
    table.clear(indexInimigos)
    local vistos={}
    local fontes={}
    local function incluir(e)
        if e:IsA("Model") and not vistos[e] then
            vistos[e]=true
            table.insert(indexInimigos,e)
        end
    end
    local function adicionarPasta(base)
        if not base then return end
        for _,nome in ipairs({"Enemys","Enemies"}) do
            local pasta=base:FindFirstChild(nome)
            if pasta then
                table.insert(fontes,pasta:GetFullName())
                for _,e in ipairs(pasta:GetDescendants()) do
                    if e:IsA("Model") and (e:FindFirstChild("HumanoidRootPart") or e.PrimaryPart or e:GetAttribute("EnemyName")) then
                        incluir(e)
                    end
                end
                for _,e in ipairs(pasta:GetChildren()) do
                    if e:IsA("Model") then incluir(e) end
                end
            end
        end
    end
    local play=workspace:FindFirstChild("Playability")
    local ignore=workspace:FindFirstChild("IgnoreList")
    local int=ignore and ignore:FindFirstChild("Int")
    adicionarPasta(play)
    adicionarPasta(int)
    adicionarPasta(ignore)
    adicionarPasta(workspace)
    if #indexInimigos==0 then
        for _,base in ipairs({play or false,int or false,ignore or false}) do
            if base then
                for _,e in ipairs(base:GetDescendants()) do
                    if e:IsA("Model") and rootInimigo(e) then incluir(e) end
                end
            end
        end
    end
    debugBusca.fonte=#fontes>0 and table.concat(fontes," | ") or "Fallback"
end

local function encontrarInimigo(nome,root)
    reindexar()
    local function buscar()
        local melhor,menor=nil,math.huge
        local correspondentes,validos=0,0
        local semRoot,mortos,renderFalse,blacklisted=0,0,0,0
        for _,e in ipairs(indexInimigos) do
            if nomeConfere(e,nome) then
                correspondentes+=1
                local motivo=motivoInvalido(e)
                if not motivo then
                    local er=rootInimigo(e)
                    if er then
                        validos+=1
                        local d=(er.Position-root.Position).Magnitude
                        if d<menor then melhor,menor=e,d end
                    end
                elseif motivo=="semRoot" then semRoot+=1
                elseif motivo=="morto" then mortos+=1
                elseif motivo=="renderFalse" then renderFalse+=1
                elseif motivo=="blacklist" then blacklisted+=1 end
            end
        end
        debugBusca.candidatos=#indexInimigos
        debugBusca.correspondentes=correspondentes
        debugBusca.validos=validos
        debugBusca.semRoot=semRoot
        debugBusca.mortos=mortos
        debugBusca.renderFalse=renderFalse
        debugBusca.blacklist=blacklisted
        return melhor
    end
    local melhor=buscar()
    if not melhor and os.clock()-ultimaBuscaCompleta>5 then
        ultimaBuscaCompleta=os.clock()
        local vistos={}
        for _,e in ipairs(indexInimigos) do vistos[e]=true end
        for _,e in ipairs(workspace:GetDescendants()) do
            if e:IsA("Model") and not vistos[e] and nomeConfere(e,nome) then
                table.insert(indexInimigos,e)
                vistos[e]=true
            end
        end
        melhor=buscar()
    end
    debugBusca.exemplos={}
    if not melhor then
        for _,e in ipairs(indexInimigos) do
            if #debugBusca.exemplos>=18 then break end
            if e:IsA("Model") then
                table.insert(debugBusca.exemplos,e.Name.." ["..tostring(e:GetAttribute("OriginalName") or e:GetAttribute("EnemyName") or "-").."]")
            end
        end
    end
    return melhor
end

local function pontoGrupoInimigo(nome,root)
    local agora=os.clock()
    local c=cacheGrupo[nome]
    if c and agora-c.t<1.5 and c.p and c.p.Parent then
        debugBusca.grupo=c.p:GetFullName()
        return c.p.Position
    end
    local ignore=workspace:FindFirstChild("IgnoreList")
    local data=ignore and ignore:FindFirstChild("Data")
    local pasta=data and data:FindFirstChild("EnemyGroups")
    if not pasta then
        debugBusca.grupo="Pasta EnemyGroups indisponível"
        return nil
    end
    local melhor,menor=nil,math.huge
    local texto=","..nome.."," 
    for _,obj in ipairs(pasta:GetDescendants()) do
        if obj:IsA("BasePart") and obj:GetAttribute("Wide")~=true then
            local nomes=obj:GetAttribute("Enemies")
            if type(nomes)=="string" and nomes:find(texto,1,true) then
                local ponto=obj:FindFirstChild(nome)
                if not (ponto and ponto:IsA("BasePart")) then ponto=obj end
                local d=(ponto.Position-root.Position).Magnitude
                if d<menor then melhor,menor=ponto,d end
            end
        end
    end
    if melhor then
        cacheGrupo[nome]={p=melhor,t=agora}
        debugBusca.grupo=melhor:GetFullName()
        return melhor.Position
    end
    debugBusca.grupo="Sem marcador para "..nome
    return nil
end

