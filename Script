local function atualizarFarmFruta()
    if not State.AutoFarmFruit then
        frutaOcupada = false
        return
    end

    if emTransicao() then
        finalizarTentativaFruta(false, 0)
        statusFruta = "Aguardando transição"
        return
    end

    if dentroVulcao() then
        finalizarTentativaFruta(false, 0)
        statusFruta = "Interior: Auto Quest continua até sair"
        return
    end

    if not next(frutasSelecionadas) then
        finalizarTentativaFruta(false, 0)
        statusFruta = "Nenhuma fruta selecionada"
        return
    end

    local char, root, hum = character()
    if not root or not hum or hum.Health <= 0 then
        finalizarTentativaFruta(false, 0)
        return
    end

    local agora = os.clock()
    if agora < cooldownFrutasAte then
        frutaOcupada = false
        statusFruta = "Aguardando nova tentativa; Quest liberada"
        return
    end

    local folder = pastaFrutas()
    if alvoFruta and (not folder or not alvoFruta:IsDescendantOf(folder)) then
        if frutaNoInventario(alvoFruta, nomeFrutaAtual) then
            contadorFrutas += 1
            falhasFrutas = 0
            statusFruta = "Fruta adquirida: " .. tostring(nomeFrutaAtual)
            finalizarTentativaFruta(false, 1)
        else
            statusFruta = "Fruta desapareceu do mapa"
            finalizarTentativaFruta(false, 2)
        end
        return
    end

    if alvoFruta and (not frutaValida(alvoFruta) or not handleFruta(alvoFruta)) then
        finalizarTentativaFruta(true, 0)
        return
    end

    if not alvoFruta then
        alvoFruta = encontrarFruta(root)
        if not alvoFruta then
            frutaOcupada = false
            statusFruta = "Sem frutas elegíveis; Auto Quest continua"
            return
        end
        nomeFrutaAtual = nomeDaFruta(alvoFruta)
        inicioTentativaFruta = agora
        ultimoProgressoFruta = agora
        ultimoContatoFruta = 0
        distanciaAnteriorFruta = math.huge
        frutaTPFeito = false
        faseFruta = "Selecionada"
        frutaOcupada = true
        if rota then liberarVoo() end
    end

    frutaOcupada = true
    status = "Buscando fruta: " .. tostring(nomeFrutaAtual)
    local handle = handleFruta(alvoFruta)
    if not handle then finalizarTentativaFruta(true, 0); return end

    local distancia = (root.Position - handle.Position).Magnitude
    if distancia < distanciaAnteriorFruta - 3 then
        ultimoProgressoFruta = agora
    end
    distanciaAnteriorFruta = distancia

    local limite = math.clamp(distancia / math.max(modo.Velocidade, 50) * 2 + 8, 10, 40)
    if agora - inicioTentativaFruta > limite
        or (agora - ultimoProgressoFruta > 5 and distancia > 12)
        or (distancia <= 12 and agora - inicioTentativaFruta > 7) then
        statusFruta = "Não foi possível coletar " .. tostring(nomeFrutaAtual) .. "; Quest liberada"
        finalizarTentativaFruta(true, 0)
        return
    end

    coletarFruta(alvoFruta)
end

