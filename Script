    if equipada and tipoRealTool(equipada)==FeatureState.tipoToolSelecionado then
        return equipada
    end
    local bp=player:FindFirstChild("Backpack")
    local escolhida
    if bp then
        for _,item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and tipoRealTool(item)==FeatureState.tipoToolSelecionado then
                escolhida=item
                break
            end
        end
    end
    if equipada and equipada~=escolhida then
        pcall(function() hum:UnequipTools() end)
    end
    if not escolhida then return nil end
    local ok=pcall(function() hum:EquipTool(escolhida) end)
    if not ok then return nil end
    local atual=char:FindFirstChildWhichIsA("Tool")
    if atual and tipoRealTool(atual)==FeatureState.tipoToolSelecionado then
        return atual
    end
    return nil
end

local function selecionarTipoTool(v)
    if type(v)=="table" then v=v.Valor or v.Name or v.Value end
    if type(v)=="number" and TOOL_TYPES[v] then v=TOOL_TYPES[v].Valor end
    for _,opcao in ipairs(TOOL_TYPES) do
        if v==opcao.Valor then
            FeatureState.tipoToolSelecionado=v
            equiparArma()
            return
        end
    end
end
