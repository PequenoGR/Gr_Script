        local api={}
        for _,fn in ipairs({
            setclipboard or false,toclipboard or false,writeclipboard or false,
            env.setclipboard or false,env.toclipboard or false,env.writeclipboard or false
        }) do
            if type(fn)=="function" then table.insert(api,fn) end
        end
        for _,fn in ipairs(api) do
            if type(fn)=="function" then
                local ok=pcall(fn,txt)
                if ok then return true end
            end
        end
        local clip=env.Clipboard
        if type(clip)=="table" and type(clip.set)=="function" then
            local ok=pcall(clip.set,txt)
