local function setFrutasEscolhidas(lista)
    finalizarTentativaFruta(false, 0)
    table.clear(FeatureState.frutasSelecionadas)
    if type(lista) ~= "table" then return end
    for _, v in ipairs(lista) do
        local s = type(v) == "table" and (v.Name or v.Value) or v
        if type(s) == "string" then
            for _, name in ipairs(FRUIT_NAMES) do
                if s == name then
                    FeatureState.frutasSelecionadas[name] = true
                    break
                end
            end
        end
    end
    FeatureState.cooldownFrutasAte = 0
end

local function encontrarFruta(root)
    local escolhida, menor = nil, math.huge
    local agora = os.clock()
    for _, item in ipairs(FeatureState.frutasVisiveis) do
        local name = nomeDaFruta(item)
        local h = handleFruta(item)
        if name and h and FeatureState.frutasSelecionadas[name]
            and h.Position.Y >= -250
            and (not FeatureState.blacklistFrutas[item] or agora >= FeatureState.blacklistFrutas[item]) then
            local dist = (root.Position - h.Position).Magnitude
            if dist < menor then
                escolhida, menor = item, dist
            end
        end
    end
    return escolhida
end

local function frutaNoInventario(item, nome)
    local char = player.Character
    local mochila = player:FindFirstChild("Backpack")
    if item and (item.Parent == char or item.Parent == mochila) then
        return true
    end
    for _, base in ipairs({char or false, mochila or false}) do
        if base then
            for _, tool in ipairs(base:GetChildren()) do
                if tool:IsA("Tool") and tool:GetAttribute("Fruit")
                    and nomeDaFruta(tool) == nome then
                    return true
                end
            end
        end
    end
    return false
end

local function tocarFruta(item, handle, char, root, humanoid)
    if not handle or not handle.Parent then return false end
    if (root.Position - handle.Position).Magnitude > 12 then return false end

    if rota and rota.chave == item then
        liberarVoo()
    end

    if firetouchinterest then
        for _, nome in ipairs({"HumanoidRootPart", "UpperTorso", "Torso", "RightFoot", "LeftFoot"}) do
            local parte = char:FindFirstChild(nome)
            if parte and parte:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(parte, handle, 0)
                    firetouchinterest(parte, handle, 1)
                end)
            end
        end
    end
    local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then
            pcall(fireproximityprompt, prompt)
        else
            pcall(function()
                prompt:InputHoldBegin()
                task.delay(math.max(prompt.HoldDuration, 0.12), function()
                    if prompt.Parent then prompt:InputHoldEnd() end
                end)
            end)
        end
    end
    pcall(function() humanoid:MoveTo(handle.Position) end)
    return true
end

local function coletarFruta(item)
    local handle = handleFruta(item)
    local char, root, humanoid = character()
    if not handle or not root or not humanoid or humanoid.Health <= 0 then
        return false
    end
    if emTransicao() or dentroVulcao() or handle.Position.Y < -250 then
        return false
    end

    local destino = handle.Position + Vector3.new(0, 2, 0)
    local distancia = (root.Position - handle.Position).Magnitude
    local agora = os.clock()

    if not FeatureState.frutaTPFeito then
        FeatureState.frutaTPFeito = true
        FeatureState.faseFruta = "TP inicial"
        if rota then liberarVoo() end
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(destino) * root.CFrame.Rotation
        end)
        distancia = (root.Position - handle.Position).Magnitude
    end

    if distancia > 10 then
        FeatureState.faseFruta = "Voo até a fruta"
        FeatureState.statusFruta = "Indo até " .. tostring(FeatureState.nomeFrutaAtual)
        definirDestino(destino, item)
    else
        FeatureState.faseFruta = "Tentando coletar"
        FeatureState.statusFruta = "Coletando " .. tostring(FeatureState.nomeFrutaAtual)
        if agora - FeatureState.ultimoContatoFruta >= 0.65 then
            FeatureState.ultimoContatoFruta = agora
            tocarFruta(item, handle, char, root, humanoid)
        end
    end
    return true
end

