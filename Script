        if not (V.fullAuto and (V.activeQuest=="Vox Armor Mastery"
            or V.activeQuest=="Vox Armor Training")) and not hakiObjective("StoneBreak") then
            V.miniStatus="StoneBreak sem missão Vox ativa"
            return
        end
        local gui=player.PlayerGui:FindFirstChild("StoneBreakGui")
        if not gui or not gui.Enabled then return end
        local layer=gui:FindFirstChild("Targets",true)
        if not layer then return end
        local session=V.miniSession
        if not session then return end
        V.miniStatus="Auto StoneBreak: tocando círculos"
        for _,target in ipairs(layer:GetChildren()) do
            if target.Name:match("^Target%d+$") then
                local hit=target:FindFirstChild("Hit")
                if hit and os.clock()-(session.seen[hit] or -100)>.18 and tap(hit) then
                    session.seen[hit]=os.clock()
                end
            end
