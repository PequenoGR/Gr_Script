    for _, item in ipairs(frutasVisiveis) do
        local name = nomeDaFruta(item)
        local h = handleFruta(item)
        if name and h and frutasSelecionadas[name]
            and h.Position.Y >= -250
            and (not blacklistFrutas[item] or agora >= blacklistFrutas[item]) then
            local dist = (root.Position - h.Position).Magnitude
            if dist < menor then
                escolhida, menor = item, dist
