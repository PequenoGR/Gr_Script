local IslandTeleport = (function()
    local T = {
        chosen=nil,options={},status="Pronto",
        speed=45,token=0,traveling=false,
        speedChoices={
            {Name="Lento (45)",Valor=45},
            {Name="Normal (90)",Valor=90},
            {Name="Rápido (160)",Valor=160}
        }
    }
    local function areas()
        local map=workspace:FindFirstChild("Map")
        return map and map:FindFirstChild("Areas")
    end
    local function add(names,seen,name,level)
        if type(name)~="string" or name=="" then return end
        if seen[name] then return end
        seen[name]=true
        table.insert(names,{Name=name,Level=tonumber(level) or 9999})
    end
    local function build()
        local names,seen={},{}
        for _,quest in ipairs(CAMPANHAS) do
            add(names,seen,quest.ilha,quest.minLevel)
        end
        local folder=areas()
        if folder then
            for _,obj in ipairs(folder:GetChildren()) do
                if obj:IsA("Folder") and obj:GetAttribute("MapImage")~=nil then
                    add(names,seen,obj.Name,obj:GetAttribute("Level"))
                end
            end
        end
        table.sort(names,function(a,b)
            if a.Level==b.Level then return a.Name<b.Name end
            return a.Level<b.Level
        end)
        local result={}
        for _,item in ipairs(names) do table.insert(result,item.Name) end
        return result
    end
    T.options=build()
    T.chosen=T.options[1]
    function T.choose(v)
        if type(v)=="table" then v=v.Name or v.Value or v.Valor end
        if type(v)=="string" and v~="" then T.chosen=v end
    end
    function T.setSpeed(v)
        if type(v)=="table" then v=v.Valor or v.Value end
        if type(v)=="number" then T.speed=math.clamp(v,20,220) end
        FeatureState.islandSpeed=T.speed
    end
    function T.stop()
        T.token+=1
        T.traveling=false
        FeatureState.islandTraveling=false
        FeatureState.islandUntil=os.clock()+1
        if rota and rota.chave=="IslandTP" then liberarVoo() end
        T.status="Viagem cancelada"
    end
    env.GRHubIslandStop=T.stop
    local function findSpawn(area,center)
        local ignore=workspace:FindFirstChild("IgnoreList")
        local data=ignore and ignore:FindFirstChild("Data")
        local spawns=data and data:FindFirstChild("Spawns")
        local folder=spawns and spawns:FindFirstChild("PlayerSpawns")
        if not folder then return nil end
        local bounds=area:GetAttribute("MapLand")
        local altitude=area:GetAttribute("MapAltitude")
        local nearest,best=nil,math.huge
        for _,spawn in ipairs(folder:GetChildren()) do
            local pos=spawn:GetAttribute("CheckpointPosition")
            if typeof(pos)=="Vector3" then
                local ok=typeof(bounds)=="Rect"
                    and pos.X-center.X>=bounds.Min.X-100
                    and pos.X-center.X<=bounds.Max.X+100
                    and pos.Z-center.Z>=bounds.Min.Y-100
                    and pos.Z-center.Z<=bounds.Max.Y+100
                if not ok and typeof(bounds)~="Rect" then
                    ok=(Vector2.new(pos.X-center.X,pos.Z-center.Z)).Magnitude<450
                end
                if ok and (type(altitude)~="number" or math.abs(pos.Y-altitude)<1000) then
                    local dist=(Vector2.new(pos.X-center.X,pos.Z-center.Z)).Magnitude
                    if dist<best then best=dist;nearest=pos end
                end
            end
        end
        return nearest
    end
    local function ground(area,center)
        local map=workspace:FindFirstChild("Map")
        if not map then return nil end
        local altitude=area:GetAttribute("MapAltitude")
        local baseY=math.max(center.Y,type(altitude)=="number" and altitude or center.Y)
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances={map}
        params.IgnoreWater=true
        local origin=Vector3.new(center.X,baseY+1200,center.Z)
        local hit=workspace:Raycast(origin,Vector3.new(0,-2400,0),params)
        if hit and hit.Position.Y> -200 then return hit.Position end
        return nil
    end
    function T.go()
        local selected=T.chosen
        local folder=areas()
        local area=folder and folder:FindFirstChild(selected or "")
        if not area then
            T.status="Ilha não carregada: "..tostring(selected)
            warn("[GR Hub Teleport]",T.status)
            return
        end
        local center=area:GetAttribute("MapCenter")
        if typeof(center)~="Vector3" then
            T.status="MapCenter indisponível: "..tostring(selected)
            warn("[GR Hub Teleport]",T.status)
            return
        end
        if emTransicao() then
            T.status="Aguardando transição do jogo"
            warn("[GR Hub Teleport]",T.status)
            return
        end
        local char,root,hum=character()
        if not char or not root or not hum or hum.Health<=0 then
            T.status="Personagem indisponível"
            return
        end
        local point=findSpawn(area,center) or ground(area,center)
        if not point then
            T.status="Sem spawn ou solo seguro: "..tostring(selected)
            warn("[GR Hub Teleport]",T.status)
            return
        end
        if T.traveling then T.stop() end
        T.token+=1
        local token=T.token
        local target=point+Vector3.new(0,4,0)
        local speed=T.speed
        local distance=(root.Position-target).Magnitude
        local deadline=os.clock()+math.max(60,math.min(950,distance/speed*4+45))
        T.traveling=true
        FeatureState.islandTraveling=true
        FeatureState.islandSpeed=speed
        FeatureState.frutaOcupada=false
        FeatureState.islandUntil=os.clock()+3
        liberarVoo()
        definirDestino(target,"IslandTP")
        T.status="Viajando devagar: "..tostring(selected)
        task.spawn(function()
            local completed=false
            while T.token==token and T.traveling and running() do
                FeatureState.islandUntil=os.clock()+3
                local _,currentRoot,currentHum=character()
                if not currentRoot or not currentHum or currentHum.Health<=0 then
                    T.status="Viagem interrompida: personagem indisponível"
                    break
                end
                if emTransicao() then
                    T.status="Viagem interrompida: transição do jogo"
                    break
                end
                local left=(currentRoot.Position-target).Magnitude
                if left<=7 then
                    completed=true
                    break
                end
                if os.clock()>deadline then
                    T.status="Viagem encerrada: tempo limite ou movimento bloqueado"
                    break
                end
                if not rota or rota.chave~="IslandTP" then
                    definirDestino(target,"IslandTP")
                end
                T.status="Viajando para "..selected.." ("..math.floor(left).." studs)"
                task.wait(.18)
            end
            if T.token~=token then return end
            T.traveling=false
            FeatureState.islandTraveling=false
            FeatureState.islandUntil=os.clock()+1.5
            if rota and rota.chave=="IslandTP" then liberarVoo() end
            if completed then
                T.status="Chegou à ilha: "..selected
                print("[GR Hub Teleport]",T.status)
            else
                warn("[GR Hub Teleport]",T.status)
            end
        end)
    end
    return T
end)()


local FruitShopAuto = (function()
    local P={
        active=false,names={},chosen={},
        stock={},stockLoaded=false,status="Desligado",lastFetch=-120,
        attempts=0,purchases=0,requesting=false,stopped=false,
        lastAttempt=0,lastCycle=nil,lastFruit="-",lastPrice=0
    }
    for _,name in ipairs(FRUIT_NAMES) do table.insert(P.names,name) end
    for _,name in ipairs({"Forest","Operator"}) do
        if not table.find(P.names,name) then table.insert(P.names,name) end
    end
    table.sort(P.names)
    local function notify(text)
        print("[GR Hub Fruit Shop] "..tostring(text))
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification",{
                Title="GR Hub - Loja de frutas",Text=tostring(text),Duration=6
            })
        end)
    end
    local function cycleId()
        return tostring(game.PlaceId)..":"..tostring(player.UserId)..":"..tostring(math.floor(workspace:GetServerTimeNow()/14400))
    end
    local function wallet()
        local d=lerDados()
        local m=d and d.Monetization
        if not m then return nil end
        return tonumber(m.Gold)
    end
    local function oldFruit()
        if not mainModulo or not mainModulo.ToolsUtils then return nil end
        local ok,item=pcall(function()
            return mainModulo.ToolsUtils.GetCurrentCategoryTool(nil,"Fruit")
        end)
        if ok and item then return item.Name end
        return nil
    end
    local function permanent(name)
        if not mainModulo or not mainModulo.TransactionData then return false end
        local ok,owned=pcall(function()
            return mainModulo.TransactionData.IsProductOwned(nil,name)
        end)
        return ok and owned==true
    end
    local function loadStock(force)
        if P.requesting then return false end
        if not force and os.clock()-P.lastFetch<55 then return P.stockLoaded end
        if not dadosModulo or not dadosModulo.Network then
            P.status="Rede da loja indisponível"
            return false
        end
        P.requesting=true
        P.lastFetch=os.clock()
        local ok,result=pcall(function()
            return dadosModulo.Network:SafeInvokeServer(5,"RotativeShop","GetBanner")
        end)
        P.requesting=false
        if not ok or type(result)~="table" then
            P.status="Não consegui consultar o estoque"
            return false
        end
        P.stock={}
        P.stockLoaded=true
        for _,entry in ipairs(result) do
            if type(entry)=="table" and type(entry.FruitName)=="string" then
                local price=tonumber(entry.Price)
                if entry.InStock==true and price and price>0 then
                    table.insert(P.stock,{name=entry.FruitName,price=price})
                end
            end
        end
        P.status="Estoque atualizado: "..tostring(#P.stock).." frutas"
        return true
    end
    local function nextFruit()
        local gold=wallet()
        if not gold then return nil,"Saldo Gold não carregado" end
        local holding=oldFruit()
        local selected=0
        local offers={}
        local skipped={}
        for _,offer in ipairs(P.stock) do
            local base=offer.name:match("^(.-) Fruit$")
            if base and P.chosen[base] then
                selected+=1
                if holding==base then
                    table.insert(skipped,"Fruta já equipada")
                elseif permanent(offer.name) then
                    table.insert(skipped,"Fruta permanente já possuída")
                elseif gold<offer.price then
                    table.insert(skipped,"Gold insuficiente")
                else
                    table.insert(offers,offer)
                end
            end
        end
        if #offers>0 then
            table.sort(offers,function(a,b)
                local x=(FRUIT_RARITY[a.name:match("^(.-) Fruit$")] or "Common")
                local y=(FRUIT_RARITY[b.name:match("^(.-) Fruit$")] or "Common")
                local ranks={Common=1,Rare=2,Epic=3,Legendary=4,Mythical=5}
                if x~=y then return (ranks[x] or 0)>(ranks[y] or 0) end
                return a.price<b.price
            end)
            return offers[1]
        end
        if selected==0 then return nil,"Nenhuma fruta selecionada em estoque" end
        return nil,skipped[1] or "Fruta escolhida indisponível"
    end
    function P.setSelected(values)
        table.clear(P.chosen)
        for _,v in ipairs(type(values)=="table" and values or {}) do
            local name=type(v)=="table" and (v.Name or v.Value or v.Valor) or v
            if type(name)=="string" and table.find(P.names,name) then P.chosen[name]=true end
        end
        local count=0
        for _ in pairs(P.chosen) do count+=1 end
        P.status=tostring(count).." frutas selecionadas"
    end
    function P.setAuto(v)
        P.active=(v==true)
        P.status=P.active and "Procurando frutas selecionadas em estoque" or "Desligado"
        if P.active then P.lastFetch=-120;P.stockLoaded=false end
    end
    function P.showStock()
        task.spawn(function()
            loadStock(true)
            local pieces={}
            for _,entry in ipairs(P.stock) do
                local base=entry.name:match("^(.-) Fruit$") or entry.name
                table.insert(pieces,(P.chosen[base] and "✓ " or "")..base.." = "..tostring(entry.price).." Gold")
            end
            local message="Estoque atual:\n"..(#pieces>0 and table.concat(pieces,"\n") or "Sem ofertas disponíveis")
            print("[GR Hub Fruit Shop]\n"..message)
            local selected=0
            for _,entry in ipairs(P.stock) do
                if P.chosen[entry.name:match("^(.-) Fruit$") or ""] then selected+=1 end
            end
            notify(tostring(selected).." frutas escolhidas no estoque. Veja o console para preços.")
        end)
    end
    function P.cleanup()
        P.stopped=true
        P.active=false
    end
    env.GRHubFruitShopStop=P.cleanup
    task.spawn(function()
        while running() and not P.stopped do
            local ok,err=pcall(function()
                if not P.active then return end
                if emTransicao() or State.AutoBoss or State.AutoRaid or State.AutoSeaBeast
                    or FeatureState.pescandoAgora or FeatureState.frutaOcupada
                    or FeatureState.islandTraveling then
                    P.status="Aguardando atividade atual terminar"
                    return
                end
                if not next(P.chosen) then
                    P.status="Escolha uma ou mais frutas para comprar"
                    return
                end
                local cycle=cycleId()
                local history=env.GRHubFruitShopAttempts
                if type(history)~="table" then
                    history={}
                    env.GRHubFruitShopAttempts=history
                end
                if history[cycle] then
                    P.status="Compra já tentada neste estoque (aguardando rotação)"
                    return
                end
                if not loadStock(false) then return end
                local offer,reason=nextFruit()
                if not offer then
                    P.status=reason
                    return
                end
                if os.clock()-P.lastAttempt<5 then return end
                P.lastAttempt=os.clock()
                local gold=wallet()
                if not gold or gold<offer.price then return end
                history[cycle]=true
                P.attempts+=1
                P.lastCycle=cycle
                P.lastFruit=offer.name
                P.lastPrice=offer.price
                local success,err=pcall(function()
                    dadosModulo.Network:FireServer("RotativeShop","Buy",offer.name)
                end)
                if success then
                    P.status="Pedido enviado: "..offer.name.." por "..offer.price.." Gold"
                    notify(P.status)
                    task.wait(1.5)
                    local after=wallet()
                    if after and after<gold then
                        P.purchases+=1
                        P.status="Compra confirmada pelo saldo: "..offer.name
                    else
                        P.status="Pedido enviado; resultado ainda não confirmado pelo saldo"
                    end
                else
                    history[cycle]=nil
                    P.status="Erro ao enviar compra: "..tostring(err)
                    warn("[GR Hub Fruit Shop]",P.status)
                end
            end)
            if not ok then
                P.status="Erro na loja: "..tostring(err)
                warn("[GR Hub Fruit Shop]",err)
            end
            task.wait(P.active and 4 or 1.5)
        end
        P.cleanup()
    end)
    return P
end)()

local FruitGachaAuto = (function()
    local G={active=false,status="Desligado",spins=0,lastResult="-",lastTry=0,nextTry=0,waiting=false,stopped=false}
    local function spinDelay()
        local fruits=mainModulo and mainModulo.FruitsUtils
        return tonumber(fruits and fruits.GachaSpinTime) or 7200
    end
    local function lastSpin()
        local last=nil
        if mainModulo and mainModulo.Registry then
            local ok,v=pcall(function()
                return mainModulo.Registry:Get(nil,"FruitSpinDeltaTime")
            end)
            if ok then last=tonumber(v) end
        end
        if not last then
            local data=lerDados()
            last=tonumber(data and data.Registry and data.Registry.FruitSpinDeltaTime)
        end
        return last
    end
    local function remaining()
        local last=lastSpin()
        if not last then return 0 end
        return math.max(0,last+spinDelay()-os.time())
    end
    local function spinPrice()
        local fruits=mainModulo and mainModulo.FruitsUtils
        if not fruits then return nil end
        if type(fruits.GachaCost)=="function" then
            local ok,cost=pcall(function() return fruits.GachaCost(nil) end)
            if ok and type(cost)=="number" and cost>0 then return math.ceil(cost) end
        end
        local data=lerDados()
        local level=data and data.Statistics and tonumber(data.Statistics.Level)
        if not level then return nil end
        return math.max(tonumber(fruits.GachaMinPrice) or 3000,level*(tonumber(fruits.GachaPricePerLevel) or 30))
    end
    function G.setAuto(v)
        G.active=(v==true)
        G.status=G.active and "Aguardando giro disponível" or "Desligado"
        if G.active then G.nextTry=0 end
    end
    function G.cleanup()
        G.active=false
        G.stopped=true
    end
    env.GRHubGachaStop=G.cleanup
    task.spawn(function()
        while running() and not G.stopped do
            local ok,err=pcall(function()
                if not G.active or G.waiting then return end
                if emTransicao() or State.AutoBoss or State.AutoRaid or State.AutoSeaBeast or FeatureState.islandTraveling
                    or FeatureState.pescandoAgora or FeatureState.frutaOcupada then
                    G.status="Aguardando outra atividade terminar"
                    return
                end
                local cd=remaining()
                if cd>0 then
                    G.status="Próximo giro em "..math.ceil(cd/60).." min"
                    return
                end
                if os.clock()<G.nextTry then return end
                local data=lerDados()
                local gold=data and data.Monetization and tonumber(data.Monetization.Gold)
                local price=spinPrice()
                if not gold or not price then
                    G.status="Aguardando Gold/valor do giro"
                    G.nextTry=os.clock()+15
                    return
                end
                if gold<price then
                    G.status="Gold insuficiente (precisa "..math.floor(price)..")"
                    G.nextTry=os.clock()+15
                    return
                end
                if not dadosModulo or not dadosModulo.Network then
                    G.status="Remote do gacha indisponível"
                    G.nextTry=os.clock()+30
                    return
                end
                G.waiting=true
                G.lastTry=os.clock()
                G.nextTry=os.clock()+60
                local done,result=pcall(function()
                    return dadosModulo.Network:InvokeServer("FruitGacha","Spin")
                end)
                G.waiting=false
                if not G.active or G.stopped then return end
                if done and result then
                    G.spins+=1
                    G.lastResult=tostring(result)
                    G.status="Girou: "..G.lastResult
                    G.nextTry=os.clock()+spinDelay()
                    print("[GR Hub Auto Gacha] "..G.status)
                    pcall(function()
                        game:GetService("StarterGui"):SetCore("SendNotification",{
                            Title="GR Hub - Auto Gacha",Text=G.status,Duration=5
                        })
                    end)
                else
                    G.status="Giro não confirmado; aguardando nova tentativa"
                    G.nextTry=os.clock()+60
                    if not done then warn("[GR Hub Auto Gacha]",result) end
                end
            end)
            if not ok then
                G.waiting=false
                G.status="Erro no Auto Gacha: "..tostring(err)
                G.nextTry=os.clock()+60
                warn("[GR Hub Auto Gacha]",err)
            end
            task.wait(G.active and 2 or 1.5)
        end
        G.cleanup()
    end)
    return G
end)()

local BossFarm = (function()
    local B={
        active=false,chosen="Mais próximo",list={},choices={"Mais próximo"},
        target=nil,status="Desligado",found=0,defeated=0,m1=0,skillsUsed=0,
        lastScan=-10,lastFull=-20,lastAttack=0,lastSkill=0,skillIndex=0,
        lastHP=nil,lastEnemy=nil,ability=nil,dead=false,lastError=0,
        dodgeUntil=0,dodgePoint=nil,dodges=0,lastDodge=0,dodgeReason="-",
        lastPlayerHP=nil,lastThreatToken=nil,lastDangerScan=-10,zones={},hazardsFound=0,currentDanger="-",
        dodgeMode="Equilibrado",returnSpeed=5000,riskScore=0,safePoint=nil,blockedDodges=0,
        lastCue=nil,cueAt=0,retreatUntil=0,nextRetreat=0,scanCount=0
    }
    local function enemyRoot(model)
        return rootInimigo(model)
    end
    local function bossName(model)
        local name=model:GetAttribute("BossName")
        if type(name)=="string" and name~="" then return name end
        local original=model:GetAttribute("OriginalName") or model:GetAttribute("EnemyName")
        if type(original)=="string" and original~="" then return original end
        return model.Name
    end
    local function looksLikeBoss(model)
        if not model or not model:IsA("Model") or not model.Parent then return false end
        if model==player.Character or (player.Character and model:IsDescendantOf(player.Character)) then return false end
        local name=tostring(model.Name):lower()
        if name:find("sea beast",1,true) or name:find("abyssal beast",1,true) then return false end
        local marked=model:GetAttribute("IsBoss")==true or model:GetAttribute("Boss")==true
            or model:GetAttribute("BossNPC")==true
        if not marked then
            local v=model:GetAttribute("BossName") or model:GetAttribute("Boss")
            marked=type(v)=="string" and v~="" and v~="false"
        end
        if not marked then
            for _,key in ipairs({"Type","EnemyType","Rank","Title","Category"}) do
                local val=model:GetAttribute(key)
                if type(val)=="string" and val:lower():find("boss",1,true) then marked=true;break end
            end
        end
        if not marked then
            marked=name:find("boss",1,true)~=nil or name:find("commander",1,true)~=nil
                or name:find("warlord",1,true)~=nil
        end
        if not marked then
            local parent=model.Parent
            while parent and parent~=workspace do
                local pn=parent.Name:lower()
                if pn=="bosses" or pn=="bossmobs" or pn=="bossnpcs" or pn=="bossenemies" then
                    marked=true
                    break
                end
                parent=parent.Parent
            end
        end
        return marked
    end
    local function valid(model)
        if not looksLikeBoss(model) then return nil end
        if model:GetAttribute("Dead")==true or model:GetAttribute("IsDead")==true then return nil end
        local hp=vidaInimigo(model)
        if type(hp)=="number" and hp<=0 then return nil end
        local hum=model:FindFirstChildWhichIsA("Humanoid",true)
        if hum and hum.Health<=0 then return nil end
        local root=enemyRoot(model)
        return root and root:IsA("BasePart") and root or nil
    end
    local function scan(force)
        if not force and os.clock()-B.lastScan<1.75 then return end
        B.lastScan=os.clock()
        local scopes,seen,found={},{},{}
        local play=workspace:FindFirstChild("Playability")
        local ignored=workspace:FindFirstChild("IgnoreList")
        local inner=ignored and ignored:FindFirstChild("Int")
        for _,base in ipairs({play or false,inner or false,ignored or false}) do
            if base then
                for _,key in ipairs({"Enemys","Enemies","Bosses","BossMobs","BossNPCs"}) do
                    local folder=base:FindFirstChild(key)
                    if folder then table.insert(scopes,folder) end
                end
            end
        end
        local function consider(model)
            if not seen[model] then
                seen[model]=true
                if valid(model) then table.insert(found,model) end
            end
        end
        for _,folder in ipairs(scopes) do
            if folder:IsA("Model") then consider(folder) end
            for _,candidate in ipairs(folder:GetDescendants()) do
                if candidate:IsA("Model") then consider(candidate) end
            end
        end
        if #found==0 and os.clock()-B.lastFull>9 then
            B.lastFull=os.clock()
            for _,candidate in ipairs(workspace:GetDescendants()) do
                if candidate:IsA("Model") then consider(candidate) end
            end
        end
        B.list=found
        B.found=#found
    end
    function B.options()
        scan(true)
        local names,seen={"Mais próximo"},{["Mais próximo"]=true}
        for _,boss in ipairs(B.list) do
            local name=bossName(boss)
            if not seen[name] then table.insert(names,name);seen[name]=true end
        end
        table.sort(names,function(a,b)
            if a=="Mais próximo" then return true end
            if b=="Mais próximo" then return false end
            return a:lower()<b:lower()
        end)
        B.choices=names
        return names
    end
