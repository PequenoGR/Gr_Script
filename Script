    semRoot=0, mortos=0, renderFalse=0, blacklist=0,
    fonte="-", grupo="-", exemplos={}
}
local ultimaBuscaCompleta = 0
local cacheGrupo = {}

local function rootInimigo(e)
    if not e or not e:IsA("Model") then return nil end
    return e:FindFirstChild("HumanoidRootPart")
        or e.PrimaryPart
