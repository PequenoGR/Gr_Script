    local function fishShorePoint(marker)
        if typeof(marker)~="Vector3" then return nil end
        if V.shoreCache and (V.shoreCache.marker-marker).Magnitude<5
            and os.clock()-V.shoreCache.time<12 then
            return V.shoreCache.position
        end
        local map=workspace:FindFirstChild("Map")
        if not map then return nil end
        local _,root=character()
        local area=skullArea()
        local altitude=area and area:GetAttribute("MapAltitude")
        local top=math.max(marker.Y,tonumber(altitude) or marker.Y)+400
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances={map,workspace.Terrain}
        params.IgnoreWater=false
        local oceanHit=workspace:Raycast(Vector3.new(marker.X,top,marker.Z),
            Vector3.new(0,-850,0),params)
        local oceanLevel=oceanHit and oceanHit.Material==Enum.Material.Water
            and oceanHit.Position.Y or nil
        local nearest,best=nil,math.huge
        for _,radius in ipairs({0,10,18,28,40,55,75,100,130}) do
            for n=0,15 do
                local angle=n*math.pi/8
                local x=marker.X+math.cos(angle)*radius
                local z=marker.Z+math.sin(angle)*radius
                local hit=workspace:Raycast(Vector3.new(x,top,z),
                    Vector3.new(0,-850,0),params)
                if hit and hit.Material~=Enum.Material.Water
                    and hit.Normal.Y>.55
                    and (not oceanLevel or hit.Position.Y>oceanLevel+1.5) then
                    local point=hit.Position
                    local score=radius+(root and (root.Position-point).Magnitude*.04 or 0)
                    if score<best then nearest=point;best=score end
                end
            end
            if nearest then break end
        end
        V.shoreCache={marker=marker,position=nearest,time=os.clock()}
        return nearest
    end
