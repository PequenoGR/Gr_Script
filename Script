local function frutaNoInventario(item, nome)
    local char = player.Character
    local mochila = player:FindFirstChild("Backpack")
    if item and (item.Parent == char or item.Parent == mochila) then
        return true
    end
    for _, base in ipairs({char or false, mochila or false}) do
        if base then
            for _, tool in ipairs(base:GetChildren()) do
                if tool:IsA("Tool") and tool:GetAttribute("Fruit")
                    and nomeDaFruta(tool) == nome then
                    return true
