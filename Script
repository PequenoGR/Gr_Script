    local function sendKey(key)
        local code=Enum.KeyCode[key]
        if not code or not miniVim then return false end
        local ok=pcall(function()
            miniVim:SendKeyEvent(true,code,false,game)
            miniVim:SendKeyEvent(false,code,false,game)
