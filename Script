    local function risk(zone,pt)
        if math.abs(pt.Y-zone.pos.Y)>(zone.height or 55) then return 0 end
        local margin=profile().margin
        if zone.kind=="box" then
            local q=zone.cf:PointToObjectSpace(pt)
            local dx=zone.width*.5+margin-math.abs(q.X)
            local dz=zone.length*.5+margin-math.abs(q.Z)
            if dx<=0 or dz<=0 then return 0 end
            return 14+math.min(dx,dz)*.65
        end
        local d=planar(pt,zone.pos)
        local outside=zone.radius+margin
        local inside=math.max(0,(zone.inner or 0)-margin)
        if d>=outside or d<inside then return 0 end
        return 13+math.min(outside-d,32)*.7
    end
    local function projectile(name)
        local text=tostring(name or ""):lower()
        for _,word in ipairs({"projectile","meteor","fireball","iceball","waterbomb","lightning","thunderbolt","shockwave","bomb","explosion","energyorb","fireorb","spike","spear","tornado","vortex","bladebeam","bullet","flameflies","arrow"}) do
            if text:find(word,1,true) then return true end
        end
        return false
    end
    local function collectDanger(root,enemy,boss)
        local now=os.clock()
        if now-B.lastDangerScan<.075 then return B.zones end
        B.lastDangerScan=now
        B.scanCount+=1
        local zones,seen={},{}
        local function add(zone,key)
            if seen[key] then return end
            seen[key]=true
            table.insert(zones,zone)
        end
        local camera=workspace.CurrentCamera
        local alerts=camera and camera:FindFirstChild("BossTelegraphs")
        if alerts and (root.Position-enemy.Position).Magnitude<340 then
            for _,obj in ipairs(alerts:GetDescendants()) do
                if obj.Name=="Telegraph" then
                    if obj:IsA("BasePart") and obj.Transparency<.98 then
                        local pos=obj.Position
                        if planar(pos,enemy.Position)<380 and planar(pos,root.Position)<260 then
                            local zone
                            if obj.Shape==Enum.PartType.Cylinder then
                                local radius=math.max(obj.Size.Y,obj.Size.Z)*.5
                                if radius>2 then
                                    zone={kind="circle",pos=pos,radius=radius,height=55,
                                        reason="Círculo do boss",token=obj}
                                end
                            elseif obj.Size.X>1.5 and obj.Size.Z>1.5 then
                                zone={kind="box",pos=pos,cf=obj.CFrame,width=obj.Size.X,length=obj.Size.Z,
                                    height=55,reason="Ataque em linha / caixa",token=obj}
                            end
                            if zone then
                                local key=zone.kind..":"..math.floor(pos.X/2)..":"..math.floor(pos.Z/2)
                                    ..":"..math.floor((zone.radius or zone.width)/3)
                                add(zone,key)
                            end
                        end
                    elseif obj:IsA("CylinderHandleAdornment") and obj.Transparency<.98 then
                        local pos=obj.CFrame.Position
                        if planar(pos,enemy.Position)<380 and planar(pos,root.Position)<260 then
                            local radius=tonumber(obj.Radius) or 0
                            local inner=tonumber(obj.InnerRadius) or 0
                            if radius>3 and radius-inner>1.5 then
                                local key="ring:"..math.floor(pos.X/2)..":"..math.floor(pos.Z/2)..":"..math.floor(radius/3)
                                add({kind="ring",pos=pos,radius=radius,inner=inner,height=55,
                                    reason="Anel de ataque",token=obj},key)
                            end
                        end
                    end
                end
            end
        end
        local ignored=workspace:FindFirstChild("IgnoreList")
        local temp=ignored and ignored:FindFirstChild("Temp")
        if temp and (root.Position-enemy.Position).Magnitude<260 then
            local inspected=0
            for _,obj in ipairs(temp:GetDescendants()) do
                inspected+=1
                if inspected>300 then break end
                if projectile(obj.Name) and (obj:IsA("BasePart") or obj:IsA("Model")) then
                    local part=obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart",true))
                    if part and (part.Position-root.Position).Magnitude<120
                        and (part.Position-enemy.Position).Magnitude<240 then
                        local velocity=part.AssemblyLinearVelocity
                        local predicted=part.Position
                        local closing=velocity.Magnitude>10 and (root.Position-part.Position):Dot(velocity)>0
                        if closing then
                            local t=math.clamp((root.Position-part.Position):Dot(velocity)/math.max(velocity:Dot(velocity),1),0,.8)
                            predicted=part.Position+velocity*t
                        end
                        local radius=math.clamp(math.max(part.Size.X,part.Size.Z)*.5+10,13,42)
                        if planar(predicted,root.Position)<radius+56 or planar(part.Position,root.Position)<radius+20 then
                            add({kind="projectile",pos=predicted,radius=radius,height=38,
                                reason="Projétil do boss",token=obj},"projectile:"..tostring(obj))
                        end
                    end
                end
            end
        end
        local cue=boss:GetAttribute("CurrentSkill") or boss:GetAttribute("Action") or boss:GetAttribute("Skill")
        if cue~=B.lastCue then B.lastCue=cue;B.cueAt=now end
        if #zones==0 and type(cue)=="string" and now-B.cueAt<.85 then
            local q=cue:lower()
            if q:find("slam",1,true) or q:find("roar",1,true)
                or q:find("spin",1,true) or q:find("eruption",1,true)
                or q:find("charge",1,true) or q:find("dash",1,true)
                or q:find("strike",1,true) or q:find("explosion",1,true) then
                add({kind="circle",pos=enemy.Position,radius=25,height=35,
                    reason="Golpe anunciado: "..cue,token=cue},"cue:"..cue)
            end
        end
        if #zones==0 and planar(root.Position,enemy.Position)<38 then
            local animator=boss:FindFirstChildWhichIsA("Animator",true)
            if animator then
                local ok,tracks=pcall(function() return animator:GetPlayingAnimationTracks() end)
                if ok and type(tracks)=="table" then
                    for _,track in ipairs(tracks) do
                        local name=(tostring(track.Name).." "..tostring(track.Animation and track.Animation.Name or "")):lower()
                        if (name:find("slam",1,true) or name:find("charge",1,true)
                            or name:find("spin",1,true) or name:find("roar",1,true))
                            and track.TimePosition<.65 then
                            add({kind="circle",pos=enemy.Position,radius=23,height=30,
                                reason="Animação de ataque",token=track},"anim:"..tostring(track))
                            break
                        end
                    end
                end
            end
        end
        B.zones=zones
        B.hazardsFound=#zones
        return zones
    end
    local function dangerAt(zones,pt)
        local total,major,high=0,nil,0
        for _,zone in ipairs(zones) do
            local amount=risk(zone,pt)
            total+=amount
            if amount>high then high=amount;major=zone end
        end
        return total,major
    end
    local function routeRisk(zones,from,to)
        local total=0
        for _,t in ipairs({.25,.5,.75,1}) do
            local value=dangerAt(zones,from:Lerp(to,t))
            total+=value*(t==1 and 2.5 or t)
        end
        return total
    end
    local function blocked(from,to)
        local map=workspace:FindFirstChild("Map")
        local filter={workspace.Terrain}
        if map then table.insert(filter,map) end
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances=filter
        params.IgnoreWater=true
        local delta=to-from
        if delta.Magnitude<3 then return false end
        local hit=workspace:Raycast(from,delta,params)
        return hit~=nil and (hit.Position-to).Magnitude>4
    end
    local function dodgeTarget(root,enemy,zones,urgent)
        local cfg=profile()
        local away=root.Position-enemy.Position
        away=Vector3.new(away.X,0,away.Z)
        if away.Magnitude<1 then away=Vector3.new(1,0,0) end
        away=away.Unit
        local side=Vector3.new(-away.Z,0,away.X)
        local directions={away,side,-side,-away,
            (away+side).Unit,(away-side).Unit,(-away+side).Unit,(-away-side).Unit}
        local best,score=nil,math.huge
        for _,distance in ipairs(cfg.steps) do
            for _,direction in ipairs(directions) do
                local pos=root.Position+direction*distance+Vector3.new(0,5,0)
                local zoneRisk=routeRisk(zones,root.Position,pos)
                local enemyDistance=(pos-enemy.Position).Magnitude
                local rank=zoneRisk*35+distance*.065+math.abs(enemyDistance-22)*.18
                if urgent then rank+=math.max(0,35-enemyDistance)*.4 end
                if rank<score then
                    if blocked(root.Position,pos) then rank+=450 end
                    if rank<score then best,score=pos,rank end
                end
            end
            if score<8 then break end
        end
        return best or root.Position+away*42+Vector3.new(0,6,0),score
    end
    local function evade(root,enemy,zones,reason,token,urgent)
        local now=os.clock()
        if now-B.lastDodge<(urgent and .15 or profile().interval) then return false end
        if not urgent and token==B.lastThreatToken and now-B.lastDodge<.8 then return false end
        local pos,score=dodgeTarget(root,enemy,zones,urgent)
        if B.dodgePoint and (root.Position-B.dodgePoint).Magnitude>8 and
            routeRisk(zones,root.Position,B.dodgePoint)<routeRisk(zones,root.Position,pos) then
            pos=B.dodgePoint
        end
        B.lastDodge=now
        B.lastThreatToken=token
        B.dodges+=1
        B.dodgeReason=reason
        B.currentDanger=reason
        B.safePoint=pos
        B.dodgePoint=pos
        B.riskScore=score
        B.dodgeUntil=now+math.clamp((root.Position-pos).Magnitude/profile().speed+.22,.35,.95)
        if rota and (rota.chave=="AutoBoss" or rota.chave=="BossReturn" or rota.chave=="BossDodge") then liberarVoo() end
        return true
    end
    local function attackPoint(root,enemy,zones)
        local direct=enemy.Position+Vector3.new(0,6,0)
        if dangerAt(zones,direct)==0 and routeRisk(zones,root.Position,direct)<8 then return direct,true end
        local radius=profile().attackRadius
        local best,score=nil,math.huge
        for i=0,11 do
            local angle=i*math.pi/6
            local pos=enemy.Position+Vector3.new(math.cos(angle)*radius,7,math.sin(angle)*radius)
            local rating=dangerAt(zones,pos)*50+routeRisk(zones,root.Position,pos)*.5
                +(root.Position-pos).Magnitude*.035
            if rating<score then best,score=pos,rating end
        end
        if best and dangerAt(zones,best)==0 and routeRisk(zones,root.Position,best)<9 then return best,true end
        return nil,false
    end
    local function useSkill(tool)
        if os.clock()-B.lastSkill<1.7 then return end
        if not B.ability then
            local mods=RS:FindFirstChild("Modules")
            local combat=mods and mods:FindFirstChild("Combat")
            local system=combat and combat:FindFirstChild("AbilitySystem")
            local client=system and system:FindFirstChild("AbilitySystem Client")
            local module=client and client:FindFirstChild("SkillsSystem Client")
            if module then
                local ok,result=pcall(require,module)
                if ok and type(result)=="table" then B.ability=result end
            end
        end
        local skill=B.ability
        if not skill then return end
        local keys={"Z","X","C","V","F"}
        for _=1,#keys do
            B.skillIndex=B.skillIndex%#keys+1
            local key=keys[B.skillIndex]
            local usable=true
            if skill.Skills and type(skill.Skills.GetByKey)=="function" then
                local ok,exists=pcall(function() return skill.Skills:GetByKey(tool.Name,key) end)
                usable=ok and exists~=nil
            end
            if usable then
                B.lastSkill=os.clock()
                local ok=false
                if skill.SkillUI and type(skill.SkillUI.RequestMobile)=="function" then
                    ok=pcall(skill.SkillUI.RequestMobile,key)
                end
                if not ok then
                    local input
                    pcall(function() input=game:GetService("VirtualInputManager") end)
                    if input then
                        ok=pcall(function()
                            input:SendKeyEvent(true,Enum.KeyCode[key],false,game)
                            task.delay(.11,function()
                                pcall(function() input:SendKeyEvent(false,Enum.KeyCode[key],false,game) end)
                            end)
                        end)
                    end
                end
                if ok then B.skillsUsed+=1 end
                return
            end
        end
    end
    local function tick()
        if not State.AutoBoss or not running() then return end
        if State.AutoRaid or State.AutoSeaBeast or FeatureState.islandTraveling
            or FeatureState.pescandoAgora or emTransicao()
            or os.clock()<(FeatureState.islandUntil or 0) then
            B.status="Pausado por outro sistema"
            if rota and (rota.chave=="AutoBoss" or rota.chave=="BossReturn" or rota.chave=="BossDodge") then liberarVoo() end
            return
        end
        local _,root,hum=character()
        if not root or not hum or hum.Health<=0 then
            B.target=nil
            B.status="Aguardando personagem"
            return
        end
        local boss=selectBoss(root)
        if not boss then
            B.target=nil
            B.status=(B.chosen=="Mais próximo" and "Aguardando boss aparecer" or ("Aguardando: "..B.chosen))
            if rota and (rota.chave=="AutoBoss" or rota.chave=="BossReturn" or rota.chave=="BossDodge") then liberarVoo() end
            return
        end
        if B.target~=boss then
            B.target=boss
            B.lastHP=nil
            B.lastPlayerHP=nil
            B.lastCue=nil
            B.lastThreatToken=nil
            B.lastDangerScan=-10
            B.dodgeUntil=0
            B.dodgePoint=nil
            B.zones={}
        end
        local enemy=enemyRoot(boss)
        if not enemy then return end
        local hp=vidaInimigo(boss)
        if hp and B.lastHP and hp<=0 and B.lastHP>0 then B.defeated+=1 end
        B.lastHP=hp
        local zones=collectDanger(root,enemy,boss)
        local dangerLevel,threat=dangerAt(zones,root.Position)
        B.riskScore=dangerLevel
        local now=os.clock()
        local hurt=B.lastPlayerHP and hum.Health<B.lastPlayerHP-math.max(4,hum.MaxHealth*.018)
        B.lastPlayerHP=hum.Health
        if dangerLevel>0 and threat then
            B.currentDanger=threat.reason
            local destDanger=B.dodgePoint and dangerAt(zones,B.dodgePoint) or 0
            if now>=B.dodgeUntil or destDanger>0 then
                evade(root,enemy,zones,threat.reason,threat.token,destDanger>0)
            end
        elseif hurt and (root.Position-enemy.Position).Magnitude<120 then
            B.currentDanger="Recebeu dano"
            evade(root,enemy,zones,B.currentDanger,"hit:"..math.floor(now*3),true)
        else
            B.currentDanger="-"
        end
        if hum.MaxHealth>0 and hum.Health/hum.MaxHealth<.25 and
            B.dodgeMode=="Defensivo" and now>=B.nextRetreat then
            B.nextRetreat=now+8
            B.retreatUntil=now+1.25
            evade(root,enemy,zones,"Vida baixa: recuando","hpLow:"..math.floor(now),true)
        end
        if now<B.dodgeUntil and B.dodgePoint then
            if dangerAt(zones,B.dodgePoint)>0 and now-B.lastDodge>.18 then
                evade(root,enemy,zones,"Ataques múltiplos","multi:"..math.floor(now*5),true)
            end
            B.status="Esquivando ("..B.dodges.."): "..B.dodgeReason
            definirDestino(B.dodgePoint,"BossDodge")
            if (root.Position-B.dodgePoint).Magnitude<5 and dangerLevel==0 then
                B.dodgeUntil=math.min(B.dodgeUntil,now+.1)
            end
            return
        end
        B.dodgePoint=nil
        if now<B.retreatUntil then
            B.status="Recuo defensivo por pouca vida"
            definirDestino(B.safePoint or root.Position,"BossDodge")
            return
        end
        local target,canAttack=attackPoint(root,enemy,zones)
        if not canAttack then
            B.status="Aguardando abertura segura no boss"
            local waitingPoint=root.Position
            if dangerLevel>0 then waitingPoint=dodgeTarget(root,enemy,zones,true) end
            definirDestino(waitingPoint,"BossDodge")
            return
        end
        local distance=(root.Position-enemy.Position).Magnitude
        local remaining=(root.Position-target).Magnitude
        if remaining>3 and not blocked(root.Position,target) then
            B.status="Voltando rápido ao boss: "..bossName(boss)
            definirDestino(target,"BossReturn")
        else
            B.status=(distance>13 and "Aproximando do boss: " or "Atacando boss: ")..bossName(boss)
            definirDestino(target,"AutoBoss")
        end
        if distance>13 then return end
        local tool=equiparArma()
        if not tool then
            B.status="Escolha uma Tool válida para atacar o boss"
            return
        end
        local direction=Vector3.new(enemy.Position.X-root.Position.X,0,enemy.Position.Z-root.Position.Z)
        if direction.Magnitude>.1 then
            pcall(function() root.CFrame=CFrame.lookAt(root.Position,root.Position+direction) end)
        end
        if os.clock()-B.lastAttack>.12 then
            B.lastAttack=os.clock()
            local ok=pcall(function() tool:Activate() end)
            if ok then B.m1+=1 end
        end
        useSkill(tool)
    end
    function B.showStatus()
        local message="Modo: "..B.dodgeMode.." | Retorno: "..tostring(B.returnSpeed)
            .." studs/s | Boss: "..tostring(B.target and bossName(B.target) or "-")
            .." | Esquivas: "..B.dodges.." | Perigos: "..B.hazardsFound
            .." | Último perigo: "..B.currentDanger
        print("[GR Hub Auto Boss] "..message)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification",{
                Title="GR Hub Auto Boss",Text=message,Duration=7
            })
        end)
    end
    function B.cleanup()
        B.dead=true
        B.active=false
        B.dodgeUntil=0
        B.dodgePoint=nil
        B.safePoint=nil
        B.zones={}
        State.AutoBoss=false
        if rota and (rota.chave=="AutoBoss" or rota.chave=="BossReturn" or rota.chave=="BossDodge") then liberarVoo() end
    end
    env.GRHubBossStop=B.cleanup
    task.spawn(function()
        while running() and not B.dead do
            local ok,err=pcall(tick)
            if not ok then
                B.status="Erro: "..tostring(err)
                if os.clock()-B.lastError>3 then
                    B.lastError=os.clock()
                    warn("[GR Hub Auto Boss]",err)
                end
            end
            task.wait(State.AutoBoss and .045 or 1.5)
        end
        B.cleanup()
    end)
    return B
end)()

