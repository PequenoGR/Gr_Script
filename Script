local function encontrarVaraPesca()
    local char=player.Character
    local mochila=player:FindFirstChildOfClass("Backpack")
    for _,container in ipairs({char,mochila}) do
        if container then
            for _,item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local n=item.Name:lower()
                    if n:find("fishing",1,true) and (n:find("rod",1,true) or n:find("road",1,true)) then
                        return item
                    end
                end
            end
        end
    end
    return nil
end
