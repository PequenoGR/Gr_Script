        end
    end
    function R.teleport()
        local _,pos,mode,fort=fortInfo()
        if typeof(pos)~="Vector3" or (mode~="Open" and mode~="Completed") then
            R.status="Nenhuma raid ativa para teleporte";warn("[GR Hub Raid]",R.status);return
        end
        local char,root,hum=character()
        if not char or not root or not hum or hum.Health<=0 then return end
        FeatureState.islandUntil=os.clock()+3
        liberarVoo()
        local ok=pcall(function()
            char:PivotTo(CFrame.new(pos+Vector3.new(0,16,0))*root.CFrame.Rotation)
            root.AssemblyLinearVelocity=Vector3.zero
        end)
        R.status=ok and ("TP Raid: "..tostring(fort)) or "Falha no TP"
    end
    function R.cleanup()
        R.dead=true;State.AutoRaid=false
        if typeof(R.connection)=="RBXScriptConnection" then pcall(function() R.connection:Disconnect() end) end
    end
    env.GRHubRaidCleanup=R.cleanup
    if dadosModulo and dadosModulo.Network then
        local ok,c=pcall(function() return dadosModulo.Network.OnClientEvent("FortRaid",onEvent) end)
        if ok then R.connection=c end
