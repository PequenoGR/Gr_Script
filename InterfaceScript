local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- Carrega o Backend global
local GRHub = getgenv().GRHub or _G.GRHub
if not GRHub then
    warn("GRHub: As funções principais não foram carregadas antes da UI!")
    return
end

local FarmManager = GRHub.FarmManager
local EventManager = GRHub.EventManager
local PlayerManager = GRHub.PlayerManager
local ConfigManager = GRHub.ConfigManager
local imageAsset = GRHub.ImageAsset

local UIBuilder = {}

UIBuilder.CreateHub = function(hubName)
	if player.PlayerGui:FindFirstChild(hubName) then
		player.PlayerGui[hubName]:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = hubName
	gui.Parent = player.PlayerGui
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	return gui
end

UIBuilder.CreateMainFrame = function(parent, currentSize)
	local frame = Instance.new("Frame")
	frame.Parent = parent
	frame.Size = UDim2.new(0, currentSize.X, 0, currentSize.Y)
	frame.Position = UDim2.new(0.5, -currentSize.X/2, 0.5, -currentSize.Y/2)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Draggable = true
	frame.ClipsDescendants = true
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
	return frame
end

UIBuilder.CreateSection = function(parentPage, titleText)
	local section = Instance.new("Frame")
	section.Parent = parentPage
	section.Size = UDim2.new(0.94, 0, 0, 0)
	section.AutomaticSize = Enum.AutomaticSize.Y
	section.BackgroundColor3 = Color3.fromRGB(26, 26, 26)
