    section.Size = UDim2.new(0.94, 0, 0, 0)
    section.AutomaticSize = Enum.AutomaticSize.Y
    section.BackgroundColor3 = Color3.fromRGB(26, 26, 26)
    section.BorderSizePixel = 0
