    local x=pos.X.Scale*view.X+pos.X.Offset
    local y=pos.Y.Scale*view.Y+pos.Y.Offset
    return UDim2.fromOffset(math.clamp(x,math.min(0,view.X-w),math.max(0,view.X-60)),math.clamp(y,0,math.max(0,view.Y-30)))
end
saveConfigNow=function()
    if not fileSupport then configMessage("Armazenamento indisponível."); return false,"Armazenamento indisponível." end
    local ok,err=pcall(function()
        local theme={}; for role,color in pairs(C) do theme[role]=toHex(color) end
        configData.theme=theme; configData.themeName=themeName
        configData.window={size={currentSize.X,currentSize.Y},position=packUDim(main.Position)}
        if ball then ballPosition=packUDim(ball.Position) end
        configData.ballPosition=ballPosition
        for key,entry in pairs(configControls) do if entry.owner.Parent then configData.controls[key]=entry.get() end end
        writefile(configPath,HttpService:JSONEncode(configData))
    end)
    if not ok then configMessage("Falha ao salvar configurações."); return false,tostring(err) end
    configDirty=false; configMessage("Configurações salvas."); return true
end
local function syncAutoSave()
    if autoSaveLabel then autoSaveLabel.Text="Salvamento automático: "..(configData.autoSave and "ON" or "OFF"); paint(autoSaveLabel,"TextColor3",configData.autoSave and "yellow" or "gray") end
end
local function applyConfig(data,restoreControls)
    configApplying=true
    configData=data; configData.autoSave=data.autoSave~=false
    if type(data.theme)=="table" then
        local t={}
        for role,hex in pairs(data.theme) do
            if C[role] and type(hex)=="string" then
                local value=hex:match("^#(%x%x%x%x%x%x)$")
                if value then t[role]=rgb(tonumber(value:sub(1,2),16),tonumber(value:sub(3,4),16),tonumber(value:sub(5,6),16)) end
            end
        end
        API.SetTheme(t)
        if type(data.themeName)=="string" and themes[data.themeName] then themeName=data.themeName end
    else API.ResetTheme() end
    local win=type(data.window)=="table" and data.window or {}
    local size=type(win.size)=="table" and win.size or {480,320}
    local x,y=tonumber(size[1]),tonumber(size[2])
    if not x or x~=x or math.abs(x)==math.huge then x=480 end
    if not y or y~=y or math.abs(y)==math.huge then y=320 end
    x=math.clamp(x,240,2000); y=math.clamp(y,160,1200)
    currentSize.X=x; currentSize.Y=y; main.Size=UDim2.fromOffset(x,y)
    local position=unpackUDim(win.position)
    main.Position=position and safePosition(position,x,y) or UDim2.new(.5,-x/2,.5,-y/2)
    ballPosition=unpackUDim(data.ballPosition) and data.ballPosition or nil
    if ball then ball.Position=ballPosition and safePosition(unpackUDim(ballPosition),55,55) or UDim2.new(.2,30,0,150) end
    if restoreControls then
        for key,entry in pairs(configControls) do
            local value=data.controls[key]; if value==nil then value=entry.default end
            local ok,err=pcall(entry.set,value,true); if not ok then warn("[GRHub] Config: "..tostring(err)) end
        end
    end
    syncAutoSave(); configApplying=false
end
function API.SaveConfig() return saveConfigNow() end
function API.LoadConfig()
    local data,err=readConfig(); if not data then configMessage(err); return false,err end
    configDirty=false; applyConfig(data,true); configMessage("Configurações carregadas."); return true
end
function API.ResetConfig()
    configDirty=false
    applyConfig({version=1,autoSave=true,controls={}},true)
    return saveConfigNow()
end
function API.SetAutoSave(state)
    if type(state)~="boolean" then return false end
    configData.autoSave=state; syncAutoSave()
    return saveConfigNow()
end
function API.GetAutoSave() return configData.autoSave end
API.ConfigPath=configPath
settingsLabel("Configurações persistentes",14)
autoSaveLabel=text("TextButton",settingsScroll,"",{Size=UDim2.new(1,0,0,32),BackgroundTransparency=0,BackgroundColor3="button",LayoutOrder=15}); round(autoSaveLabel,5)
autoSaveLabel.Activated:Connect(function() API.SetAutoSave(not configData.autoSave) end)
for i,item in ipairs({{"Salvar agora",API.SaveConfig},{"Carregar configurações",API.LoadConfig},{"Restaurar configurações padrão",API.ResetConfig}}) do
    local b=text("TextButton",settingsScroll,item[1],{Size=UDim2.new(1,0,0,32),BackgroundTransparency=0,BackgroundColor3="button",LayoutOrder=15+i}); round(b,5)
    b.Activated:Connect(item[2])
end
configStatus=text("TextLabel",settingsScroll,fileSupport and "Salva em JSON neste dispositivo." or "Armazenamento indisponível neste ambiente.",{Size=UDim2.new(1,0,0,32),TextWrapped=true,TextColor3="gray",TextSize=10,LayoutOrder=19})
if initialConfig then applyConfig(configData,false); configMessage("Configurações carregadas automaticamente.") else syncAutoSave() end
configReady=true
main:GetPropertyChangedSignal("Position"):Connect(queueConfig)
main:GetPropertyChangedSignal("Size"):Connect(queueConfig)

min.Activated:Connect(API.Minimize); close.Activated:Connect(API.Destroy)
gui.Destroying:Connect(function() if configDirty and configData.autoSave then saveConfigNow() end; configDead=true; for c in pairs(globalConnections) do c:Disconnect() end; table.clear(globalConnections); if env.GRHub==API then env.GRHub=nil end end)
env.GRHub=API
return API
