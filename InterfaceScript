	Instance.new("UICorner", section).CornerRadius = UDim.new(0, 6)

	local headerBtn = Instance.new("TextButton")
	headerBtn.Parent = section
	headerBtn.Size = UDim2.new(1, 0, 0, 28)
	headerBtn.BackgroundTransparency = 1
	headerBtn.Text = "   " .. titleText
	headerBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	headerBtn.Font = Enum.Font.FredokaOne
	headerBtn.TextSize = 12
	headerBtn.TextXAlignment = Enum.TextXAlignment.Left

	local arrow = Instance.new("TextLabel")
	arrow.Parent = headerBtn
	arrow.Size = UDim2.new(0, 20, 0, 20)
	arrow.AnchorPoint = Vector2.new(1, 0.5)
	arrow.Position = UDim2.new(1, -5, 0.5, 0)
	arrow.BackgroundTransparency = 1
	arrow.Text = "▼"
	arrow.TextColor3 = Color3.fromRGB(150, 150, 150)
	arrow.Font = Enum.Font.FredokaOne
	arrow.TextSize = 10

	local separator = Instance.new("Frame")
	separator.Parent = section
	separator.Size = UDim2.new(1, 0, 0, 1)
	separator.Position = UDim2.new(0, 0, 0, 28)
