function API.SetTheme(value)
    local source
    if type(value)=="string" then
        for name,t in pairs(themes) do if name:lower()==value:lower() then source=t; themeName=name; break end end
        if not source then return false end
    elseif type(value)=="table" then source=value; themeName="Personalizado" else return false end
    for role,color in pairs(source) do if C[role] and typeof(color)=="Color3" then C[role]=color end end
    if type(value)=="table" then
        local derived=makeTheme(C.main,C.side,C.section,C.button,C.yellow,C.white,C.gray,C.line)
        for _,role in ipairs({"search","surface","divider","muted","hover","option","outline"}) do
            if source[role]==nil then C[role]=derived[role] end
        end
    end
    for obj,t in pairs(colorTweens) do t:Cancel(); colorTweens[obj]=nil end
    for obj,props in pairs(themeBindings) do
        if obj.Parent then for prop,role in pairs(props) do obj[prop]=C[role] end end
    end
    syncFields()
    queueConfig()
    return true
end
