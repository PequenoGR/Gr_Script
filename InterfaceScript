    arrow.AnchorPoint = Vector2.new(1, 0.5)
    arrow.Position = UDim2.new(1, -5, 0.5, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▼"
    arrow.TextColor3 = Color3.fromRGB(150, 150, 150)
    arrow.Font = Enum.Font.FredokaOne
    arrow.TextSize = 10

    local separator = Instance.new("Frame")
    separator.Parent = section
    separator.Size = UDim2.new(1, 0, 0, 1)
    separator.Position = UDim2.new(0, 0, 0, 28)
    separator.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    separator.BorderSizePixel = 0

    local childContainer = Instance.new("Frame")
    childContainer.Parent = section
    childContainer.Size = UDim2.new(1, 0, 0, 0)
    childContainer.Position = UDim2.new(0, 0, 0, 29)
    childContainer.AutomaticSize = Enum.AutomaticSize.Y
    childContainer.BackgroundTransparency = 1
    childContainer.ClipsDescendants = true

    local childLayout = Instance.new("UIListLayout")
    childLayout.Parent = childContainer
    childLayout.SortOrder = Enum.SortOrder.LayoutOrder
    childLayout.Padding = UDim.new(0, 6)
    childLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local childPadding = Instance.new("UIPadding")
    childPadding.Parent = childContainer
    childPadding.PaddingTop = UDim.new(0, 6)
    childPadding.PaddingBottom = UDim.new(0, 8)

    local opened = true
    headerBtn.MouseButton1Click:Connect(function()
        opened = not opened
        childContainer.Visible = opened
        separator.Visible = opened
        TweenService:Create(arrow, TweenInfo.new(0.2), {Rotation = opened and 0 or -90}):Play()
    end)

    return childContainer
end

function API.CreateButton(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(0.92, 0, 0, 26)
    btn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    btn.Text = text
    btn.Font = Enum.Font.FredokaOne
    btn.TextSize = 12
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    btn.MouseButton1Click:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
        task.delay(0.1, function()
            TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(38, 38, 38)}):Play()
        end)
        if callback then callback() end
    end)
    return btn
end

function API.CreateToggle(parent, text, callback)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = UDim2.new(0.92, 0, 0, 26)
    frame.BackgroundTransparency = 1

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.Font = Enum.Font.FredokaOne
    label.TextSize = 12
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextXAlignment = Enum.TextXAlignment.Left

    local bg = Instance.new("Frame")
    bg.Parent = frame
    bg.Size = UDim2.new(0, 30, 0, 14)
    bg.Position = UDim2.new(1, -30, 0.5, -7)
    bg.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local circle = Instance.new("Frame")
    circle.Parent = bg
    circle.Size = UDim2.new(0, 10, 0, 10)
    circle.Position = UDim2.new(0, 2, 0.5, -5)
    circle.BackgroundColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

    local btn = Instance.new("TextButton")
    btn.Parent = bg
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        TweenService:Create(bg, TweenInfo.new(0.2), {
            BackgroundColor3 = active and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(45, 45, 45)
        }):Play()
        TweenService:Create(circle, TweenInfo.new(0.2), {
            Position = active and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
        }):Play()
        if callback then callback(active) end
    end)
    return btn
end

function API.CreateDropdown(parent, text, list, callback)
    local opened = false
    local holder = Instance.new("Frame")
    holder.Parent = parent
    holder.Size = UDim2.new(0.92, 0, 0, 26)
    holder.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    holder.ClipsDescendants = true
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 4)

    local top = Instance.new("TextButton")
    top.Parent = holder
    top.Size = UDim2.new(1, 0, 0, 26)
    top.BackgroundTransparency = 1
    top.Text = "  " .. text .. " : " .. (list[1] and list[1].Name or "")
    top.TextColor3 = Color3.new(1, 1, 1)
    top.Font = Enum.Font.FredokaOne
    top.TextSize = 12
    top.TextXAlignment = Enum.TextXAlignment.Left

    local layout = Instance.new("UIListLayout")
    layout.Parent = holder
    layout.Padding = UDim.new(0, 2)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    top.MouseButton1Click:Connect(function()
        opened = not opened
        TweenService:Create(holder, TweenInfo.new(0.25), {
            Size = opened and UDim2.new(0.92, 0, 0, 26 + (#list * 25)) or UDim2.new(0.92, 0, 0, 26)
        }):Play()
    end)

    for _, info in pairs(list) do
        local opt = Instance.new("TextButton")
        opt.Parent = holder
        opt.Size = UDim2.new(0.95, 0, 0, 22)
        opt.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        opt.Text = info.Name
        opt.TextColor3 = Color3.new(1, 1, 1)
        opt.Font = Enum.Font.FredokaOne
        opt.TextSize = 11
        Instance.new("UICorner", opt).CornerRadius = UDim.new(0, 4)

        opt.MouseButton1Click:Connect(function()
            if callback then callback(info) end
            top.Text = "  " .. text .. " : " .. info.Name
            opened = false
            TweenService:Create(holder, TweenInfo.new(0.25), {Size = UDim2.new(0.92, 0, 0, 26)}):Play()
        end)
    end
    return top
end

-- ===== Minimizar (bolinha) =====
local minimizedBall = nil

local function createMinimizedBall()
    if minimizedBall then return end
    minimizedBall = Instance.new("ImageButton")
    minimizedBall.Name = "FloatingBall"
    minimizedBall.Parent = gui
    minimizedBall.Size = UDim2.new(0, 55, 0, 55)
    minimizedBall.Position = UDim2.new(0.2, 30, 0, 150)
    minimizedBall.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    minimizedBall.BorderSizePixel = 0
    minimizedBall.Image = imageAsset
    minimizedBall.Visible = false
    minimizedBall.AutoButtonColor = false
    minimizedBall.Active = true
    Instance.new("UICorner", minimizedBall).CornerRadius = UDim.new(0.2, 0)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(80, 80, 80)
    stroke.Thickness = 1
    stroke.Parent = minimizedBall

    local dragging, dragInput, dragStart, startPos

    minimizedBall.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = minimizedBall.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    minimizedBall.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            minimizedBall.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    minimizedBall.MouseButton1Click:Connect(function()
        minimizedBall.Visible = false
        mainFrame.Visible = true
        sidebar.Visible = true
        container.Visible = true
    end)
end

minBtn.MouseButton1Click:Connect(function()
    if mainFrame.Visible then
        createMinimizedBall()
        minimizedBall.Visible = true
        sidebar.Visible = false
        container.Visible = false
        mainFrame.Visible = false
    else
        if minimizedBall then minimizedBall.Visible = false end
        mainFrame.Visible = true
        sidebar.Visible = true
        container.Visible = true
    end
end)

closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)

