    local headerBtn = Instance.new("TextButton")
    headerBtn.Parent = section
    headerBtn.Size = UDim2.new(1, 0, 0, 28)
    headerBtn.BackgroundTransparency = 1
    headerBtn.Text = "   " .. titleText
