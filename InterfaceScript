local function draggable(handle,target)
    local input,start,pos,moved
    handle.Active=true
    handle.InputBegan:Connect(function(i)
        if input then return end
        if i.UserInputType==Enum.UserInputType.Touch or i.UserInputType==Enum.UserInputType.MouseButton1 then input=i; start=i.Position; pos=target.Position; moved=false end
    end)
    bind(UIS.InputChanged,function(i)
        if not input then return end
        if i==input or (input.UserInputType==Enum.UserInputType.MouseButton1 and i.UserInputType==Enum.UserInputType.MouseMovement) then
            local d=i.Position-start
            if d.Magnitude>5 then moved=true end
            if moved then target.Position=UDim2.new(pos.X.Scale,pos.X.Offset+d.X,pos.Y.Scale,pos.Y.Offset+d.Y) end
        end
    end,handle)
    bind(UIS.InputEnded,function(i) if i==input then input=nil end end,handle)
    return function() return moved end
end
