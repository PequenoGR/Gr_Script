-- Bolinha Minimizar
local minimizedBall = nil
local minimized = false

local function createMinimizedBall()
	if minimizedBall then return end
	minimizedBall = Instance.new("ImageButton")
	minimizedBall.Name = "FloatingBall"
	minimizedBall.Parent = gui
	minimizedBall.Size = UDim2.new(0, 55, 0, 55)
	minimizedBall.Position = UDim2.new(0.2, 30, 0, 150)
	minimizedBall.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	minimizedBall.BorderSizePixel = 0
	minimizedBall.Image = imageAsset
	minimizedBall.Visible = false
	minimizedBall.AutoButtonColor = false
	minimizedBall.Active = true
	minimizedBall.Draggable = false
	Instance.new("UICorner", minimizedBall).CornerRadius = UDim.new(0.2, 0)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(80, 80, 80)
	stroke.Thickness = 1
	stroke.Parent = minimizedBall

	local dragging, dragInput, dragStart, startPos

	minimizedBall.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = minimizedBall.Position
			
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	minimizedBall.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			minimizedBall.Position = UDim2.new(
				startPos.X.Scale, 
				startPos.X.Offset + delta.X, 
				startPos.Y.Scale, 
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	minimizedBall.MouseButton1Click:Connect(function()
		minimized = false
		minimizedBall.Visible = false
		mainFrame.Visible = true
		sidebar.Visible = true
		container.Visible = true
		TweenService:Create(mainFrame, TweenInfo.new(0.25), {
			Size = UDim2.new(0, currentSize.X, 0, currentSize.Y),
			Position = UDim2.new(0.5, -currentSize.X/2, 0.5, -currentSize.Y/2)
		}):Play()
	end)
end

minBtn.MouseButton1Click:Connect(function()
	if minimized then
		minimized = false
		if minimizedBall then
			minimizedBall.Visible = false
		end
		mainFrame.Visible = true
		sidebar.Visible = true
		container.Visible = true
		TweenService:Create(mainFrame, TweenInfo.new(0.25), {
			Size = UDim2.new(0, currentSize.X, 0, currentSize.Y),
			Position = UDim2.new(0.5, -currentSize.X/2, 0.5, -currentSize.Y/2)
		}):Play()
	else
		minimized = true
		createMinimizedBall()
		minimizedBall.Visible = true
		sidebar.Visible = false
		container.Visible = false
		mainFrame.Visible = false
	end
end)

closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end)
