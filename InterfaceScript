end
local function showPage(name)
    if not pages[name] then return end
    if settingsPanel then settingsPanel.Visible=false end
    activeTab=name; noResults.Visible=false
    for n,p in pairs(pages) do p.Visible=n==name end
    for n,b in pairs(navButtons) do
        local a=n==name
        tween(b,.2,{BackgroundColor3=a and "surface" or "side"})
        tween(b.TitleText,.2,{TextColor3=a and "yellow" or "gray"})
        local i=b:FindFirstChild("TabIcon")
        if i then
            tween(i,.2,{[i:IsA("TextLabel") and "TextColor3" or "ImageColor3"]=a and "yellow" or "white"})
        end
    end
