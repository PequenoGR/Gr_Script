UIBuilder.CreateButton = function(parent, text, callback)
	local btn = Instance.new("TextButton")
	btn.Parent = parent
	btn.Size = UDim2.new(0.92, 0, 0, 26)
	btn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
	btn.Text = text
	btn.Font = Enum.Font.FredokaOne
	btn.TextSize = 12
	btn.TextColor3 = Color3.fromRGB(240, 240, 240)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

	btn.MouseButton1Click:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
		task.delay(0.1, function()
			TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(38, 38, 38)}):Play()
		end)
		if callback then callback() end
	end)
end

UIBuilder.CreateToggle = function(parent, text, callback)
	local frame = Instance.new("Frame")
	frame.Parent = parent
	frame.Size = UDim2.new(0.92, 0, 0, 26)
	frame.BackgroundTransparency = 1

	local label = Instance.new("TextLabel")
	label.Parent = frame
	label.Size = UDim2.new(0.7, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 12
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Left

	local bg = Instance.new("Frame")
	bg.Parent = frame
	bg.Size = UDim2.new(0, 30, 0, 14)
	bg.Position = UDim2.new(1, -30, 0.5, -7)
	bg.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

	local circle = Instance.new("Frame")
	circle.Parent = bg
	circle.Size = UDim2.new(0, 10, 0, 10)
	circle.Position = UDim2.new(0, 2, 0.5, -5)
	circle.BackgroundColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)

	local btn = Instance.new("TextButton")
	btn.Parent = bg
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.BackgroundTransparency = 1
	btn.Text = ""

	local active = false
	btn.MouseButton1Click:Connect(function()
		active = not active
		TweenService:Create(bg, TweenInfo.new(0.2), {
			BackgroundColor3 = active and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(45, 45, 45)
		}):Play()
		TweenService:Create(circle, TweenInfo.new(0.2), {
			Position = active and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
		}):Play()
		if callback then callback(active) end
	end)
end

UIBuilder.CreateDropdown = function(parent, text, list, callback)
	local opened = false
	local holder = Instance.new("Frame")
	holder.Parent = parent
	holder.Size = UDim2.new(0.92, 0, 0, 26)
	holder.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	holder.ClipsDescendants = true
	Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 4)

	local top = Instance.new("TextButton")
	top.Parent = holder
	top.Size = UDim2.new(1, 0, 0, 26)
	top.BackgroundTransparency = 1
	top.Text = "  " .. text .. " : " .. (list[1] and list[1].Name or "")
	top.TextColor3 = Color3.new(1, 1, 1)
	top.Font = Enum.Font.FredokaOne
	top.TextSize = 12
	top.TextXAlignment = Enum.TextXAlignment.Left

	local layout = Instance.new("UIListLayout")
	layout.Parent = holder
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	top.MouseButton1Click:Connect(function()
		opened = not opened
		TweenService:Create(holder, TweenInfo.new(0.25), {
			Size = opened and UDim2.new(0.92, 0, 0, 26 + (#list * 25)) or UDim2.new(0.92, 0, 0, 26)
		}):Play()
	end)

	for _, info in pairs(list) do
		local opt = Instance.new("TextButton")
		opt.Parent = holder
		opt.Size = UDim2.new(0.95, 0, 0, 22)
		opt.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		opt.Text = info.Name
		opt.TextColor3 = Color3.new(1, 1, 1)
		opt.Font = Enum.Font.FredokaOne
		opt.TextSize = 11
		Instance.new("UICorner", opt).CornerRadius = UDim.new(0, 4)

		opt.MouseButton1Click:Connect(function()
			if callback then callback(info) end
			top.Text = "  " .. text .. " : " .. info.Name
			opened = false
			TweenService:Create(holder, TweenInfo.new(0.25), {Size = UDim2.new(0.92, 0, 0, 26)}):Play()
		end)
	end
end

