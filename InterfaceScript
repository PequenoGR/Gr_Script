local function matches(value,q) return normalize(value):find(q,1,true)~=nil end
local function objectMatches(o,q)
    if matches(o:GetAttribute("GRSearchText"),q) then return true end
    if (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) and matches(o.Text,q) then return true end
    for _,d in ipairs(o:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and matches(d.Text,q) then return true end
    end
