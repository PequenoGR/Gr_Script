local function setVisible(o,v) if saved[o]==nil then saved[o]=o.Visible end; o.Visible=v end
local function updateSearch()
    local q=normalize(searchBox.Text)
    clear.Visible=q~=""; noResults.Visible=false
    for o,v in pairs(saved) do if o.Parent then o.Visible=v end end
    table.clear(saved)
    for _,s in pairs(sections) do if s.frame.Parent then s.body.Visible=s.open; s.line.Visible=s.open; s.arrow.Rotation=s.open and 0 or -90 end end
    if q=="" then
        if searching then searching=false; if previousTab or activeTab then showPage(previousTab or activeTab) end end
        previousTab=nil; return
    end
    if not searching then previousTab=activeTab end
    searching=true
    local first,foundTabs=nil,{}
    for _,name in ipairs(tabsOrder) do
        local p,b=pages[name],navButtons[name]
        local all=matches(name,q) or objectMatches(b,q)
        local found=all
        for _,o in ipairs(p:GetChildren()) do
            if o:IsA("GuiObject") then
                local s=sections[o]
                if s then
                    local sectionMatch=all or matches(s.title,q)
                    local any=sectionMatch
                    for _,item in ipairs(s.body:GetChildren()) do
                        if item:IsA("GuiObject") then local m=sectionMatch or objectMatches(item,q); setVisible(item,m); any=any or m end
                    end
                    setVisible(o,any)
                    if any then setVisible(s.body,true); setVisible(s.line,true); s.arrow.Rotation=0 end
                    found=found or any
                else
                    local m=all or objectMatches(o,q); setVisible(o,m); found=found or m
                end
            end
        end
        setVisible(b,found); setVisible(tabLines[name],found)
        if found then foundTabs[name]=true; if not first then first=name end end
    end
    if activeTab and foundTabs[activeTab] then showPage(activeTab) elseif first then showPage(first) else for _,p in pairs(pages) do p.Visible=false end; noResults.Visible=true end
end
