function API.AddTab(text, pageName, iconUrl)
    pageName = pageName or text
    local isFirst = (#tabsOrder == 0)
    createPage(pageName)

    local btn = Instance.new("TextButton")
    btn.Parent = sidebar
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    if iconUrl and iconUrl ~= "" then
        local icon = Instance.new("ImageLabel")
        icon.Name = "TabIcon"
        icon.Parent = btn
        icon.Size = UDim2.new(0, 17, 0, 17)
        icon.AnchorPoint = Vector2.new(0, 0.5)
        icon.Position = UDim2.new(0, 8, 0.5, 0)
        icon.BackgroundTransparency = 1
        icon.Image = iconUrl
        icon.ImageColor3 = Color3.fromRGB(220, 220, 220)
    end

    local titleText = Instance.new("TextLabel")
    titleText.Name = "TitleText"
    titleText.Parent = btn
    titleText.Size = UDim2.new(1, -30, 1, 0)
    titleText.Position = UDim2.new(0, 28, 0, 0)
    titleText.BackgroundTransparency = 1
    titleText.Text = text
    titleText.Font = Enum.Font.FredokaOne
    titleText.TextSize = 12
    titleText.TextColor3 = Color3.fromRGB(160, 160, 160)
    titleText.TextXAlignment = Enum.TextXAlignment.Left
    titleText.TextYAlignment = Enum.TextYAlignment.Center

    navButtons[pageName] = btn
    btn.MouseButton1Click:Connect(function() showPage(pageName) end)

    local tabLine = Instance.new("Frame")
    tabLine.Parent = sidebar
    tabLine.Size = UDim2.new(1, 0, 0, 1)
    tabLine.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    tabLine.BorderSizePixel = 0

    table.insert(tabsOrder, pageName)
    if isFirst then showPage(pageName) end

    return btn
end

function API.ShowTab(name) showPage(name) end

function API.SetTitle(text) title.Text = text end

