container.BackgroundTransparency = 1

local pages = {}
local navButtons = {}

local function createPage(name)
	local page = Instance.new("ScrollingFrame")
	page.Parent = container
	page.Size = UDim2.new(1, 0, 1, 0)
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.ScrollBarThickness = 2
	page.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 80)
	page.BackgroundTransparency = 1
	page.Visible = false

	local layout = Instance.new("UIListLayout")
	layout.Parent = page
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 10)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local padding = Instance.new("UIPadding")
	padding.Parent = page
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)

	pages[name] = page
	return page
end

local mainPage = createPage("Main")
local playerPage = createPage("Player")
local configPage = createPage("Config")

local function showPage(name)
	for pageName, pageFrame in pairs(pages) do
		pageFrame.Visible = (pageName == name)
	end
	
	for pageName, btn in pairs(navButtons) do
		local active = (pageName == name)
		
		TweenService:Create(btn, TweenInfo.new(0.2), {
			BackgroundColor3 = active and Color3.fromRGB(35, 35, 35) or Color3.fromRGB(15, 15, 15)
		}):Play()
		
		if btn:FindFirstChild("TitleText") then
			TweenService:Create(btn.TitleText, TweenInfo.new(0.2), {
				TextColor3 = active and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(160, 160, 160)
			}):Play()
		end
		
		if btn:FindFirstChild("TabIcon") then
			TweenService:Create(btn.TabIcon, TweenInfo.new(0.2), {
				ImageColor3 = active and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(220, 220, 220)
			}):Play()
		end
	end
end

